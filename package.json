{
  "name": "hanphonejan-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "vuepress dev . --port 3001",
    "build": "vuepress build .",
    "serve": "python3 -m http.server 3000 --directory .vuepress/dist",
    "typecheck": "tsc -p tsconfig.json",
    "sync": "ts-node scripts/sync-notes.ts",
    "sync:ml": "ts-node scripts/sync-machine-learning.ts",
    "sync:pyodide": "node scripts/fetch-pyodide.js",
    "quiz:gen": "ts-node scripts/gen-quiz.ts",
    "quiz:merge": "ts-node scripts/merge-quiz.ts",
    "quiz:validate": "ts-node scripts/validate-bank.ts",
    "patterns:gen": "node scripts/gen-patterns.js --write",
    "tags:fetch": "node scripts/fetch-leetcode-tags.js --write",
    "tags:normalize": "node scripts/normalize-tags.js --write",
    "test:tracers": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node scripts/test-tracers.ts",
    "test:pyrunner": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node scripts/test-pyrunner.ts",
    "test:pyodide": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node scripts/test-pyodide.ts",
    "trace:record": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node scripts/record-traces.ts",
    "test:adapters": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node scripts/test-adapters.ts",
    "trace:probe": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node scripts/probe-adapters.ts",
    "trace:diagnose": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node scripts/diagnose-record.ts",
    "check:vis": "node scripts/check-vis.js",
    "check:runbar": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node scripts/check-run-bar.ts",
    "check:docs": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' ts-node scripts/check-docs.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@vuepress/bundler-vite": "2.0.0-rc.28",
    "@vuepress/core": "2.0.0-rc.28",
    "@vuepress/plugin-markdown-math": "2.0.0-rc.128",
    "@vuepress/plugin-photo-swipe": "2.0.0-rc.128",
    "@vuepress/plugin-search": "2.0.0-rc.128",
    "clsx": "^2.0.0",
    "katex": "^0.17.0",
    "mermaid": "^11.12.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "sass-embedded": "^1.106.0",
    "vue": "^3.5.44",
    "vuepress": "2.0.0-rc.28",
    "vuepress-theme-hope": "2.0.0-rc.110"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.3.0",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "pyodide": "314.0.7",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
