mxCell><mxCell id="s1" value="ds0_slave&lt;br&gt;读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="655" y="270" width="155" height="56" as="geometry"/></mxCell><mxCell id="t1" value="object_info&lt;br&gt;bucket_id % 2 = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="360" width="340" height="70" as="geometry"/></mxCell><mxCell id="n1" value="同一 Bucket 的对象&lt;br&gt;落在同一个库；&lt;br&gt;列表查询带 bucket_id。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="450" width="340" height="90" as="geometry"/></mxCell><mxCell id="rw2" value="rw_1（读写组）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="210" width="340" height="40" as="geometry"/></mxCell><mxCell id="m2" value="ds1_master&lt;br&gt;写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="270" width="155" height="56" as="geometry"/></mxCell><mxCell id="s2" value="ds1_slave&lt;br&gt;读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1065" y="270" width="155" height="56" as="geometry"/></mxCell><mxCell id="t2" value="object_info&lt;br&gt;bucket_id % 2 = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="360" width="340" height="70" as="geometry"/></mxCell><mxCell id="n2" value="跨 Bucket 的 IN 查询&lt;br&gt;没有单一分片键，&lt;br&gt;ShardingSphere 广播合并。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="340" height="90" as="geometry"/></mxCell><mxCell id="note" value="路由表达式：rw_$-&gt;{bucket_id % 2}　唯一键：(bucket_id, object_key)&lt;br&gt;复制延迟的后果：listBuckets 读从库，刚建的 Bucket 可能暂时看不到；写永远走主库，插入本身不会失败。&lt;br&gt;回收站列表按用户的所有 bucketId 做 IN 查询，会广播到两个分片。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1200" height="100" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;" edge="1" parent="1" source="app" target="ss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="路由" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ss" target="c0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="路由" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ss" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="路由" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ss" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="写" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize