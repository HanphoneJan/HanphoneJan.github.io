<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="delete-chain" name="delete-chain"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title0" value="删除链路：字节先消失，回收站只保留索引" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1072" height="30" as="geometry"/></mxCell><mxCell id="del" value="DELETE /{bucket}/{key}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="rm" value="backend.removeObject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="210" height="50" as="geometry"/></mxCell><mxCell id="evt" value="发 OBJECT_DELETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="cons" value="消费者：status=RECYCLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="70" width="280" height="50" as="geometry"/></mxCell><mxCell id="gone" value="字节已经不在" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="44" as="geometry"/></mxCell><mxCell id="restore" value="恢复接口&lt;br&gt;只改 status = NORMAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;