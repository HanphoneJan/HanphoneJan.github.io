<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="startup" name="startup"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title0" value="启动依赖：健康检查、两个初始化容器与业务服务" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1132" height="30" as="geometry"/></mxCell><mxCell id="xxl" value="XXL-Job（只等 MySQL）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="220" height="46" as="geometry"/></mxCell><mxCell id="mysql" value="MySQL 主 + 从&lt;br&gt;healthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="180" height="52" as="geometry"/></mxCell><mxCell id="repl" value="mysql-replication-init&lt;br&gt;exit 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="190" height="52" as="geometry"/></mxCell><mxCell id="redis" value="Redis 6 节点&lt;br&gt;healthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="180" height="52" as="geometry"/></mxCell><mxCell id="rinit" value="redis-cluster-init&lt;br&gt;exit 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="190" height="52" as="geometry"/></mxCell><mxCell id="nacos" value="Nacos&lt;br&gt;healthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="180" height="52" as="geometry"/></mxCell><mxCell id="cond" value="三个业务服务的&lt;br&gt;启动条件&lt;br&gt;三条全部满足" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="210" width="220" height="90" as="geometry"/></mxCell><mxCell id="svc" value="三个业务服务（同时等待）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="300" height="300" as="geometry"/></mxCell><mxCell id="gw" value="gateway :38080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="260" height="52" as="geometry"/></mxCell><mxCell id="st" value="object-storage :38081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="210" width="260" height="52" as="geometry"/></mxCell><mxCell id="md" value="object-metadata :38082" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="290" width="260" height="52" as="geometry"/></mxCell><mxCell id="ready" value="登录 200 / Nacos 三服务 UP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="430" width="300" height="56" as="geometry"/></mxCell><mxCell id="note" value="三个业务服务都同时等：Nacos healthy + Redis cluster init 成功 + MySQL 复制 init 成功。&lt;br&gt;Gateway 不连 MySQL，但它也挂着复制条件；复制失败时网关同样不启动。&lt;br&gt;业务服务没有 Actuator，compose 也没有给它们配 healthcheck；ps 只显示 Up。&lt;br&gt;启动到全部就绪大约 2–3 分钟。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="740" height="150" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mysql" target="repl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="redis" target="rinit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="建表" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="mysql" target="xxl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="repl" target="cond"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rinit" target="cond"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="nacos" target="cond"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cond" target="svc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svc" target="ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="图例：实线＝同步主路径　虚线＝异步 / 降级　蓝＝服务　黄＝缓存或判定　绿＝成功　红＝失败或缺口" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="24" y="580" width="1132" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>