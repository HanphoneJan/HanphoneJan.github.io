{"docKey":"0045_jump_game_ii","code":"from typing import List\n\nclass Solution:\n    def jump(self, nums: List[int]) -> int:\n        \"\"\"\n        跳跃游戏 II - 贪心算法\n\n        核心思想：每一步都跳到能覆盖最远范围的位置\n        \"\"\"\n        n = len(nums)\n        if n <= 1:\n            return 0\n\n        ans = 0           # 跳跃次数\n        current_end = 0   # 当前这一步能到达的最远位置\n        farthest = 0      # 下一步能到达的最远位置\n\n        for i in range(n - 1):  # 不需要遍历到最后一个位置\n            # 更新下一步能到达的最远位置\n            farthest = max(farthest, i + nums[i])\n\n            # 到达当前步数的边界，必须跳一步\n            if i == current_end:\n                ans += 1\n                current_end = farthest  # 更新当前步数的边界\n\n        return ans","method":"jump","paramNames":["nums"],"args":["[2,3,0,1,4]"],"expected":"2","result":2,"events":[{"line":10,"locals":{"nums":[2,3,0,1,4]},"depth":1},{"line":11,"locals":{"nums":[2,3,0,1,4],"n":5},"depth":1},{"line":14,"locals":{"nums":[2,3,0,1,4],"n":5},"depth":1},{"line":15,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":0},"depth":1},{"line":16,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":0,"current_end":0},"depth":1},{"line":18,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":0,"current_end":0,"farthest":0},"depth":1},{"line":20,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":0,"current_end":0,"farthest":0,"i":0},"depth":1},{"line":23,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":0,"current_end":0,"farthest":2,"i":0},"depth":1},{"line":24,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":0,"current_end":0,"farthest":2,"i":0},"depth":1},{"line":25,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":1,"current_end":0,"farthest":2,"i":0},"depth":1},{"line":18,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":1,"current_end":2,"farthest":2,"i":0},"depth":1},{"line":20,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":1,"current_end":2,"farthest":2,"i":1},"depth":1},{"line":23,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":1,"current_end":2,"farthest":4,"i":1},"depth":1},{"line":18,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":1,"current_end":2,"farthest":4,"i":1},"depth":1},{"line":20,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":1,"current_end":2,"farthest":4,"i":2},"depth":1},{"line":23,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":1,"current_end":2,"farthest":4,"i":2},"depth":1},{"line":24,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":1,"current_end":2,"farthest":4,"i":2},"depth":1},{"line":25,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":2,"current_end":2,"farthest":4,"i":2},"depth":1},{"line":18,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":2,"current_end":4,"farthest":4,"i":2},"depth":1},{"line":20,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":2,"current_end":4,"farthest":4,"i":3},"depth":1},{"line":23,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":2,"current_end":4,"farthest":4,"i":3},"depth":1},{"line":18,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":2,"current_end":4,"farthest":4,"i":3},"depth":1},{"line":27,"locals":{"nums":[2,3,0,1,4],"n":5,"ans":2,"current_end":4,"farthest":4,"i":3},"depth":1}]}