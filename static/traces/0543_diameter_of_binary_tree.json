{"docKey":"0543_diameter_of_binary_tree","code":"from typing import Optional\n\n\nclass TreeNode:\n    def __init__(self, val=0, left=None, right=None):\n        self.val = val\n        self.left = left\n        self.right = right\n\n\nclass Solution:\n    def diameterOfBinaryTree(self, root: Optional[TreeNode]) -> int:\n        self.ans = 0\n\n        def dfs(node: Optional[TreeNode]) -> int:\n            # 返回从 node 往下最远的一条链（边数）；空子树的链长为 0\n            if not node:\n                return 0\n            left = dfs(node.left)\n            right = dfs(node.right)\n            # 以 node 为拐点：左右两条链在这里接成一条路径\n            self.ans = max(self.ans, left + right)\n            # 父节点只能沿一侧继续往下，所以只上报较长的那条\n            return max(left, right) + 1\n\n        dfs(root)\n        return self.ans","method":"diameterOfBinaryTree","paramNames":["root"],"argKinds":["tree"],"args":["[1,2,3,4,5]"],"expected":"3","result":3,"events":[{"line":13,"locals":{"root":{"$":"tree","v":[1,2,3,4,5,null,null]}},"depth":1},{"line":15,"locals":{"root":{"$":"tree","v":[1,2,3,4,5,null,null]}},"depth":1},{"line":26,"locals":{"root":{"$":"tree","v":[1,2,3,4,5,null,null]},"dfs":"<function>"},"depth":1},{"line":17,"locals":{"node":{"$":"tree","v":[1,2,3,4,5,null,null]},"dfs":"<function>"},"depth":2},{"line":19,"locals":{"node":{"$":"tree","v":[1,2,3,4,5,null,null]},"dfs":"<function>"},"depth":2},{"line":17,"locals":{"node":{"$":"n","i":1,"v":2},"dfs":"<function>"},"depth":3},{"line":19,"locals":{"node":{"$":"n","i":1,"v":2},"dfs":"<function>"},"depth":3},{"line":17,"locals":{"node":{"$":"n","i":3,"v":4},"dfs":"<function>"},"depth":4},{"line":19,"locals":{"node":{"$":"n","i":3,"v":4},"dfs":"<function>"},"depth":4},{"line":17,"locals":{"node":null,"dfs":"<function>"},"depth":5},{"line":18,"locals":{"node":null,"dfs":"<function>"},"depth":5},{"line":20,"locals":{"node":{"$":"n","i":3,"v":4},"left":0,"dfs":"<function>"},"depth":4},{"line":17,"locals":{"node":null,"dfs":"<function>"},"depth":5},{"line":18,"locals":{