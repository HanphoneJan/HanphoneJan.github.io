{"docKey":"0007_reverse_integer","code":"class Solution:\n    def reverse(self, x: int) -> int:\n        res = 0\n        while x != 0:\n            # 取末位数字：正数用 % 10，负数用 % -10 保证 digit 为负\n            digit = x % 10 if x > 0 else x % -10\n\n            # 在追加之前检查溢出（避免使用 64 位整数）\n            if res > 214748364 or (res == 214748364 and digit > 7):\n                return 0\n            if res < -214748364 or (res == -214748364 and digit < -8):\n                return 0\n\n            res = res * 10 + digit\n            x = int(x / 10)  # 向零截断，保证负数行为正确\n\n        return res","method":"reverse","paramNames":["x"],"args":["123"],"expected":"321","result":321,"events":[{"line":3,"locals":{"x":123},"depth":1},{"line":4,"locals":{"x":123,"res":0},"depth":1},{"line":6,"locals":{"x":123,"res":0},"depth":1},{"line":9,"locals":{"x":123,"res":0,"digit":3},"depth":1},{"line":11,"locals":{"x":123,"res":0,"digit":3},"depth":1},{"line":14,"locals":{"x":123,"res":0,"digit":3},"depth":1},{"line":15,"locals":{"x":123,"res":3,"digit":3},"depth":1},{"line":4,"locals":{"x":12,"res":3,"digit":3},"depth":1},{"line":6,"locals":{"x":12,"res":3,"digit":3},"depth":1},{"line":9,"locals":{"x":12,"res":3,"digit":2},"depth":1},{"line":11,"locals":{"x":12,"res":3,"digit":2},"depth":1},{"line":14,"locals":{"x":12,"res":3,"digit":2},"depth":1},{"line":15,"locals":{"x":12,"res":32,"digit":2},"depth":1},{"line":4,"locals":{"x":1,"res":32,"digit":2},"depth":1},{"line":6,"locals":{"x":1,"res":32,"digit":2},"depth":1},{"line":9,"locals":{"x":1,"res":32,"digit":1},"depth":1},{"line":11,"locals":{"x":1,"res":32,"digit":1},"depth":1},{"line":14,"locals":{"x":1,"res":32,"digit":1},"depth":1},{"line":15,"locals":{"x":1,"res":321,"digit":1},"depth":1},{"line":4,"locals":{"x":0,"res":321,"digit":1},"depth":1},{"line":17,"locals":{"x":0,"res":321,"digit":1},"depth":1}]}