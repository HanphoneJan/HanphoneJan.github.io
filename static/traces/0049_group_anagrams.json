{"docKey":"0049_group_anagrams","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    字母异位词分组 - 哈希表\n\n    核心思想：\n    字母异位词（anagram）的特点是：排序后的字符串相同。\n    例如 \"eat\", \"tea\", \"ate\" 排序后都是 \"aet\"。\n\n    算法步骤：\n    1. 遍历每个字符串，将其排序作为 key\n    2. 将原字符串加入 key 对应的列表\n    3. 返回所有列表\n\n    为什么用排序作为 key？\n    因为异位词的字母组成完全相同，排序后必然相同。\n\n    时间复杂度：O(n * k log k)，n 是字符串数量，k 是最大字符串长度\n    空间复杂度：O(n * k)\n    \"\"\"\n\n    def groupAnagrams(self, strs: List[str]) -> List[List[str]]:\n        anagrams = {}\n        for s in strs:\n            key = ''.join(sorted(s))  # 排序作为 key\n            if key not in anagrams:\n                anagrams[key] = []\n            anagrams[key].append(s)\n        return list(anagrams.values())","method":"groupAnagrams","paramNames":["strs"],"args":["[\"eat\", \"tea\", \"tan\", \"ate\", \"nat\", \"bat\"]"],"expected":"[[\"bat\"],[\"nat\",\"tan\"],[\"ate\",\"eat\",\"tea\"]]","result":[["eat","tea","ate"],["tan","nat"],["bat"]],"events":[{"line":24,"locals":{"strs":["eat","tea","tan","ate","nat","bat"]},"depth":1},{"line":25,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"anagrams":{}},"depth":1},{"line":26,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"anagrams":{},"s":"eat"},"depth":1},{"line":27,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"anagrams":{},"s":"eat","key":"aet"},"depth":1},{"line":28,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"anagrams":{},"s":"eat","key":"aet"},"depth":1},{"line":29,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"anagrams":{"aet":[]},"s":"eat","key":"aet"},"depth":1},{"line":25,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"anagrams":{"aet":["eat"]},"s":"eat","key":"aet"},"depth":1},{"line":26,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"anagrams":{"aet":["eat"]},"s":"tea","key":"aet"},"depth":1},{"line":27,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"anagrams":{"aet":["eat"]},"s":"tea","key":"aet"},"depth":1},{"line":29,"lo