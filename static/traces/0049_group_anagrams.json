{"docKey":"0049_group_anagrams","code":"from collections import defaultdict\nfrom typing import List\n\n\nclass Solution:\n    def groupAnagrams(self, strs: List[str]) -> List[List[str]]:\n        groups = defaultdict(list)\n        for s in strs:\n            key = ''.join(sorted(s))   # 排序后的串作规范键；列表不可哈希，必须拼成字符串\n            groups[key].append(s)\n        return list(groups.values())","method":"groupAnagrams","paramNames":["strs"],"args":["[\"eat\",\"tea\",\"tan\",\"ate\",\"nat\",\"bat\"]"],"expected":"[[\"bat\"],[\"nat\",\"tan\"],[\"ate\",\"eat\",\"tea\"]]","result":[["eat","tea","ate"],["tan","nat"],["bat"]],"events":[{"line":7,"locals":{"strs":["eat","tea","tan","ate","nat","bat"]},"depth":1},{"line":8,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{}},"depth":1},{"line":9,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{},"s":"eat"},"depth":1},{"line":10,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{},"s":"eat","key":"aet"},"depth":1},{"line":8,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{"aet":["eat"]},"s":"eat","key":"aet"},"depth":1},{"line":9,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{"aet":["eat"]},"s":"tea","key":"aet"},"depth":1},{"line":10,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{"aet":["eat"]},"s":"tea","key":"aet"},"depth":1},{"line":8,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{"aet":["eat","tea"]},"s":"tea","key":"aet"},"depth":1},{"line":9,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{"aet":["eat","tea"]},"s":"tan","key":"aet"},"depth":1},{"line":10,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{"aet":["eat","tea"]},"s":"tan","key":"ant"},"depth":1},{"line":8,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{"aet":["eat","tea"],"ant":["tan"]},"s":"tan","key":"ant"},"depth":1},{"line":9,"locals":{"strs":["eat","tea","tan","ate","nat","bat"],"groups":{"aet":["eat