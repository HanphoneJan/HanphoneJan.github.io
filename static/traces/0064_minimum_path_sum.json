{"docKey":"0064_minimum_path_sum","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    最小路径和 - 动态规划\n\n    核心思想：\n    从左上角到右下角，每次只能向右或向下移动，求路径和最小值。\n\n    状态定义：\n    dp[i][j] = 从 (0,0) 到达 (i,j) 的最小路径和\n\n    状态转移方程：\n    dp[i][j] = min(dp[i-1][j], dp[i][j-1]) + grid[i][j]\n    （只能从上方或左方到达当前位置，选择路径和较小的那个）\n\n    边界条件：\n    - dp[0][0] = grid[0][0]\n    - 第一行：只能从左边来，dp[0][j] = dp[0][j-1] + grid[0][j]\n    - 第一列：只能从上面来，dp[i][0] = dp[i-1][0] + grid[i][0]\n\n    时间复杂度：O(m * n)\n    空间复杂度：O(m * n)，可以优化到 O(n)\n    \"\"\"\n\n    def minPathSum(self, grid: List[List[int]]) -> int:\n        if not grid or not grid[0]:\n            return 0\n\n        rows, columns = len(grid), len(grid[0])\n\n        # dp[i][j] = 到达 (i,j) 的最小路径和\n        dp = [[0] * columns for _ in range(rows)]\n        dp[0][0] = grid[0][0]\n\n        # 初始化第一列：只能从上方来\n        for i in range(1, rows):\n            dp[i][0] = dp[i - 1][0] + grid[i][0]\n\n        # 初始化第一行：只能从左边来\n        for j in range(1, columns):\n            dp[0][j] = dp[0][j - 1] + grid[0][j]\n\n        # 填充 DP 表\n        for i in range(1, rows):\n            for j in range(1, columns):\n                # 从上方或左方选择较小的路径和，加上当前格子的值\n                dp[i][j] = min(dp[i - 1][j], dp[i][j - 1]) + grid[i][j]\n\n        return dp[rows - 1][columns - 1]","method":"minPathSum","paramNames":["grid"],"args":["[[1,3,1],[1,5,1],[4,2,1]]"],"expected":"7","result":7,"events":[{"line":27,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]]},"depth":1},{"line":30,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]]},"depth":1},{"line":33,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3},"depth":1},{"line":33,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"_":0},"depth":1},{"line":33,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"_":1},"depth":1},{"line":33,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"_":2},"depth":1},{"line":34,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[0,0,0],[0,0,0],[0,0,0]]},"depth":1},{"line":37,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,0,0],[0,0,0],[0,0,0]]},"depth":1},{"line":38,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,0,0],[0,0,0],[0,0,0]],"i":1},"depth":1},{"line":37,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,0,0],[2,0,0],[0,0,0]],"i":1},"depth":1},{"line":38,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,0,0],[2,0,0],[0,0,0]],"i":2},"depth":1},{"line":37,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,0,0],[2,0,0],[6,0,0]],"i":2},"depth":1},{"line":41,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,0,0],[2,0,0],[6,0,0]],"i":2},"depth":1},{"line":42,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,0,0],[2,0,0],[6,0,0]],"i":2,"j":1},"depth":1},{"line":41,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,4,0],[2,0,0],[6,0,0]],"i":2,"j":1},"depth":1},{"line":42,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,4,0],[2,0,0],[6,0,0]],"i":2,"j":2},"depth":1},{"line":41,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,4,5],[2,0,0],[6,0,0]],"i":2,"j":2},"depth":1},{"line":45,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,4,5],[2,0,0],[6,0,0]],"i":2,"j":2},"depth":1},{"line":46,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,4,5],[2,0,0],[6,0,0]],"i":1,"j":2},"depth":1},{"line":48,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,4,5],[2,0,0],[6,0,0]],"i":1,"j":1},"depth":1},{"line":46,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,4,5],[2,7,0],[6,0,0]],"i":1,"j":1},"depth":1},{"line":48,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]],"rows":3,"columns":3,"dp":[[1,4,5],[2,7,0],[6,0,0]],"i":1,"j":2},"depth":1},{"line":46,"locals":{"grid":[[1,3,1],[1,5,1],[4,2,1]