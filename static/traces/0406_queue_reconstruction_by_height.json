{"docKey":"0406_queue_reconstruction_by_height","code":"from typing import List\n\n\nclass Solution:\n    \"\"\"\n    根据身高重建队列 - 贪心算法\n\n    按身高降序，身高相同按 k 升序\n    依次插入到结果列表的第 k 个位置\n\n    时间复杂度：O(n log n)\n    空间复杂度：O(n)\n    \"\"\"\n\n    def reconstructQueue(self, people: List[List[int]]) -> List[List[int]]:\n        # 按身高降序，身高相同则按前面人数升序\n        people.sort(key=lambda x: (-x[0], x[1]))\n        ans = list()\n        for person in people:\n            # 将当前人插入到 ans[person[1]] 位置\n            ans[person[1]:person[1]] = [person]\n        return ans","method":"reconstructQueue","paramNames":["people"],"args":["[[7,0],[4,4],[7,1],[5,0],[6,1],[5,2]]"],"expected":"[[5,0],[7,0],[5,2],[6,1],[4,4],[7,1]]","result":[[5,0],[7,0],[5,2],[6,1],[4,4],[7,1]],"events":[{"line":17,"locals":{"people":[[7,0],[4,4],[7,1],[5,0],[6,1],[5,2]]},"depth":1},{"line":17,"locals":{"x":[7,0]},"depth":2},{"line":17,"locals":{"x":[4,4]},"depth":2},{"line":17,"locals":{"x":[7,1]},"depth":2},{"line":17,"locals":{"x":[5,0]},"depth":2},{"line":17,"locals":{"x":[6,1]},"depth":2},{"line":17,"locals":{"x":[5,2]},"depth":2},{"line":18,"locals":{"people":[[7,0],[7,1],[6,1],[5,0],[5,2],[4,4]]},"depth":1},{"line":19,"locals":{"people":[[7,0],[7,1],[6,1],[5,0],[5,2],[4,4]],"ans":[]},"depth":1},{"line":21,"locals":{"people":[[7,0],[7,1],[6,1],[5,0],[5,2],[4,4]],"ans":[],"person":[7,0]},"depth":1},{"line":19,"locals":{"people":[[7,0],[7,1],[6,1],[5,0],[5,2],[4,4]],"ans":[[7,0]],"person":[7,0]},"depth":1},{"line":21,"locals":{"people":[[7,0],[7,1],[6,1],[5,0],[5,2],[4,4]],"ans":[[7,0]],"person":[7,1]},"depth":1},{"line":19,"locals":{"people":[[7,0],[7,1],[6,1],[5,0],[5,2],[4,4]],"ans":[[7,0],[7,1]],"person":[7,1]},"depth":1},{"line":21,"locals":{"people":[[7,0],[7,1],[6,1],[5,0],[5,2],[4,4]],"ans":[[7,0],[7,1]],"person":[6,1]},"depth":1},{"line":19,"locals":{"people":[[7,0],[7,1],[6,1],[5,0],[5,2],[4,4]],"ans":[[7,0],[6,1],[7,1]],"person":[6,1]},"depth":1},{"line":21,"locals":{"people":[[7,0],[7,1],[6,1],[5,0],