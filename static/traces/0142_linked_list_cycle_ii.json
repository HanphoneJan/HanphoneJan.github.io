{"docKey":"0142_linked_list_cycle_ii","code":"from typing import Optional\n\nclass ListNode:\n    def __init__(self, x):\n        self.val = x\n        self.next = None\n\nclass Solution:\n    \"\"\"\n    142. 环形链表 II - Floyd 判圈算法\n\n    核心思想：\n    1. 快慢指针找到相遇点\n    2. 再用两个指针分别从 head 和相遇点同步前进，相遇点即环入口\n\n    时间复杂度：O(n)\n    空间复杂度：O(1)\n    \"\"\"\n\n    def detectCycle(self, head: Optional[ListNode]) -> Optional[ListNode]:\n        slow = fast = head\n\n        # 步骤1：找相遇点\n        while fast and fast.next:\n            slow = slow.next\n            fast = fast.next.next\n            if fast is slow:  # 相遇\n                # 步骤2：找环入口\n                while slow is not head:\n                    slow = slow.next\n                    head = head.next\n                return slow\n\n        return None","method":"detectCycle","paramNames":["head"],"argKinds":["list"],"args":["[3,2,0,-4]"],"expected":"指数为 1 的节点","result":[2,0,-4],"events":[{"line":21,"locals":{"head":{"$":"list","v":[3,2,0,-4]}},"depth":1},{"line":24,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"list","v":[3,2,0,-4]},"fast":{"$":"list","v":[3,2,0,-4]}},"depth":1},{"line":25,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"list","v":[3,2,0,-4]},"fast":{"$":"list","v":[3,2,0,-4]}},"depth":1},{"line":26,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":1,"v":2},"fast":{"$":"list","v":[3,2,0,-4]}},"depth":1},{"line":27,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":1,"v":2},"fast":{"$":"n","i":2,"v":0}},"depth":1},{"line":24,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":1,"v":2},"fast":{"$":"n","i":2,"v":0}},"depth":1},{"line":25,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":1,"v":2},"fast":{"$":"n","i":2,"v":0}},"depth":1},{"line":26,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":2,"v":0},"fast":{"$":"n","i":2,"v":0}},"depth":1},{"line":27,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n",