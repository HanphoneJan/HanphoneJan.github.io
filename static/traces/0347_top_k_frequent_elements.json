{"docKey":"0347_top_k_frequent_elements","code":"from typing import List\nfrom collections import Counter\nimport heapq\n\nclass Solution:\n    \"\"\"\n    前 K 个高频元素 - 堆排序解法\n\n    核心思路：\n    1. 使用 Counter 统计每个元素的出现频率\n    2. 维护一个大小为 k 的最小堆\n    3. 堆顶元素是 k 个高频元素中频率最小的\n    4. 当遇到频率更高的元素时，替换堆顶元素\n\n    时间复杂度: O(n log k)\n    空间复杂度: O(n + k)\n    \"\"\"\n    def topKFrequent(self, nums: List[int], k: int) -> List[int]:\n        # 统计每个元素的出现频率\n        freq_map = Counter(nums)\n\n        # 维护一个大小为 k 的最小堆\n        heap = []\n        for num, freq in freq_map.items():\n            if len(heap) < k:\n                heapq.heappush(heap, (freq, num))\n            else:\n                # 堆已满，如果当前频率大于堆顶，替换堆顶\n                if freq > heap[0][0]:\n                    heapq.heapreplace(heap, (freq, num))\n\n        return [num for _, num in heap]","method":"topKFrequent","paramNames":["nums","k"],"args":["[1,1,1,2,2,3]","2"],"expected":"[1,2]","result":[2,1],"events":[{"line":20,"locals":{"nums":[1,1,1,2,2,3],"k":2},"depth":1},{"line":23,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1}},"depth":1},{"line":24,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[]},"depth":1},{"line":25,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[],"num":1,"freq":3},"depth":1},{"line":26,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[],"num":1,"freq":3},"depth":1},{"line":24,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[3,1]],"num":1,"freq":3},"depth":1},{"line":25,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[3,1]],"num":2,"freq":2},"depth":1},{"line":26,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[3,1]],"num":2,"freq":2},"depth":1},{"line":24,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[2,2],[3,1]],"num":2,"freq":2},"depth":1},{"line":25,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[2,2],[3,1]],"num":3,"freq":1},"depth":1},{"line":29,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[2,2],[3,1]],"num":3,"freq":1},"depth":1},{"line":24,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[2,2],[3,1]],"num":3,"freq":1},"depth":1},{"line":32,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[2,2],[3,1]],"num":3,"freq":1},"depth":1},{"line":32,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[2,2],[3,1]],"num":2,"freq":1,"_":2},"depth":1},{"line":32,"locals":{"nums":[1,1,1,2,2,3],"k":2,"freq_map":{"1":3,"2":2,"3":1},"heap":[[2,2],[3,1]],"num":1,"freq":1,"_":3},"depth":1}]}