{"docKey":"0008_string_to_integer_atoi","code":"class Solution:\n    def myAtoi(self, s: str) -> int:\n        # 步骤 1：去除前导空格\n        s = s.strip()\n        if not s:\n            return 0\n\n        # 步骤 2：读取符号\n        sign = 1\n        if s[0] == '-':\n            sign = -1\n            s = s[1:]\n        elif s[0] == '+':\n            s = s[1:]\n\n        # 步骤 3：逐字符读取数字，遇到非数字停止\n        num = 0\n        for char in s:\n            if char not in '0123456789':\n                break\n            num = num * 10 + int(char)\n\n        # 步骤 4：乘以符号后夹紧到 32 位范围\n        result = num * sign\n        if result < -2147483648:\n            return -2147483648\n        if result > 2147483647:\n            return 2147483647\n        return result","method":"myAtoi","paramNames":["s"],"args":["\"1337c0d3\""],"expected":"1337","result":1337,"events":[{"line":4,"locals":{"s":"1337c0d3"},"depth":1},{"line":5,"locals":{"s":"1337c0d3"},"depth":1},{"line":9,"locals":{"s":"1337c0d3"},"depth":1},{"line":10,"locals":{"s":"1337c0d3","sign":1},"depth":1},{"line":13,"locals":{"s":"1337c0d3","sign":1},"depth":1},{"line":17,"locals":{"s":"1337c0d3","sign":1},"depth":1},{"line":18,"locals":{"s":"1337c0d3","sign":1,"num":0},"depth":1},{"line":19,"locals":{"s":"1337c0d3","sign":1,"num":0,"char":"1"},"depth":1},{"line":21,"locals":{"s":"1337c0d3","sign":1,"num":0,"char":"1"},"depth":1},{"line":18,"locals":{"s":"1337c0d3","sign":1,"num":1,"char":"1"},"depth":1},{"line":19,"locals":{"s":"1337c0d3","sign":1,"num":1,"char":"3"},"depth":1},{"line":21,"locals":{"s":"1337c0d3","sign":1,"num":1,"char":"3"},"depth":1},{"line":18,"locals":{"s":"1337c0d3","sign":1,"num":13,"char":"3"},"depth":1},{"line":19,"locals":{"s":"1337c0d3","sign":1,"num":13,"char":"3"},"depth":1},{"line":21,"locals":{"s":"1337c0d3","sign":1,"num":13,"char":"3"},"depth":1},{"line":18,"locals":{"s":"1337c0d3","sign":1,"num":133,"char":"3"},"depth":1},{"line":19,"locals":{"s":"1337c0d3","sign":1,"num":133,"char":"7"},"depth":1},{"lin