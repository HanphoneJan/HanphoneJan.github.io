{"docKey":"0008_string_to_integer_atoi","code":"class Solution:\n    def myAtoi(self, s: str) -> int:\n        n = len(s)\n        i = 0\n\n        # ① 跳过前导空格\n        while i < n and s[i] == ' ':\n            i += 1\n\n        # ② 至多读一个符号\n        sign = 1\n        if i < n and s[i] in '+-':\n            if s[i] == '-':\n                sign = -1\n            i += 1\n\n        # ③ 读连续数字：一旦不是 ASCII 数字就停\n        num = 0\n        while i < n and '0' <= s[i] <= '9':\n            num = num * 10 + int(s[i])\n            i += 1\n\n        # ④ 乘符号后夹到 32 位有符号整数范围\n        num *= sign\n        if num < -2**31:\n            return -2**31\n        if num > 2**31 - 1:\n            return 2**31 - 1\n        return num","method":"myAtoi","paramNames":["s"],"args":["\"1337c0d3\""],"expected":"1337","result":1337,"events":[{"line":3,"locals":{"s":"1337c0d3"},"depth":1},{"line":4,"locals":{"s":"1337c0d3","n":8},"depth":1},{"line":7,"locals":{"s":"1337c0d3","n":8,"i":0},"depth":1},{"line":11,"locals":{"s":"1337c0d3","n":8,"i":0},"depth":1},{"line":12,"locals":{"s":"1337c0d3","n":8,"i":0,"sign":1},"depth":1},{"line":18,"locals":{"s":"1337c0d3","n":8,"i":0,"sign":1},"depth":1},{"line":19,"locals":{"s":"1337c0d3","n":8,"i":0,"sign":1,"num":0},"depth":1},{"line":20,"locals":{"s":"1337c0d3","n":8,"i":0,"sign":1,"num":0},"depth":1},{"line":21,"locals":{"s":"1337c0d3","n":8,"i":0,"sign":1,"num":1},"depth":1},{"line":19,"locals":{"s":"1337c0d3","n":8,"i":1,"sign":1,"num":1},"depth":1},{"line":20,"locals":{"s":"1337c0d3","n":8,"i":1,"sign":1,"num":1},"depth":1},{"line":21,"locals":{"s":"1337c0d3","n":8,"i":1,"sign":1,"num":13},"depth":1},{"line":19,"locals":{"s":"1337c0d3","n":8,"i":2,"sign":1,"num":13},"depth":1},{"line":20,"locals":{"s":"1337c0d3","n":8,"i":2,"sign":1,"num":13},"depth":1},{"line":21,"locals":{"s":"1337c0d3","n":8,"i":2,"sign":1,"num":133},"depth":1},{"line":19,"locals":{"s":"1337c0d3","n":8,"i":3,"sign":1,"num":133},"depth":1},{"line":20,"locals":{"s":"1337c0d3","n":8,"i":