{"docKey":"BISHI76.迷宫寻路","code":"import sys\nfrom collections import deque\n\n\ndef solve() -> None:\n    \"\"\"从左上角 BFS，判断能否到达右下角\"\"\"\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n    grid = data[2:2 + n]\n\n    if grid[0][0] == '#' or grid[n - 1][m - 1] == '#':\n        sys.stdout.write(\"No\\n\")\n        return\n\n    seen = [[False] * m for _ in range(n)]\n    seen[0][0] = True\n    queue = deque([(0, 0)])\n    while queue:\n        x, y = queue.popleft()\n        if x == n - 1 and y == m - 1:\n            sys.stdout.write(\"Yes\\n\")\n            return\n        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < n and 0 <= ny < m and not seen[nx][ny] and grid[nx][ny] == '.':\n                seen[nx][ny] = True\n                queue.append((nx, ny))\n    sys.stdout.write(\"No\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"3 5\n.##.#\n.#...\n...#.","expected":"Yes","result":null,"events":[{"line":7,"locals":{},"depth":1},{"line":8,"locals":{"data":["3","5",".##.#",".#...","...#."]},"depth":1},{"line":10,"locals":{"data":["3","5",".##.#",".#...","...#."]},"depth":1},{"line":11,"locals":{"data":["3","5",".##.#",".#...","...#."],"n":3},"depth":1},{"line":12,"locals":{"data":["3","5",".##.#",".#...","...#."],"n":3,"m":5},"depth":1},{"line":14,"locals":{"data":["3","5",".##.#",".#...","...#."],"n":3,"m":5,"grid":[".##.#",".#...","...#."]},"depth":1},{"line":18,"locals":{"data":["3","5",".##.#",".#...","...#."],"n":3,"m":5,"grid":[".##.#",".#...","...#."]},"depth":1},{"line":18,"locals":{"data":["3","5",".##.#",".#...","...#."],"n":3,"m":5,"grid":[".##.#",".#...","...#."],"_":0},"depth":1},{"line":18,"locals":{"data":["3","5",".##.#",".#...","...#."],"n":3,"m":5,"grid":[".##.#",".#...","...#."],"_":1},"depth":1},{"line":18,"locals":{"data":["3","5",".##.#",".#...","...#."],"n"