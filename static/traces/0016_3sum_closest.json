{"docKey":"0016_3sum_closest","code":"class Solution:\n    def threeSumClosest(self, nums: list[int], target: int) -> int:\n        # 排序后才有「left 右移变大、right 左移变小」的单调性\n        nums.sort()\n        # result 暂存当前最接近的和；min_sub 用无穷大起手，保证第一组必然更新它\n        result = None\n        min_sub = float('inf')\n        # 固定第一个数，后面还要留两个位置，所以枚举到倒数第三个即可\n        for i in range(len(nums) - 2):\n            # 双指针在 i 右侧的区间里夹逼\n            left, right = i + 1, len(nums) - 1\n            # 两指针相遇说明以 i 为固定项的组合已全部试过\n            while left < right:\n                # sub 是「目标值与当前三数和的差」：正数表示和偏小，负数表示和偏大\n                sub = target - nums[i] - nums[left] - nums[right]\n                if sub == 0:\n                    # 差值 0 已是最优，不可能再有更近的和，直接返回\n                    return nums[i] + nums[left] + nums[right]\n                # 只有差值绝对值更小时才更新，避免把更差的解放进来\n                if abs(sub) < min_sub:\n                    min_sub = abs(sub)\n                    result = nums[i] + nums[left] + nums[right]\n                if sub > 0:\n                    # 和偏小：把左指针右移，换一个更大的数\n                    left += 1\n                else:\n                    # 和偏大：把右指针左移，换一个更小的数\n                    right -= 1\n        # 循环至少执行过一次，result 一定已被赋值\n        return result","method":"threeSumClosest","paramNames":["nums","target"],"args":["[-1,2,1,-4]","1"],"expected":"2","result":2,"events":[{"line":4,"locals":{"nums":[-1,2,1,-4],"target":1},"depth":1},{"line":6,"locals":{"nums":[-4,-1,1,2],"target":1},"depth":1},{"line":7,"locals":{"nums":[-4,-1,1,2],"target":1,"result":null},"depth":1},{"line":9,"locals":{"nums":[-4,-1,1,2],"target":1,"result":null,"min_sub":null},"depth":1},{"line":11,"locals":{"nums":[-4,-1,1,2],"target":1,"result":null,"min_sub":null,"i":0},"depth":1},{"line":13,"locals":{"nums":[-4,-1,1,2],"target":1,"result":null,"min_sub":null,"i":0,"left":1,"right":3},"depth":1},{"line":15,"locals":{"nums":[-4,-1,1,2],"target":1,"result":null,"min_sub":null,"i":0,"left":1,"right":3},"depth":1},{"line":16,"locals"