{"docKey":"3493_properties_graph","code":"from typing import List\n\n\nclass Solution:\n    def numberOfComponents(self, properties: List[List[int]], k: int) -> int:\n        n = len(properties)\n        sets = [set(row) for row in properties]     # 同一行的重复属性只算一次\n\n        parent = list(range(n))\n\n        def find(x: int) -> int:\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]       # 路径压缩\n                x = parent[x]\n            return x\n\n        def union(a: int, b: int) -> None:\n            ra, rb = find(a), find(b)\n            if ra != rb:\n                parent[ra] = rb\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                if len(sets[i] & sets[j]) >= k:\n                    union(i, j)\n\n        # 数「根的种类」，不是数合并次数\n        return len({find(i) for i in range(n)})","method":"numberOfComponents","paramNames":["properties","k"],"args":["[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]]","1"],"expected":"3","result":3,"events":[{"line":6,"locals":{"properties":[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]],"k":1},"depth":1},{"line":7,"locals":{"properties":[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]],"k":1,"n":6},"depth":1},{"line":7,"locals":{"properties":[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]],"k":1,"n":6,"row":[1,2]},"depth":1},{"line":7,"locals":{"properties":[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]],"k":1,"n":6,"row":[1,1]},"depth":1},{"line":7,"locals":{"properties":[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]],"k":1,"n":6,"row":[3,4]},"depth":1},{"line":7,"locals":{"properties":[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]],"k":1,"n":6,"row":[4,5]},"depth":1},{"line":7,"locals":{"properties":[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]],"k":1,"n":6,"row":[5,6]},"depth":1},{"line":7,"locals":{"properties":[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]],"k":1,"n":6,"row":[7,7]},"depth":1},{"line":9,"locals":{"properties":[[1,2],[1,1],[3,4],[4,5],[5,6],[7,7]],"k":1,"n":6,"sets":[[1,2],[1],[3,4],[4,5],[5,6],[7]]},"depth":1},{"line":11,"locals":{"propertie