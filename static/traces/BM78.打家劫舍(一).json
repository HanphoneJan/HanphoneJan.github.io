{"docKey":"BM78.打家劫舍(一)","code":"from typing import List\n\n\nclass Solution:\n    def rob(self, nums: List[int]) -> int:\n        \"\"\"打家劫舍（不可偷相邻），滚动变量优化到 O(1) 空间\"\"\"\n        prev, cur = 0, 0          # prev = dp[i-2], cur = dp[i-1]\n        for x in nums:\n            prev, cur = cur, max(cur, prev + x)\n        return cur","method":"rob","paramNames":["nums"],"args":["[1,2,3,4]"],"expected":"6","result":6,"events":[{"line":7,"locals":{"nums":[1,2,3,4]},"depth":1},{"line":8,"locals":{"nums":[1,2,3,4],"prev":0,"cur":0},"depth":1},{"line":9,"locals":{"nums":[1,2,3,4],"prev":0,"cur":0,"x":1},"depth":1},{"line":8,"locals":{"nums":[1,2,3,4],"prev":0,"cur":1,"x":1},"depth":1},{"line":9,"locals":{"nums":[1,2,3,4],"prev":0,"cur":1,"x":2},"depth":1},{"line":8,"locals":{"nums":[1,2,3,4],"prev":1,"cur":2,"x":2},"depth":1},{"line":9,"locals":{"nums":[1,2,3,4],"prev":1,"cur":2,"x":3},"depth":1},{"line":8,"locals":{"nums":[1,2,3,4],"prev":2,"cur":4,"x":3},"depth":1},{"line":9,"locals":{"nums":[1,2,3,4],"prev":2,"cur":4,"x":4},"depth":1},{"line":8,"locals":{"nums":[1,2,3,4],"prev":4,"cur":6,"x":4},"depth":1},{"line":10,"locals":{"nums":[1,2,3,4],"prev":4,"cur":6,"x":4},"depth":1}]}