{"docKey":"0560_subarray_sum_equals_k","code":"from typing import List\nfrom collections import defaultdict\n\nclass Solution:\n    \"\"\"\n    和为 K 的子数组 - 前缀和 + 哈希表\n\n    核心思路：\n    利用前缀和的思想。子数组 nums[i:j] 的和 = prefix[j] - prefix[i]。\n    如果和等于 k，则 prefix[i] = prefix[j] - k。\n    用哈希表记录前缀和出现的次数，快速查找满足条件的子数组个数。\n\n    时间复杂度: O(n)\n    空间复杂度: O(n)\n    \"\"\"\n    def subarraySum(self, nums: List[int], k: int) -> int:\n        cnt = defaultdict(int)  # 记录前缀和出现的次数\n        cnt[0] = 1              # 前缀和为 0 的子数组有 1 个\n        ans = 0                 # 和为 k 的子数组个数\n        curr_sum = 0            # 当前前缀和\n\n        for x in nums:\n            curr_sum += x\n            # 以当前位置结尾的和为 k 的子数组个数\n            ans += cnt[curr_sum - k]\n            cnt[curr_sum] += 1\n\n        return ans","method":"subarraySum","paramNames":["nums","k"],"args":["[1,2,3]","3"],"expected":"2","result":2,"events":[{"line":17,"locals":{"nums":[1,2,3],"k":3},"depth":1},{"line":18,"locals":{"nums":[1,2,3],"k":3,"cnt":{}},"depth":1},{"line":19,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1}},"depth":1},{"line":20,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1},"ans":0},"depth":1},{"line":22,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1},"ans":0,"curr_sum":0},"depth":1},{"line":23,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1},"ans":0,"curr_sum":0,"x":1},"depth":1},{"line":25,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1},"ans":0,"curr_sum":1,"x":1},"depth":1},{"line":26,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"-2":0},"ans":0,"curr_sum":1,"x":1},"depth":1},{"line":22,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"-2":0},"ans":0,"curr_sum":1,"x":1},"depth":1},{"line":23,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"-2":0},"ans":0,"curr_sum":1,"x":2},"depth":1},{"line":25,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"-2":0},"ans":0,"curr_sum":3,"x":2},"depth":1},{"line":26,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"-2":0},"ans":1,"curr_sum":3,"x":2},"depth":1},{"line":22,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"3":1,"-2":0},"ans":1,"curr_sum":3,"x":2},"depth":1},{"line":23,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"3":1,"-2":0},"ans":1,"curr_sum":3,"x":3},"depth":1},{"line":25,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"3":1,"-2":0},"ans":1,"curr_sum":6,"x":3},"depth":1},{"line":26,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"3":1,"-2":0},"ans":2,"curr_sum":6,"x":3},"depth":1},{"line":22,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"3":1,"6":1,"-2":0},"ans":2,"curr_sum":6,"x":3},"depth":1},{"line":28,"locals":{"nums":[1,2,3],"k":3,"cnt":{"0":1,"1":1,"3":1,"6":1,"-2":0},"ans":2,"curr_sum":6,"x":3},"depth":1}]}