{"docKey":"小美的平衡矩阵","code":"import sys\n\n\ndef solve() -> None:\n    \"\"\"二维前缀和，枚举偶数边长的子矩阵\"\"\"\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    grid = data[1:1 + n]\n\n    pre = [[0] * (n + 1) for _ in range(n + 1)]\n    for i in range(n):\n        row = grid[i]\n        for j in range(n):\n            pre[i + 1][j + 1] = (\n                pre[i][j + 1] + pre[i + 1][j] - pre[i][j]\n                + (1 if row[j] == '1' else 0)\n            )\n\n    res = [0] * (n + 1)\n    for k in range(2, n + 1, 2):          # 奇数边长必为 0，跳过\n        half = k * k // 2\n        for i in range(k, n + 1):\n            for j in range(k, n + 1):\n                ones = (pre[i][j] - pre[i - k][j]\n                        - pre[i][j - k] + pre[i - k][j - k])\n                if ones == half:\n                    res[k] += 1\n\n    sys.stdout.write(\"\\n\".join(str(res[i]) for i in range(1, n + 1)) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"4\n1010\n0101\n1100\n0011","expected":"0\n7\n0\n1","result":null,"events":[{"line":6,"locals":{},"depth":1},{"line":7,"locals":{"data":["4","1010","0101","1100","0011"]},"depth":1},{"line":9,"locals":{"data":["4","1010","0101","1100","0011"]},"depth":1},{"line":10,"locals":{"data":["4","1010","0101","1100","0011"],"n":4},"depth":1},{"line":12,"locals":{"data":["4","1010","0101","1100","0011"],"n":4,"grid":["1010","0101","1100","0011"]},"depth":1},{"line":12,"locals":{"data":["4","1010","0101","1100","0011"],"n":4,"grid":["1010","0101","1100","0011"],"_":0},"depth":1},{"line":12,"locals":{"data":["4","1010","0101","1100","0011"],"n":4,"grid":["1010","0101","1100","0011"],"_":1},"depth":1},{"line":12,"locals":{"data":["4","1010","0101","1100","0011"],"n":4,"grid":["1010","0101","1100","0011"],"_":2},"depth":1},{"line":12,"locals":{"data":["4","1010","0101","1100","0011"],"n":4,"grid":["1010","0101","1100","0011"],"_":3},"depth":1},{"line