{"docKey":"0128_longest_consecutive_sequence","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    128. 最长连续序列 - 哈希表\n\n    核心思想：\n    利用哈希集合 O(1) 查找的特性，只从序列起点开始向右扩展连续序列。\n\n    时间复杂度：O(n)\n    空间复杂度：O(n)，哈希集合\n    \"\"\"\n\n    def longestConsecutive(self, nums: List[int]) -> int:\n        st = set(nums)\n        ans = 0\n\n        for x in st:\n            if x - 1 in st:\n                continue\n\n            y = x + 1\n            while y in st:\n                y += 1\n\n            ans = max(ans, y - x)\n\n        return ans","method":"longestConsecutive","paramNames":["nums"],"args":["[0,3,7,2,5,8,4,6,0,1]"],"expected":"9","result":9,"events":[{"line":15,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1]},"depth":1},{"line":16,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8]},"depth":1},{"line":18,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0},"depth":1},{"line":19,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0},"depth":1},{"line":22,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0},"depth":1},{"line":23,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0,"y":1},"depth":1},{"line":24,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0,"y":1},"depth":1},{"line":23,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0,"y":2},"depth":1},{"line":24,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0,"y":2},"depth":1},{"line":23,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0,"y":3},"depth":1},{"line":24,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0,"y":3},"depth":1},{"line":23,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0,"y":4},"depth":1},{"line":24,"locals":{"nums":[0,3,7,2,5,8,4,6,0,1],"st":[0,1,2,3,4,5,6,7,8],"ans":0,"x":0,"y":4},"depth":1},{"line":23,"locals":{"