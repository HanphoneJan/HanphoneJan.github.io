{"docKey":"1480_running_sum_of_1d_array","code":"from typing import List\n\n\nclass Solution:\n    def runningSum(self, nums: List[int]) -> List[int]:\n        n = len(nums)\n        if n == 0:\n            return []\n\n        running = [0] * n\n        running[0] = nums[0]          # 第 0 位没有前一项\n        for i in range(1, n):\n            running[i] = running[i - 1] + nums[i]\n        return running","method":"runningSum","paramNames":["nums"],"args":["[1,2,3,4]"],"expected":"[1,3,6,10]","result":[1,3,6,10],"events":[{"line":6,"locals":{"nums":[1,2,3,4]},"depth":1},{"line":7,"locals":{"nums":[1,2,3,4],"n":4},"depth":1},{"line":10,"locals":{"nums":[1,2,3,4],"n":4},"depth":1},{"line":11,"locals":{"nums":[1,2,3,4],"n":4,"running":[0,0,0,0]},"depth":1},{"line":12,"locals":{"nums":[1,2,3,4],"n":4,"running":[1,0,0,0]},"depth":1},{"line":13,"locals":{"nums":[1,2,3,4],"n":4,"running":[1,0,0,0],"i":1},"depth":1},{"line":12,"locals":{"nums":[1,2,3,4],"n":4,"running":[1,3,0,0],"i":1},"depth":1},{"line":13,"locals":{"nums":[1,2,3,4],"n":4,"running":[1,3,0,0],"i":2},"depth":1},{"line":12,"locals":{"nums":[1,2,3,4],"n":4,"running":[1,3,6,0],"i":2},"depth":1},{"line":13,"locals":{"nums":[1,2,3,4],"n":4,"running":[1,3,6,0],"i":3},"depth":1},{"line":12,"locals":{"nums":[1,2,3,4],"n":4,"running":[1,3,6,10],"i":3},"depth":1},{"line":14,"locals":{"nums":[1,2,3,4],"n":4,"running":[1,3,6,10],"i":3},"depth":1}]}