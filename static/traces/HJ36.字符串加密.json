{"docKey":"HJ36.字符串加密","code":"import sys\n\n\ndef build_alphabet(key: str) -> str:\n    \"\"\"构建新字母表：key 去重 + 补充缺失字母\"\"\"\n    seen = set()\n    alpha = []\n    for ch in key:\n        if ch not in seen:\n            seen.add(ch)\n            alpha.append(ch)\n    # 补充 a-z 中未出现的字母\n    for ch in \"abcdefghijklmnopqrstuvwxyz\":\n        if ch not in seen:\n            alpha.append(ch)\n    return ''.join(alpha)\n\n\ndef solve() -> None:\n    \"\"\"主求解函数\"\"\"\n    key = sys.stdin.readline().strip()\n    plain = sys.stdin.readline().strip()\n    table = build_alphabet(key)\n    result = ''.join(table[ord(c) - ord('a')] for c in plain)\n    print(result)\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"trailblazers\nattackatdawn","expected":"tpptadtpitvh","result":null,"events":[{"line":21,"locals":{},"depth":1},{"line":22,"locals":{"key":"trailblazers"},"depth":1},{"line":23,"locals":{"key":"trailblazers","plain":"attackatdawn"},"depth":1},{"line":6,"locals":{"key":"trailblazers"},"depth":2},{"line":7,"locals":{"key":"trailblazers","seen":[]},"depth":2},{"line":8,"locals":{"key":"trailblazers","seen":[],"alpha":[]},"depth":2},{"line":9,"locals":{"key":"trailblazers","seen":[],"alpha":[],"ch":"t"},"depth":2},{"line":10,"locals":{"key":"trailblazers","seen":[],"alpha":[],"ch":"t"},"depth":2},{"line":11,"locals":{"key":"trailblazers","seen":["t"],"alpha":[],"ch":"t"},"depth":2},{"line":8,"locals":{"key":"trailblazers","seen":["t"],"alpha":["t"],"ch":"t"},"depth":2},{"line":9,"locals":{"key":"trailblazers","seen":["t"],"alpha":["t"],"ch":"r"},"depth":2},{"line":10,"locals":{"key":"trailblazers","seen":["t"],"alpha":["t"],"ch":"r"},"depth":2},{"line":11,"locals":{"key":"trailblazers","seen":["r","t"],"alpha":["t"],"ch":"r"},"depth":2},{"line":8,"locals":{"key":"trailblazers","seen":["r","t"],"alpha":["t","r"],"ch":"r"},"depth":2},{"line":9,"locals":{"key":"trailblazers","seen":["r","t"],"alpha":["t","r"],"ch":"a"},"depth