{"docKey":"0006_zigzag_conversion","code":"class Solution:\n    def convert(self, s: str, numRows: int) -> str:\n        # 只有一行时，Z 字形退化为原字符串\n        if numRows == 1:\n            return s\n\n        rows = [''] * numRows  # 每行的字符收集桶\n        index = 0              # 当前所在行\n        flag = 1               # 行进方向：+1 向下，-1 向上\n\n        for ch in s:\n            rows[index] += ch\n            # 到达第一行：转为向下；到达最后一行：转为向上\n            if index == 0:\n                flag = 1\n            elif index == numRows - 1:\n                flag = -1\n            index += flag\n\n        return ''.join(rows)","method":"convert","paramNames":["s","numRows"],"args":["\"PAYPALISHIRING\"","3"],"expected":"\"PAHNAPLSIIGYIR\"","result":"PAHNAPLSIIGYIR","events":[{"line":4,"locals":{"s":"PAYPALISHIRING","numRows":3}},{"line":7,"locals":{"s":"PAYPALISHIRING","numRows":3}},{"line":8,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["","",""]}},{"line":9,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["","",""],"index":0}},{"line":11,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["","",""],"index":0,"flag":1}},{"line":12,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["","",""],"index":0,"flag":1,"ch":"P"}},{"line":14,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"index":0,"flag":1,"ch":"P"}},{"line":15,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"index":0,"flag":1,"ch":"P"}},{"line":18,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"index":0,"flag":1,"ch":"P"}},{"line":11,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"index":1,"flag":1,"ch":"P"}},{"line":12,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"index":1,"flag":1,"ch":"A"}},{"line":14,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","A",""],"index":1,"flag":1,"ch":"A"}},{"line":16,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","A",""],"index":1,"flag":1,"ch":"A"}},{"line":18,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","