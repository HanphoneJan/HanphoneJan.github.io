{"docKey":"0006_zigzag_conversion","code":"class Solution:\n    def convert(self, s: str, numRows: int) -> str:\n        # 单行时电梯的顶和底重合，没有往复可走\n        if numRows == 1:\n            return s\n\n        rows = [''] * numRows\n        row, step = 0, 1\n\n        for ch in s:\n            rows[row] += ch          # ① 落格\n            if row == 0:\n                step = 1             # ② 到顶，朝下\n            elif row == numRows - 1:\n                step = -1            # ② 到底，朝上\n            row += step              # ③ 走一层\n\n        return ''.join(rows)","method":"convert","paramNames":["s","numRows"],"args":["\"PAYPALISHIRING\"","3"],"expected":"\"PAHNAPLSIIGYIR\"","result":"PAHNAPLSIIGYIR","events":[{"line":4,"locals":{"s":"PAYPALISHIRING","numRows":3},"depth":1},{"line":7,"locals":{"s":"PAYPALISHIRING","numRows":3},"depth":1},{"line":8,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["","",""]},"depth":1},{"line":10,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["","",""],"row":0,"step":1},"depth":1},{"line":11,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["","",""],"row":0,"step":1,"ch":"P"},"depth":1},{"line":12,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"row":0,"step":1,"ch":"P"},"depth":1},{"line":13,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"row":0,"step":1,"ch":"P"},"depth":1},{"line":16,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"row":0,"step":1,"ch":"P"},"depth":1},{"line":10,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"row":1,"step":1,"ch":"P"},"depth":1},{"line":11,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","",""],"row":1,"step":1,"ch":"A"},"depth":1},{"line":12,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","A",""],"row":1,"step":1,"ch":"A"},"depth":1},{"line":14,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","A",""],"row":1,"step":1,"ch":"A"},"depth":1},{"line":16,"locals":{"s":"PAYPALISHIRING","numRows":3,"rows":["P","A",""],"row":1,"step":1