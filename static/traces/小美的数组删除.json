{"docKey":"小美的数组删除","code":"import sys\n\n\ndef solve() -> None:\n    \"\"\"后缀 DP + 单调递增的 MEX 指针\"\"\"\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    idx = 0\n    t = int(data[idx]); idx += 1\n    out = []\n    for _ in range(t):\n        n = int(data[idx]); k = int(data[idx + 1]); x = int(data[idx + 2]); idx += 3\n        a = [int(v) for v in data[idx:idx + n]]; idx += n\n\n        present = [False] * (n + 2)\n        mex = 0\n        f_next = 0                      # f[n]\n        for i in range(n - 1, -1, -1):\n            v = a[i]\n            if v < len(present):\n                present[v] = True\n            while mex < len(present) and present[mex]:\n                mex += 1\n            f_cur = min(x + f_next, k * mex)\n            f_next = f_cur\n        out.append(str(f_next))\n    sys.stdout.write(\"\\n\".join(out) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"1\n6 3 3\n4 5 2 3 1 0","expected":"15","result":null,"events":[{"line":6,"locals":{},"depth":1},{"line":7,"locals":{"data":["1","6","3","3","4","5","2","3","1","0"]},"depth":1},{"line":9,"locals":{"data":["1","6","3","3","4","5","2","3","1","0"]},"depth":1},{"line":10,"locals":{"data":["1","6","3","3","4","5","2","3","1","0"],"idx":0},"depth":1},{"line":11,"locals":{"data":["1","6","3","3","4","5","2","3","1","0"],"idx":1,"t":1},"depth":1},{"line":12,"locals":{"data":["1","6","3","3","4","5","2","3","1","0"],"idx":1,"t":1,"out":[]},"depth":1},{"line":13,"locals":{"data":["1","6","3","3","4","5","2","3","1","0"],"idx":1,"t":1,"out":[],"_":0},"depth":1},{"line":14,"locals":{"data":["1","6","3","3","4","5","2","3","1","0"],"idx":4,"t":1,"out":[],"_":0,"n":6,"k":3,"x":3},"depth":1},{"line":14,"locals":{"data":["1","6","3","3","4","5","2","3","1","0"],"idx":4,"t":1,"out":[],"_":0,"n":6,"k":3,"x":3,"v":"4"},"depth":1},{"line":14,"locals":{"data":["1","6","3","3","4","5","2","3","1","0"],"idx":4,"t":1,"out":[],"_