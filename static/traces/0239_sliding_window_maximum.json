{"docKey":"0239_sliding_window_maximum","code":"from collections import deque\nfrom typing import List\n\n\nclass Solution:\n    def maxSlidingWindow(self, nums: List[int], k: int) -> List[int]:\n        ans = []\n        q = deque()                     # 存下标，值从队首到队尾递减\n        for i, x in enumerate(nums):\n            # ① 进队：队尾比新值小的都当不成最大值了\n            while q and nums[q[-1]] <= x:\n                q.pop()\n            q.append(i)\n            # ② 出队：队首滑出窗口\n            left = i - k + 1\n            if q[0] < left:\n                q.popleft()\n            # ③ 记住：窗口装满 k 个元素后，队首就是最大值\n            if left >= 0:\n                ans.append(nums[q[0]])\n        return ans","method":"maxSlidingWindow","paramNames":["nums","k"],"args":["[1,3,-1,-3,5,3,6,7]","3"],"expected":"[3,3,5,5,6,7]","result":[3,3,5,5,6,7],"events":[{"line":7,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3},"depth":1},{"line":8,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[]},"depth":1},{"line":9,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>"},"depth":1},{"line":11,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>","i":0,"x":1},"depth":1},{"line":13,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>","i":0,"x":1},"depth":1},{"line":15,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>","i":0,"x":1},"depth":1},{"line":16,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>","i":0,"x":1,"left":-2},"depth":1},{"line":19,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>","i":0,"x":1,"left":-2},"depth":1},{"line":9,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>","i":0,"x":1,"left":-2},"depth":1},{"line":11,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>","i":1,"x":3,"left":-2},"depth":1},{"line":12,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>","i":1,"x":3,"left":-2},"depth":1},{"line":11,"locals":{"nums":[1,3,-1,-3,5,3,6,7],"k":3,"ans":[],"q":"<deque>","i":1,"x":