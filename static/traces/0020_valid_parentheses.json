{"docKey":"0020_valid_parentheses","code":"class Solution:\n    def isValid(self, s: str) -> bool:\n        stack = []\n        pair_map = {')': '(', ']': '[', '}': '{'}\n        for char in s:\n            if char in '([{':          # 左括号，压栈\n                stack.append(char)\n            else:                       # 右括号，检查栈顶\n                if not stack or stack.pop() != pair_map[char]:\n                    return False        # 栈空或类型不匹配\n        return len(stack) == 0          # 栈为空才说明全部合法闭合","method":"isValid","paramNames":["s"],"args":["\"()[]{}\""],"expected":"true","result":true,"events":[{"line":3,"locals":{"s":"()[]{}"}},{"line":4,"locals":{"s":"()[]{}","stack":[]}},{"line":5,"locals":{"s":"()[]{}","stack":[],"pair_map":{")":"(","]":"[","}":"{"}}},{"line":6,"locals":{"s":"()[]{}","stack":[],"pair_map":{")":"(","]":"[","}":"{"},"char":"("}},{"line":7,"locals":{"s":"()[]{}","stack":[],"pair_map":{")":"(","]":"[","}":"{"},"char":"("}},{"line":5,"locals":{"s":"()[]{}","stack":["("],"pair_map":{")":"(","]":"[","}":"{"},"char":"("}},{"line":6,"locals":{"s":"()[]{}","stack":["("],"pair_map":{")":"(","]":"[","}":"{"},"char":")"}},{"line":9,"locals":{"s":"()[]{}","stack":["("],"pair_map":{")":"(","]":"[","}":"{"},"char":")"}},{"line":5,"locals":{"s":"()[]{}","stack":[],"pair_map":{")":"(","]":"[","}":"{"},"char":")"}},{"line":6,"locals":{"s":"()[]{}","stack":[],"pair_map":{")":"(","]":"[","}":"{"},"char":"["}},{"line":7,"locals":{"s":"()[]{}","stack":[],"pair_map":{")":"(","]":"[","}":"{"},"char":"["}},{"line":5,"locals":{"s":"()[]{}","stack":["["],"pair_map":{")":"(","]":"[","}":"{"},"char":"["}},{"line":6,"locals":{"s":"()[]{}","stack":["["],"pair_map":{")":"(","]":"[","}":"{"},"char":"]"}},{"line":9,"locals":{"s":"()[]{}","stack":["["],"pair_map":{")":"(","]":"[","}":"{"},"char":"]"}},{"line":5,"locals":{"s":"()[]{}","stack":[],"pair_map":{")":"(","]":"[","}":"{"},"char":"]"}},{"line":6,"locals":{"s":"()[]{}","stack":[],"pair_map":{")":"(","]":"[","}":"{"},"ch