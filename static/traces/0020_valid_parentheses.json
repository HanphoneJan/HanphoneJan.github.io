{"docKey":"0020_valid_parentheses","code":"class Solution:\n    def isValid(self, s: str) -> bool:\n        pairs = {')': '(', ']': '[', '}': '{'}\n        stack = []\n        for ch in s:\n            if ch in pairs:\n                # 栈空说明这个右括号没有左括号可配；栈顶不是同类型也不行\n                if not stack or stack[-1] != pairs[ch]:\n                    return False\n                stack.pop()\n            else:\n                stack.append(ch)\n        return not stack        # 还有没闭合的左括号 -> 无效","method":"isValid","paramNames":["s"],"args":["\"()[]{}\""],"expected":"true","result":true,"events":[{"line":3,"locals":{"s":"()[]{}"},"depth":1},{"line":4,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"}},"depth":1},{"line":5,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":[]},"depth":1},{"line":6,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":[],"ch":"("},"depth":1},{"line":12,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":[],"ch":"("},"depth":1},{"line":5,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":["("],"ch":"("},"depth":1},{"line":6,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":["("],"ch":")"},"depth":1},{"line":8,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":["("],"ch":")"},"depth":1},{"line":10,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":["("],"ch":")"},"depth":1},{"line":5,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":[],"ch":")"},"depth":1},{"line":6,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":[],"ch":"["},"depth":1},{"line":12,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":[],"ch":"["},"depth":1},{"line":5,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":["["],"ch":"["},"depth":1},{"line":6,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":["["],"ch":"]"},"depth":1},{"line":8,"locals":{"s":"()[]{}","pairs":{")":"(","]":"[","}":"{"},"stack":["["],"ch