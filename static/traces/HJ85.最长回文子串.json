{"docKey":"HJ85.最长回文子串","code":"import sys\n\n\ndef longest_palindrome(s: str) -> int:\n    \"\"\"求字符串的最长回文子串长度（中心扩展法）\"\"\"\n    n = len(s)\n    if n <= 1:\n        return n\n\n    ans = 1\n\n    for i in range(n):\n        # 情况一：奇数长度回文，中心为 s[i]\n        left = right = i\n        while left >= 0 and right < n and s[left] == s[right]:\n            ans = max(ans, right - left + 1)\n            left -= 1\n            right += 1\n\n        # 情况二：偶数长度回文，中心在 s[i] 和 s[i+1] 之间\n        left, right = i, i + 1\n        while left >= 0 and right < n and s[left] == s[right]:\n            ans = max(ans, right - left + 1)\n            left -= 1\n            right += 1\n\n    return ans\n\n\nif __name__ == \"__main__\":\n    for line in sys.stdin:\n        s = line.strip()\n        if s:\n            print(longest_palindrome(s))","method":"longest_palindrome","paramNames":["s"],"args":["\"cdabbacc\""],"expected":"4","result":4,"events":[{"line":6,"locals":{"s":"cdabbacc"},"depth":1},{"line":7,"locals":{"s":"cdabbacc","n":8},"depth":1},{"line":10,"locals":{"s":"cdabbacc","n":8},"depth":1},{"line":12,"locals":{"s":"cdabbacc","n":8,"ans":1},"depth":1},{"line":14,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":0},"depth":1},{"line":15,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":0,"left":0,"right":0},"depth":1},{"line":16,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":0,"left":0,"right":0},"depth":1},{"line":17,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":0,"left":0,"right":0},"depth":1},{"line":18,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":0,"left":-1,"right":0},"depth":1},{"line":15,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":0,"left":-1,"right":1},"depth":1},{"line":21,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":0,"left":-1,"right":1},"depth":1},{"line":22,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":0,"left":0,"right":1},"depth":1},{"line":12,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":0,"left":0,"right":1},"depth":1},{"line":14,"locals":{"s":"cdabbacc","n":8,"ans":1,"i":1,"left":0,"right":1},"dep