{"docKey":"HJ98.喜欢切数组的红","code":"import sys\n\n\nclass Fenwick:\n    # 树状数组：维护\"每个 pos 值出现了几次\"，支持单点加与前缀计数\n    def __init__(self, n):\n        self.n = n\n        # 多开两格：内部下标统一 +1 后，最高会用到 n + 1\n        self.bit = [0] * (n + 2)\n\n    def add(self, idx, val):\n        # 外部用 0 起下标，树状数组内部要求 1 起，所以先整体 +1\n        idx += 1\n        # 单点加后沿 idx & -idx 往上爬，把影响带给所有覆盖它的区间\n        while idx <= self.n + 1:\n            self.bit[idx] += val\n            idx += idx & -idx\n\n    def query(self, idx):\n        # 求\"pos <= idx 的个数\"，同样先换成 1 起下标\n        idx += 1\n        s = 0\n        # 每次剥掉最低位的 1 向前收缩，恰好覆盖 [1, idx] 这段前缀\n        while idx > 0:\n            s += self.bit[idx]\n            idx -= idx & -idx\n        return s\n\n\ndef solve():\n    data = sys.stdin.buffer.read().split()\n    n = int(data[0])\n    # 只取前 n 个数，换行与多余空白已被 split 吃掉\n    a = list(map(int, data[1:1 + n]))\n\n    total = sum(a)\n    # 三段和相等，总和必须被 3 整除，否则一种方案都没有\n    if total % 3 != 0:\n        print(0)\n        return\n    m = total // 3\n\n    pre = [0] * (n + 1)\n    pos = [0] * (n + 1)\n    # pre[i] 是前 i 个元素之和，pos[i] 是前 i 个元素里正数的个数\n    for i in range(1, n + 1):\n        pre[i] = pre[i - 1] + a[i - 1]\n        pos[i] = pos[i - 1] + (1 if a[i - 1] > 0 else 0)\n\n    # 整个数组没有正数，三段不可能都含正数，直接无解\n    if pos[n] == 0:\n        print(0)\n        return\n\n    bit = Fenwick(n + 1)\n    ans = 0\n    # 只扫到 n-1：第三段必须非空，所以第二刀 j 最远只能到 n-1\n    for p in range(1, n):\n        # 先按\"第二刀\"的身份查询：此刻树里只有 i < p 的候选，天然满足 i < j\n        if pre[p] == 2 * m and pos[n] - pos[p] > 0:\n            # 查 pos[i] < pos[p]，这个严格小于保证中间段也含正数\n            ans += bit.query(pos[p] - 1)\n        # 再把自己当成\"第一刀\"候选加入；放在查询之后，才不会把 i == j 算进去\n        if pre[p] == m and pos[p] > 0:\n            bit.add(pos[p], 1)\n    print(ans)\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"3\n3 3 3","expected":"1","result":null,"events":[{"line":31,"locals":{},"depth":1},{"line":32,"locals":{"data":["3","3","3","3"]},"depth":1},{"line":34,"locals":{"data":["3","3","3","3"],"n":3},"depth":1},{"line":36,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3]},"depth":1},{"line":38,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9},"depth":1},{"line":41,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9},"depth":1},{"line":43,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3},"depth":1},{"line":44,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,0,0,0]},"depth":1},{"line":46,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,0,0,0],"pos":[0,0,0,0]},"depth":1},{"line":47,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,0,0,0],"pos":[0,0,0,0],"i":1},"depth":1},{"line":48,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,3,0,0],"pos":[0,0,0,0],"i":1},"depth":1},{"line":46,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,3,0,0],"pos":[0,1,0,0],"i":1},"depth":1},{"line":47,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,3,0,0],"pos":[0,1,0,0],"i":2},"depth":1},{"line":48,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,3,6,0],"pos":[0,1,0,0],"i":2},"depth":1},{"line":46,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,3,6,0],"pos":[0,1,2,0],"i":2},"depth":1},{"line":47,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,3,6,0],"pos":[0,1,2,0],"i":3},"depth":1},{"line":48,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,3,6,9],"pos":[0,1,2,0],"i":3},"depth":1},{"line":46,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,3,6,9],"pos":[0,1,2,3],"i":3},"depth":1},{"line":51,"locals":{"data":["3","3","3","3"],"n":3,"a":[3,3,3],"total":9,"m":3,"pre":[0,3,6,9],"pos":[0,1,2,3],"i":3},"depth":1},{"line":55,"locals":{"data":["3","3","3","3"]