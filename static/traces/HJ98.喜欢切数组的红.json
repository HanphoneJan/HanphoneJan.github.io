{"docKey":"HJ98.喜欢切数组的红","code":"import sys\n\n\nclass Fenwick:\n    def __init__(self, n):\n        self.n = n\n        self.bit = [0] * (n + 2)\n\n    def add(self, idx, val):\n        idx += 1\n        while idx <= self.n + 1:\n            self.bit[idx] += val\n            idx += idx & -idx\n\n    def query(self, idx):\n        idx += 1\n        s = 0\n        while idx > 0:\n            s += self.bit[idx]\n            idx -= idx & -idx\n        return s\n\n\ndef solve():\n    data = sys.stdin.buffer.read().split()\n    n = int(data[0])\n    a = list(map(int, data[1:1 + n]))\n\n    total = sum(a)\n    if total % 3 != 0:\n        print(0)\n        return\n    m = total // 3\n\n    pre = [0] * (n + 1)\n    pos = [0] * (n + 1)\n    for i in range(1, n + 1):\n        pre[i] = pre[i - 1] + a[i - 1]\n        pos[i] = pos[i - 1] + (1 if a[i - 1] > 0 else 0)\n\n    if pos[n] == 0:\n        print(0)\n        return\n\n    bit = Fenwick(n + 1)\n    ans = 0\n    for p in range(1, n):\n        if pre[p] == 2 * m and pos[n] - pos[p] > 0:\n            ans += bit.query(pos[p] - 1)\n        if pre[p] == m and pos[p] > 0:\n            bit.add(pos[p], 1)\n    print(ans)\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"3\n3 3 3","expected":"1","result":null,"events":[{"line":25,"locals":{},"depth":1},{"line":26,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>"]},"depth":1},{"line":27,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>"],"n":3},"depth":1},{"line":29,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>"],"n":3,"a":[3,3,3]},"depth":1},{"line":30,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>"],"n":3,"a":[3,3,3],"total":9},"depth":1},{"line":33,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>"],"n":3,"a":[3,3,3],"total":9},"depth":1},{"line":35,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>"],"n":3,"a":[3,3,3],"total":9,"m":3},"depth":1},{"line":36,"locals":{"data":["<bytes>