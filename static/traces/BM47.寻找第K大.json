{"docKey":"BM47.寻找第K大","code":"from typing import List\n\n\nclass Solution:\n    def findKth(self, a: List[int], n: int, K: int) -> int:\n        \"\"\"原地快速选择，返回升序第 n-K 个元素（即第 K 大）\"\"\"\n        target = n - K              # 第 K 大 == 升序里下标 n-K 的元素\n        lo, hi = 0, n - 1\n        while True:\n            pivot = a[(lo + hi) // 2]\n            lt, i, gt = lo, lo, hi   # 三路划分：<pivot 放左边，>pivot 放右边\n            while i <= gt:\n                if a[i] < pivot:\n                    a[lt], a[i] = a[i], a[lt]\n                    lt += 1\n                    i += 1\n                elif a[i] > pivot:\n                    a[gt], a[i] = a[i], a[gt]\n                    gt -= 1\n                else:\n                    i += 1\n            if target < lt:\n                hi = lt - 1\n            elif target > gt:\n                lo = gt + 1\n            else:\n                return pivot","method":"findKth","paramNames":["a","n","K"],"args":["[10,10,9,9,8,7,5,6,4,3,4,2]","12","3"],"expected":"9","result":9,"events":[{"line":7,"locals":{"a":[10,10,9,9,8,7,5,6,4,3,4,2],"n":12,"K":3},"depth":1},{"line":8,"locals":{"a":[10,10,9,9,8,7,5,6,4,3,4,2],"n":12,"K":3,"target":9},"depth":1},{"line":9,"locals":{"a":[10,10,9,9,8,7,5,6,4,3,4,2],"n":12,"K":3,"target":9,"lo":0,"hi":11},"depth":1},{"line":10,"locals":{"a":[10,10,9,9,8,7,5,6,4,3,4,2],"n":12,"K":3,"target":9,"lo":0,"hi":11},"depth":1},{"line":11,"locals":{"a":[10,10,9,9,8,7,5,6,4,3,4,2],"n":12,"K":3,"target":9,"lo":0,"hi":11,"pivot":7},"depth":1},{"line":12,"locals":{"a":[10,10,9,9,8,7,5,6,4,3,4,2],"n":12,"K":3,"target":9,"lo":0,"hi":11,"pivot":7,"lt":0,"i":0,"gt":11},"depth":1},{"line":13,"locals":{"a":[10,10,9,9,8,7,5,6,4,3,4,2],"n":12,"K":3,"target":9,"lo":0,"hi":11,"pivot":7,"lt":0,"i":0,"gt":11},"depth":1},{"line":17,"locals":{"a":[10,10,9,9,8,7,5,6,4,3,4,2],"n":12,"K":3,"target":9,"lo":0,"hi":11,"pivot":7,"lt":0,"i":0,"gt":11},"depth":1},{"line":18,"locals":{"a":[10,10,9,9,8,7,5,6,4,3,4,2],"n":12,"K":3,"target":9,"l