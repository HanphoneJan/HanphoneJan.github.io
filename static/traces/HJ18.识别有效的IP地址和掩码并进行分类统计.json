{"docKey":"HJ18.识别有效的IP地址和掩码并进行分类统计","code":"import sys\n\n\ndef valid_ip(ip: str) -> bool:\n    \"\"\"判断 IP 是否合法（四段数字，每段 0~255）\"\"\"\n    parts = ip.split('.')\n    if len(parts) != 4:\n        return False\n    for p in parts:\n        if not p.isdigit() or not (0 <= int(p) <= 255):\n            return False\n    return True\n\n\ndef valid_mask(mask: str) -> bool:\n    \"\"\"判断掩码是否合法：32 位二进制为连续 1 后连续 0，且不全 0 不全 1\"\"\"\n    parts = mask.split('.')\n    if len(parts) != 4:\n        return False\n    bits = ''\n    for p in parts:\n        if not p.isdigit() or not (0 <= int(p) <= 255):\n            return False\n        bits += format(int(p), '08b')\n    if '0' not in bits or '1' not in bits:   # 全 0 或全 1 非法\n        return False\n    return '01' not in bits                  # 一旦出现 0 不能再出现 1\n\n\ndef classify(a: int) -> int:\n    \"\"\"按首段返回类别：0:A 1:B 2:C 3:D 4:E，返回 -1 表示不落入五类\"\"\"\n    if 1 <= a <= 126:\n        return 0\n    if 128 <= a <= 191:\n        return 1\n    if 192 <= a <= 223:\n        return 2\n    if 224 <= a <= 239:\n        return 3\n    if 240 <= a <= 255:\n        return 4\n    return -1\n\n\ndef solve() -> None:\n    \"\"\"主求解函数\"\"\"\n    counts = [0, 0, 0, 0, 0, 0, 0]   # A B C D E 错误 私有\n\n    for line in sys.stdin:\n        line = line.strip()\n        if not line:\n            continue\n        ip, mask = line.split('~')\n\n        # 特殊 IP（首段 0 或 127）：优先级最高，整行跳过\n        first = ip.split('.')[0]\n        if first in ('0', '127'):\n            continue\n\n        # IP 或掩码非法 → 错误\n        if not valid_ip(ip) or not valid_mask(mask):\n            counts[5] += 1\n            continue\n\n        # 分类\n        parts = ip.split('.')\n        a = int(parts[0])\n        c = classify(a)\n        if c != -1:\n            counts[c] += 1\n\n        # 私有地址\n        if parts[0] == '10':\n            counts[6] += 1\n        elif parts[0] == '172' and 16 <= int(parts[1]) <= 31:\n            counts[6] += 1\n        elif parts[0] == '192' and parts[1] == '168':\n            counts[6] += 1\n\n    print(' '.join(map(str, counts)))\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"10.70.44.68~1.1.1.5\n1.0.0.1~255.0.0.0\n192.168.0.2~255.255.255.0\n19..0.~255.255.255.0","expected":"1 0 1 0 0 2 1","result":null,"events":[{"line":47,"locals":{},"depth":1},{"line":49,"locals":{"counts":[0,0,0,0,0,0,0]},"depth":1},{"line":50,"locals":{"counts":[0,0,0,0,0,0,0],"line":"10.70.44.68~1.1.1.5\n"},"depth":1},{"line":51,"locals":{"counts":[0,0,0,0,0,0,0],"line":"10.70.44.68~1.1.1.5"},"depth":1},{"line":53,"locals":{"counts":[0,0,0,0,0,0,0],"line":"10.70.44.68~1.1.1.5"},"depth":1},{"line":56,"locals":{"counts":[0,0,0,0,0,0,0],"line":"10.70.44.68~1.1.1.5","ip":"10.70.44.68","mask":"1.1.1.5"},"depth":1},{"line":57,"locals":{"counts":[0,0,0,0,0,0,0],"line":"10.70.44.68~1.1.1.5","ip":"10.70.44.68","mask":"1.1.1.5","first":"10"},"depth":1},{"line":61,"locals":{"counts":[0,0,0,0,0,0,0],"line":"10.70.44.68~1.1.1.5","ip":"10.70.44.68","mask":"1.1.1.5","first":"10"},"depth":1},{"line":6,"locals":{"ip":"10.70.44.68"},"depth":2},{"line":7,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"]},"depth":2},{"line":9,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"]},"depth":2},{"line":10,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"],"p":"10"},"depth":2},{"line":9,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"],"p":"10"},"depth":2},{"line":10,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"],"p":"70"},"depth":2},{"line":9,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"],"p":"70"},"depth":2},{"line":10,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"],"p":"44"},"depth":2},{"line":9,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"],"p":"44"},"depth":2},{"line":10,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"],"p":"68"},"depth":2},{"line":9,"locals":{"ip":"10.70.44.68","parts":["10","70","44","68"],"p":"68"},"depth":2},