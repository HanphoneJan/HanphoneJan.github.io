{"docKey":"0021_merge_two_sorted_lists","code":"from typing import Optional\n\n\nclass ListNode:\n    def __init__(self, val=0, next=None):\n        self.val = val\n        self.next = next\n\n\nclass Solution:\n    def mergeTwoLists(self, list1: Optional[ListNode], list2: Optional[ListNode]) -> Optional[ListNode]:\n        dummy = ListNode()          # 哑结点，省掉「第一个节点」的特判\n        cur = dummy\n        while list1 and list2:\n            if list1.val <= list2.val:\n                cur.next = list1\n                list1 = list1.next\n            else:\n                cur.next = list2\n                list2 = list2.next\n            cur = cur.next\n        cur.next = list1 if list1 else list2   # 剩下的那段本身有序，整段接上\n        return dummy.next","method":"mergeTwoLists","paramNames":["list1","list2"],"argKinds":["list","list"],"args":["[1,2,4]","[1,3,4]"],"expected":"[1,1,2,3,4,4]","result":[1,1,2,3,4,4],"events":[{"line":12,"locals":{"list1":{"$":"list","v":[1,2,4]},"list2":{"$":"n","i":3,"v":1}},"depth":1},{"line":6,"locals":{"val":0,"next":null},"depth":2},{"line":7,"locals":{"val":0,"next":null},"depth":2},{"line":13,"locals":{"list1":{"$":"list","v":[1,2,4]},"list2":{"$":"n","i":3,"v":1},"dummy":{"$":"n","i":3,"v":0}},"depth":1},{"line":14,"locals":{"list1":{"$":"list","v":[1,2,4]},"list2":{"$":"n","i":3,"v":1},"dummy":{"$":"n","i":3,"v":0},"cur":{"$":"n","i":3,"v":0}},"depth":1},{"line":15,"locals":{"list1":{"$":"list","v":[1,2,4]},"list2":{"$":"n","i":3,"v":1},"dummy":{"$":"n","i":3,"v":0},"cur":{"$":"n","i":3,"v":0}},"depth":1},{"line":16,"locals":{"list1":{"$":"list","v":[1,2,4]},"list2":{"$":"n","i":3,"v":1},"dummy":{"$":"n","i":3,"v":0},"cur":{"$":"n","i":3,"v":0}},"depth":1},{"line":17,"locals":{"list1":{"$":"n","i":1,"v":1},"list2":{"$":"n","i":4,"v":1},"dummy":{"$":"list","v":[0,1,2,4]},"cur":{"$":"list","v":[0,1,2,4]}},"depth":1},{"line":21,"locals":{"list1":{"$":"n","i":2,"v":2},"list2":{"$":"n","i":4,"v":1},"dummy":{"$":"list","v":[0,1,2,4]},"cur":{"$":"list"