{"docKey":"0015_3sum","code":"class Solution:\n    def threeSum(self, nums: list[int]) -> list[list[int]]:\n        n = len(nums)\n        if n < 3:\n            return []\n        nums.sort()\n        ans = []\n        for first in range(n):\n            if first > 0 and nums[first] == nums[first - 1]:\n                continue\n            if nums[first] > 0:\n                break\n            third = n - 1\n            target = -nums[first]\n            for second in range(first + 1, n):\n                if second > first + 1 and nums[second] == nums[second - 1]:\n                    continue\n                while second < third and nums[second] + nums[third] > target:\n                    third -= 1\n                if second == third:\n                    break\n                if nums[second] + nums[third] == target:\n                    ans.append([nums[first], nums[second], nums[third]])\n        return ans","method":"threeSum","paramNames":["nums"],"args":["[-1,0,1,2,-1,-4]"],"expected":"[[-1,-1,2],[-1,0,1]]","result":[[-1,-1,2],[-1,0,1]],"events":[{"line":3,"locals":{"nums":[-1,0,1,2,-1,-4]},"depth":1},{"line":4,"locals":{"nums":[-1,0,1,2,-1,-4],"n":6},"depth":1},{"line":6,"locals":{"nums":[-1,0,1,2,-1,-4],"n":6},"depth":1},{"line":7,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6},"depth":1},{"line":8,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[]},"depth":1},{"line":9,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"first":0},"depth":1},{"line":11,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"first":0},"depth":1},{"line":13,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"first":0},"depth":1},{"line":14,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"first":0,"third":5},"depth":1},{"line":15,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"first":0,"third":5,"target":4},"depth":1},{"line":16,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"first":0,"third":5,"target":4,"second":1},"depth":1},{"line":18,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":