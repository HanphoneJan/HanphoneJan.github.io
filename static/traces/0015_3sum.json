{"docKey":"0015_3sum","code":"from typing import List\n\n\nclass Solution:\n    def threeSum(self, nums: List[int]) -> List[List[int]]:\n        nums.sort()\n        n = len(nums)\n        ans = []\n\n        for i in range(n - 2):\n            if i > 0 and nums[i] == nums[i - 1]:\n                continue                  # 第一个数去重\n            if nums[i] > 0:\n                break                     # 最小的数都大于 0，后面不可能凑出 0\n            l, r = i + 1, n - 1\n            while l < r:\n                s = nums[i] + nums[l] + nums[r]\n                if s == 0:\n                    ans.append([nums[i], nums[l], nums[r]])\n                    l += 1\n                    r -= 1\n                    while l < r and nums[l] == nums[l - 1]:\n                        l += 1            # 左指针去重\n                    while l < r and nums[r] == nums[r + 1]:\n                        r -= 1            # 右指针去重\n                elif s < 0:\n                    l += 1\n                else:\n                    r -= 1\n\n        return ans","method":"threeSum","paramNames":["nums"],"args":["[-1,0,1,2,-1,-4]"],"expected":"[[-1,-1,2],[-1,0,1]]","result":[[-1,-1,2],[-1,0,1]],"events":[{"line":6,"locals":{"nums":[-1,0,1,2,-1,-4]},"depth":1},{"line":7,"locals":{"nums":[-4,-1,-1,0,1,2]},"depth":1},{"line":8,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6},"depth":1},{"line":10,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[]},"depth":1},{"line":11,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"i":0},"depth":1},{"line":13,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"i":0},"depth":1},{"line":15,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"i":0},"depth":1},{"line":16,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"i":0,"l":1,"r":5},"depth":1},{"line":17,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"i":0,"l":1,"r":5},"depth":1},{"line":18,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"i":0,"l":1,"r":5,"s":-3},"depth":1},{"line":26,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"i"