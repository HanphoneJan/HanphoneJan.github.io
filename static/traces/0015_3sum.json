{"docKey":"0015_3sum","code":"class Solution:\n    def threeSum(self, nums: list[int]) -> list[list[int]]:\n        n = len(nums)\n        # 少于三个数时不存在三元组\n        if n < 3:\n            return []\n        # 升序排序：既让去重只需看相邻元素，也让双指针的移动方向有意义\n        nums.sort()\n        ans = []\n        # first 是三元组里最小的那个数的下标\n        for first in range(n):\n            # 同一个数值只当一次起点，避免重复三元组\n            if first > 0 and nums[first] == nums[first - 1]:\n                continue\n            # 最小值已经大于 0，三数之和不可能为 0；数组有序，可以整体结束\n            if nums[first] > 0:\n                break\n            # third 每个 first 只重置一次：second 增大时 target - nums[second] 变小，右指针无需回退\n            third = n - 1\n            target = -nums[first]\n            # 在 first 右侧找两个数，使它们的和等于 target\n            for second in range(first + 1, n):\n                # 第二个数也要去重；first + 1 是它的首个合法位置，不能跳过\n                if second > first + 1 and nums[second] == nums[second - 1]:\n                    continue\n                # 和太大就让右指针左移，直到两数之和不超过 target\n                while second < third and nums[second] + nums[third] > target:\n                    third -= 1\n                # 两指针相遇说明这一段已经没有可用的第二个数，内层结束\n                if second == third:\n                    break\n                # 正好凑成 0，记录答案\n                if nums[second] + nums[third] == target:\n                    ans.append([nums[first], nums[second], nums[third]])\n        return ans","method":"threeSum","paramNames":["nums"],"args":["[-1,0,1,2,-1,-4]"],"expected":"[[-1,-1,2],[-1,0,1]]","result":[[-1,-1,2],[-1,0,1]],"events":[{"line":3,"locals":{"nums":[-1,0,1,2,-1,-4]},"depth":1},{"line":5,"locals":{"nums":[-1,0,1,2,-1,-4],"n":6},"depth":1},{"line":8,"locals":{"nums":[-1,0,1,2,-1,-4],"n":6},"depth":1},{"line":9,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6},"depth":1},{"line":11,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[]},"depth":1},{"line":13,"locals":{"nums":[-4,-1,-1,0,1,2],"n":6,"ans":[],"first":0},"depth":1},{"line":16,"locals":{"nums":[-4,-1,-1,0,1,2],