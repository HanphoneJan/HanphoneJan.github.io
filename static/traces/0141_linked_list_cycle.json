{"docKey":"0141_linked_list_cycle","code":"from typing import Optional\n\nclass ListNode:\n    def __init__(self, x):\n        self.val = x\n        self.next = None\n\nclass Solution:\n    \"\"\"\n    141. 环形链表 - 快慢指针（Floyd 判圈算法）\n\n    核心思想：\n    快指针每次走 2 步，慢指针每次走 1 步。如果链表有环，两者一定会在环内相遇。\n\n    时间复杂度：O(n)\n    空间复杂度：O(1)\n    \"\"\"\n\n    def hasCycle(self, head: Optional[ListNode]) -> bool:\n        slow, fast = head, head\n\n        while fast and fast.next:\n            slow = slow.next\n            fast = fast.next.next\n            if slow == fast:\n                return True\n\n        return False","method":"hasCycle","paramNames":["head"],"argKinds":["list"],"args":["[3,2,0,-4]"],"expected":"true","result":true,"events":[{"line":20,"locals":{"head":{"$":"list","v":[3,2,0,-4]}},"depth":1},{"line":22,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"list","v":[3,2,0,-4]},"fast":{"$":"list","v":[3,2,0,-4]}},"depth":1},{"line":23,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"list","v":[3,2,0,-4]},"fast":{"$":"list","v":[3,2,0,-4]}},"depth":1},{"line":24,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":1,"v":2},"fast":{"$":"list","v":[3,2,0,-4]}},"depth":1},{"line":25,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":1,"v":2},"fast":{"$":"n","i":2,"v":0}},"depth":1},{"line":22,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":1,"v":2},"fast":{"$":"n","i":2,"v":0}},"depth":1},{"line":23,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":1,"v":2},"fast":{"$":"n","i":2,"v":0}},"depth":1},{"line":24,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":2,"v":0},"fast":{"$":"n","i":2,"v":0}},"depth":1},{"line":25,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":2,"v":0},"fast":{"$":"n","i":1,"v":2}},"depth":1},{"line":22,"locals":{"head":{"$":"list","v":[3,2,0,-4]},"slow":{"$":"n","i":2,"v":0},"fast":{"$":"n","i":1,"v":2}},"depth":1},{"line":23,"locals":{"head