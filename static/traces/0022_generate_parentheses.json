{"docKey":"0022_generate_parentheses","code":"from typing import List\n\n\nclass Solution:\n    def generateParenthesis(self, n: int) -> List[str]:\n        ans = []\n        path = []\n\n        def dfs(left: int, right: int) -> None:\n            # right 到 n 时 left 必然也到 n，2n 个位置刚好填满\n            if right == n:\n                ans.append(''.join(path))\n                return\n            # 还能放左括号：总数没超过 n\n            if left < n:\n                path.append('(')\n                dfs(left + 1, right)\n                path.pop()\n            # 还能放右括号：前缀里右括号还没追上左括号\n            if right < left:\n                path.append(')')\n                dfs(left, right + 1)\n                path.pop()\n\n        dfs(0, 0)\n        return ans","method":"generateParenthesis","paramNames":["n"],"args":["3"],"expected":"[\"((()))\",\"(()())\",\"(())()\",\"()(())\",\"()()()\"]","result":["((()))","(()())","(())()","()(())","()()()"],"events":[{"line":6,"locals":{"n":3},"depth":1},{"line":7,"locals":{"n":3,"ans":[]},"depth":1},{"line":9,"locals":{"n":3,"ans":[],"path":[]},"depth":1},{"line":25,"locals":{"n":3,"ans":[],"dfs":"<function>","path":[]},"depth":1},{"line":11,"locals":{"left":0,"right":0,"ans":[],"dfs":"<function>","n":3,"path":[]},"depth":2},{"line":15,"locals":{"left":0,"right":0,"ans":[],"dfs":"<function>","n":3,"path":[]},"depth":2},{"line":16,"locals":{"left":0,"right":0,"ans":[],"dfs":"<function>","n":3,"path":[]},"depth":2},{"line":17,"locals":{"left":0,"right":0,"ans":[],"dfs":"<function>","n":3,"path":["("]},"depth":2},{"line":11,"locals":{"left":1,"right":0,"ans":[],"dfs":"<function>","n":3,"path":["("]},"depth":3},{"line":15,"locals":{"left":1,"right":0,"ans":[],"dfs":"<function>","n":3,"path":["("]},"depth":3},{"line":16,"locals":{"left":1,"right":0,"ans":[],"dfs":"<function>","n":3,"path":["("]},"depth":3},{"line":17,"locals":{"left":1,"right":0,"ans":[],"dfs":"<function>","n":3,"path":["(","("]},"depth":3},{"line":11,"locals":{"left":2,"right":0,"ans":[],"