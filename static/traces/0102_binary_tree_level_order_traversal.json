{"docKey":"0102_binary_tree_level_order_traversal","code":"from typing import List, Optional\nfrom collections import deque\n\nclass TreeNode:\n    def __init__(self, val=0, left=None, right=None):\n        self.val = val\n        self.left = left\n        self.right = right\n\nclass Solution:\n    \"\"\"\n    二叉树的层序遍历 - BFS\n\n    核心思想：\n    使用队列（BFS）按层遍历二叉树。\n\n    时间复杂度：O(n)\n    空间复杂度：O(n)\n    \"\"\"\n\n    def levelOrder(self, root: Optional[TreeNode]) -> List[List[int]]:\n        if not root:\n            return []\n\n        res = []\n        cur = deque([root])\n\n        while cur:\n            value = []\n            for _ in range(len(cur)):\n                node = cur.popleft()\n                value.append(node.val)\n                if node.left:\n                    cur.append(node.left)\n                if node.right:\n                    cur.append(node.right)\n            res.append(value)\n\n        return res","method":"levelOrder","paramNames":["root"],"argKinds":["tree"],"args":["[3,9,20,None,None,15,7]"],"expected":"[[3],[9,20],[15,7]]","result":[[3],[9,20],[15,7]],"events":[{"line":22,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]}},"depth":1},{"line":25,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]}},"depth":1},{"line":26,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]},"res":[]},"depth":1},{"line":28,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]},"res":[],"cur":"<deque>"},"depth":1},{"line":29,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]},"res":[],"cur":"<deque>"},"depth":1},{"line":30,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]},"res":[],"cur":"<deque>","value":[]},"depth":1},{"line":31,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]},"res":[],"cur":"<deque>","value":[],"_":0},"depth":1},{"line":32,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]},"res":[],"cur":"<deque>","value":[],"_":0,"node":{"$":"tree","v":[3,9,20,15,7,null,null]}},"depth":1},{"line":33