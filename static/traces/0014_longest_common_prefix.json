{"docKey":"0014_longest_common_prefix","code":"from typing import List\n\nclass Solution:\n    def longestCommonPrefix(self, strs: List[str]) -> str:\n        # 空数组没有公共前缀，同时也避免下面取 strs[0] 越界\n        if not strs:\n            return \"\"\n        # 外层按「列」扫描：i 是字符下标，char 是第一个字符串在该列的字符\n        for i, char in enumerate(strs[0]):\n            # 内层把这一列拿去和其余每个字符串比\n            for s in strs[1:]:\n                # 先判 i 是否超出该串长度（更短的串会先到头），再比字符；\n                # 用 or 的短路特性保证不会先访问 s[i]\n                if i >= len(s) or s[i] != char:\n                    # 第一处不一致出现，公共前缀就定格在前 i 个字符\n                    return strs[0][:i]\n        # 基准串整体都被所有串共享，它自己就是最长公共前缀\n        return strs[0]","method":"longestCommonPrefix","paramNames":["strs"],"args":["[\"flower\",\"flow\",\"flight\"]"],"expected":"\"fl\"","result":"fl","events":[{"line":6,"locals":{"strs":["flower","flow","flight"]},"depth":1},{"line":9,"locals":{"strs":["flower","flow","flight"]},"depth":1},{"line":11,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f"},"depth":1},{"line":14,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flow"},"depth":1},{"line":11,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flow"},"depth":1},{"line":14,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flight"},"depth":1},{"line":11,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flight"},"depth":1},{"line":9,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flight"},"depth":1},{"line":11,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flight"},"depth":1},{"line":14,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flow"},"depth":1},{"line":11,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flow"},"depth":1},{"line":14,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flight"},"depth":1},{"line":11,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flight"},"depth":1},{"line":9,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flight"},"depth":1},{"line":11,"locals":{"strs":["flower","flow","flight"],"i":2,"char":"o","s":"flight"},"depth":1},{"line":14,"locals":{"strs":["flower","flow","flight"],"i":2,"char":"o","s":"flow"},"depth":1},{"line":11,"locals":{"strs":["flower","flow","flight"],"i":2,"char":"o","s":"flow"},"depth":1},{"line":14,"locals":{"strs":["flower","flow","flight"],"i":2,"char":"o","s":"flight"},"depth":1},{"line":16,"locals":{"strs":["flower","flow","flight"],"i":2,"char":"o","s":"flight"},"depth":1}]}