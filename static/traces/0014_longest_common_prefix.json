{"docKey":"0014_longest_common_prefix","code":"from typing import List\n\nclass Solution:\n    def longestCommonPrefix(self, strs: List[str]) -> str:\n        if not strs:\n            return \"\"\n        for i, char in enumerate(strs[0]):\n            for s in strs[1:]:\n                if i >= len(s) or s[i] != char:\n                    return strs[0][:i]\n        return strs[0]","method":"longestCommonPrefix","paramNames":["strs"],"args":["[\"flower\",\"flow\",\"flight\"]"],"expected":"\"fl\"","result":"fl","events":[{"line":5,"locals":{"strs":["flower","flow","flight"]},"depth":1},{"line":7,"locals":{"strs":["flower","flow","flight"]},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f"},"depth":1},{"line":9,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flow"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flow"},"depth":1},{"line":9,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flight"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flight"},"depth":1},{"line":7,"locals":{"strs":["flower","flow","flight"],"i":0,"char":"f","s":"flight"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flight"},"depth":1},{"line":9,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flow"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flow"},"depth":1},{"line":9,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flight"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flight"},"depth":1},{"line":7,"locals":{"strs":["flower","flow","flight"],"i":1,"char":"l","s":"flight"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"i":2,"char":"o","s":"flight"},"depth":1},{"line":9,"locals":{"strs":["flower","flow","flight"],"i":2,"char":"o","s":"flow"},"depth":1},{"line":8,"locals":