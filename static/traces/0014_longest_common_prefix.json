{"docKey":"0014_longest_common_prefix","code":"from typing import List\n\n\nclass Solution:\n    def longestCommonPrefix(self, strs: List[str]) -> str:\n        first = strs[0]\n        for i, c in enumerate(first):\n            for s in strs:\n                # 先判越界再比字符：or 的短路保证不会取到 s[i] 之外\n                if i == len(s) or s[i] != c:\n                    return first[:i]\n        return first","method":"longestCommonPrefix","paramNames":["strs"],"args":["[\"flower\",\"flow\",\"flight\"]"],"expected":"\"fl\"","result":"fl","events":[{"line":6,"locals":{"strs":["flower","flow","flight"]},"depth":1},{"line":7,"locals":{"strs":["flower","flow","flight"],"first":"flower"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":0,"c":"f"},"depth":1},{"line":10,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":0,"c":"f","s":"flower"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":0,"c":"f","s":"flower"},"depth":1},{"line":10,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":0,"c":"f","s":"flow"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":0,"c":"f","s":"flow"},"depth":1},{"line":10,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":0,"c":"f","s":"flight"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":0,"c":"f","s":"flight"},"depth":1},{"line":7,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":0,"c":"f","s":"flight"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":1,"c":"l","s":"flight"},"depth":1},{"line":10,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":1,"c":"l","s":"flower"},"depth":1},{"line":8,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":1,"c":"l","s":"flower"},"depth":1},{"line":10,"locals":{"strs":["flower","flow","flight"],"first":"flower","i":1,"c":"l","s":"flow"},"depth":1},{"li