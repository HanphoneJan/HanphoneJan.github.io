{"docKey":"HJ20.密码验证合格程序","code":"import sys\n\n\ndef is_valid(pwd: str) -> bool:\n    \"\"\"判断单个密码是否合格\"\"\"\n    # 条件1：长度超过 8 位\n    if len(pwd) <= 8:\n        return False\n\n    # 条件2：四类字符至少占三类\n    kinds = 0\n    if any(c.islower() for c in pwd):\n        kinds += 1\n    if any(c.isupper() for c in pwd):\n        kinds += 1\n    if any(c.isdigit() for c in pwd):\n        kinds += 1\n    if any(not c.isalnum() for c in pwd):\n        kinds += 1\n    if kinds < 3:\n        return False\n\n    # 条件3：任意长度 >= 2 的子串不能重复。\n    # 只需检查所有长度为 3 的子串是否有重复即可。\n    seen = set()\n    for i in range(len(pwd) - 2):\n        sub = pwd[i:i + 3]\n        if sub in seen:\n            return False\n        seen.add(sub)\n\n    return True\n\n\ndef solve() -> None:\n    \"\"\"主求解函数\"\"\"\n    for line in sys.stdin:\n        pwd = line.strip()\n        print(\"OK\" if is_valid(pwd) else \"NG\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"021Abc9000\n021Abc9Abc1\n021ABC9000\n021$bc9000","expected":"OK\nNG\nNG\nOK","result":null,"events":[{"line":37,"locals":{},"depth":1},{"line":38,"locals":{"line":"021Abc9000\n"},"depth":1},{"line":39,"locals":{"line":"021Abc9000\n","pwd":"021Abc9000"},"depth":1},{"line":7,"locals":{"pwd":"021Abc9000"},"depth":2},{"line":11,"locals":{"pwd":"021Abc9000"},"depth":2},{"line":12,"locals":{"pwd":"021Abc9000","kinds":0},"depth":2},{"line":12,"locals":{".0":"<str_ascii_iterator>"},"depth":3},{"line":12,"locals":{"pwd":"021Abc9000","kinds":0},"depth":2},{"line":12,"locals":{".0":"<str_ascii_iterator>","c":"0"},"depth":3},{"line":12,"locals":{"pwd":"021Abc9000","kinds":0},"depth":2},{"line":12,"locals":{".0":"<str_ascii_iterator>","c":"2"},"depth":3},{"line":12,"locals":{"pwd":"021Abc9000","kinds":0},"depth":2},{"line":12,"locals":{".0":"<str_ascii_iterator>","c":"1"},"depth":3},{"line":12,"locals":{"pwd":"021Abc9000","kinds":0},"depth":2},{"line":12,"locals":{".0":"<str_ascii_iterator>","c":"A"},"depth":3