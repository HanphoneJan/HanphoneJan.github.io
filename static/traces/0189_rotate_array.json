{"docKey":"0189_rotate_array","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    轮转数组 - 数组翻转法\n\n    核心思路：\n    通过三次翻转实现数组轮转：\n    1. 先翻转整个数组 [0, n-1]\n    2. 再翻转前 k 个元素 [0, k-1]\n    3. 最后翻转剩余元素 [k, n-1]\n\n    时间复杂度：O(n)\n    空间复杂度：O(1)\n    \"\"\"\n\n    def rotate(self, nums: List[int], k: int) -> None:\n        \"\"\"Do not return anything, modify nums in-place instead.\"\"\"\n        n = len(nums)\n        k %= n  # 处理 k > n 的情况\n\n        # 三次翻转实现轮转效果\n        self.reverse(nums, 0, n - 1)   # 第一步：翻转整个数组\n        self.reverse(nums, 0, k - 1)   # 第二步：翻转前 k 个元素\n        self.reverse(nums, k, n - 1)   # 第三步：翻转剩余元素\n\n    def reverse(self, nums: List[int], left: int, right: int) -> None:\n        \"\"\"辅助函数：反转数组区间 [left, right]\"\"\"\n        while left < right:\n            nums[left], nums[right] = nums[right], nums[left]\n            left += 1\n            right -= 1","method":"rotate","paramNames":["nums","k"],"args":["[1,2,3,4,5,6,7]","3"],"expected":"[5,6,7,1,2,3,4]","result":null,"events":[{"line":19,"locals":{"nums":[1,2,3,4,5,6,7],"k":3},"depth":1},{"line":20,"locals":{"nums":[1,2,3,4,5,6,7],"k":3,"n":7},"depth":1},{"line":23,"locals":{"nums":[1,2,3,4,5,6,7],"k":3,"n":7},"depth":1},{"line":29,"locals":{"nums":[1,2,3,4,5,6,7],"left":0,"right":6},"depth":2},{"line":30,"locals":{"nums":[1,2,3,4,5,6,7],"left":0,"right":6},"depth":2},{"line":31,"locals":{"nums":[7,2,3,4,5,6,1],"left":0,"right":6},"depth":2},{"line":32,"locals":{"nums":[7,2,3,4,5,6,1],"left":1,"right":6},"depth":2},{"line":29,"locals":{"nums":[7,2,3,4,5,6,1],"left":1,"right":5},"depth":2},{"line":30,"locals":{"nums":[7,2,3,4,5,6,1],"left":1,"right":5},"depth":2},{"line":31,"locals":{"nums":[7,6,3,4,5,2,1],"left":1,"right":5},"depth":2},{"line":32,"locals":{"nums":[7,6,3,4,5,2,1],"left":2,"right":5},"depth":2},{"line":29,"locals":{"nums":[7,6,3,4,5,2,1],"left":2,"right":4},"depth":2},{"line":30,"locals":{"nums":[7,6,3,4,5,2,1],"left":2,"right":4},"depth":2},{"line":31,"locals":{"nums":[7,6,5,4,3,2,1],"left":2,"right":4},"depth":2},{"line":32,"locals":{"nums":[7,6,5,4,3,2,1],"left":3,"right":4},"depth":2},{"line":29,"locals":{"nums":[7,6,5,4,3,2,1],"left":3,"right":3},"depth":2},{"line":24,"locals":{"nums":[7,6,5,4,3,2,1],"k":3,"n":7},"depth":1},{"line":29,"locals":{"nums":[7,6,5,4,3,2,1],"left":0,"right":2},"depth":2},{"line":30,"locals":{"nums":[7,6,5,4,3,2,1],"left":0,"right":2},"depth":2},{"line":31,"locals":{"nums":[5,6,7,4,3,2,1],"left":0,"right":2},"depth":2},{"line":32,"locals":{"nums":[5,6,7,4,3,2,1],"left":1,"right":2},"depth":2},{"line":29,"locals":{"nums":[5,6,7,4,3,2,1],"left":1,"right":1},"depth":2},{"line":25,"locals":{"nums":[5,6,7,4,3,2,1],"k":3,"n":7},"depth":1},{"line":29,"locals":{"nums":[5,6,7,4,3,2,1],"left":3,"right":6},"depth":2},{"line":30,"locals":{"nums":[5,6,7,4,3,2,1],"left":3,"right":6},"depth":2},{"line":31,"locals":{"nums":[5,6,7,1,3,2,4],"left":3,"right":6},"depth":2},{"line":32,"locals":{"nums":[5,6,7,1,3,2,4],"left":4,"right":6},"depth":2},{"line":29,"locals":{"nums":[5,6,7,1,3,2,4],"left":4,"right":5},"depth":2},{"line":30,"locals":{"nums":[5,6,7,1,3,2,4],"left":4,"right":5},"depth":2},{"line":31,"locals":{"nums":[5,6,7,1,2,3,4],"left":4,"right":5},"depth":2},{"line":32,"locals":{"nums":[5,6,7,1,2,3,4],"left":5,"right":5},"depth":2},{"line":29,"locals":{"nums":[5,6,7,1,2,3,4],"left":5,"right":4},"depth":2}]}