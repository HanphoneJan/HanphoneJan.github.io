{"docKey":"0238_product_of_array_except_self","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    除了自身以外数组的乘积 - 前后缀分解\n\n    核心思路：\n    answer[i] = 前缀积[i] * 后缀积[i]\n    其中前缀积[i] = nums[0] * ... * nums[i-1]\n          后缀积[i] = nums[i+1] * ... * nums[n-1]\n\n    优化：先用 answer 数组存储后缀积，再用变量维护前缀积\n\n    时间复杂度：O(n)\n    空间复杂度：O(1) - 不包括输出数组\n    \"\"\"\n\n    def productExceptSelf(self, nums: List[int]) -> List[int]:\n        n = len(nums)\n        answer = [1] * n\n\n        # 计算后缀积，存储在 answer 中\n        # answer[i] = nums[i+1] * nums[i+2] * ... * nums[n-1]\n        for i in range(n - 2, -1, -1):\n            answer[i] = answer[i + 1] * nums[i + 1]\n\n        # 计算前缀积，乘到 answer 中\n        pre = 1\n        for i in range(n):\n            answer[i] *= pre\n            pre *= nums[i]\n\n        return answer","method":"productExceptSelf","paramNames":["nums"],"args":["[-1,1,0,-3,3]"],"expected":"[0,0,9,0,0]","result":[0,0,9,0,0],"events":[{"line":19,"locals":{"nums":[-1,1,0,-3,3]},"depth":1},{"line":20,"locals":{"nums":[-1,1,0,-3,3],"n":5},"depth":1},{"line":24,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[1,1,1,1,1]},"depth":1},{"line":25,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[1,1,1,1,1],"i":3},"depth":1},{"line":24,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[1,1,1,3,1],"i":3},"depth":1},{"line":25,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[1,1,1,3,1],"i":2},"depth":1},{"line":24,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[1,1,-9,3,1],"i":2},"depth":1},{"line":25,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[1,1,-9,3,1],"i":1},"depth":1},{"line":24,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[1,0,-9,3,1],"i":1},"depth":1},{"line":25,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[1,0,-9,3,1],"i":0},"depth":1},{"line":24,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[0,0,-9,3,1],"i":0},"depth":1},{"line":28,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":[0,0,-9,3,1],"i":0},"depth":1},{"line":29,"locals":{"nums":[-1,1,0,-3,3],"n":5,"answer":