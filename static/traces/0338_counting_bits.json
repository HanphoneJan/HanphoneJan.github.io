{"docKey":"0338_counting_bits","code":"from typing import List\n\n\nclass Solution:\n    def countBits(self, n: int) -> List[int]:\n        bits = [0] * (n + 1)\n        for i in range(1, n + 1):\n            # 去掉最低位后 1 的个数不变，再把被去掉的那一位补回来\n            bits[i] = bits[i >> 1] + (i & 1)\n        return bits","method":"countBits","paramNames":["n"],"args":["5"],"expected":"[0,1,1,2,1,2]","result":[0,1,1,2,1,2],"events":[{"line":6,"locals":{"n":5},"depth":1},{"line":7,"locals":{"n":5,"bits":[0,0,0,0,0,0]},"depth":1},{"line":9,"locals":{"n":5,"bits":[0,0,0,0,0,0],"i":1},"depth":1},{"line":7,"locals":{"n":5,"bits":[0,1,0,0,0,0],"i":1},"depth":1},{"line":9,"locals":{"n":5,"bits":[0,1,0,0,0,0],"i":2},"depth":1},{"line":7,"locals":{"n":5,"bits":[0,1,1,0,0,0],"i":2},"depth":1},{"line":9,"locals":{"n":5,"bits":[0,1,1,0,0,0],"i":3},"depth":1},{"line":7,"locals":{"n":5,"bits":[0,1,1,2,0,0],"i":3},"depth":1},{"line":9,"locals":{"n":5,"bits":[0,1,1,2,0,0],"i":4},"depth":1},{"line":7,"locals":{"n":5,"bits":[0,1,1,2,1,0],"i":4},"depth":1},{"line":9,"locals":{"n":5,"bits":[0,1,1,2,1,0],"i":5},"depth":1},{"line":7,"locals":{"n":5,"bits":[0,1,1,2,1,2],"i":5},"depth":1},{"line":10,"locals":{"n":5,"bits":[0,1,1,2,1,2],"i":5},"depth":1}]}