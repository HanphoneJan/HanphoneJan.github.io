{"docKey":"0301_remove_invalid_parentheses","code":"from typing import List\n\n\nclass Solution:\n    def removeInvalidParentheses(self, s: str) -> List[str]:\n        # ① 数出最少要删几个左括号、几个右括号\n        lremove = rremove = 0\n        for ch in s:\n            if ch == '(':\n                lremove += 1\n            elif ch == ')':\n                if lremove == 0:\n                    rremove += 1\n                else:\n                    lremove -= 1\n\n        def is_valid(t: str) -> bool:\n            left = 0\n            for ch in t:\n                if ch == '(':\n                    left += 1\n                elif ch == ')':\n                    left -= 1\n                    if left < 0:      # 任意前缀右括号更多，已经非法\n                        return False\n            return left == 0\n\n        ans = []\n\n        # ② 回溯删除；cur 是当前串，start 是下一位可删的位置\n        def dfs(cur: str, start: int, lremove: int, rremove: int) -> None:\n            if lremove == 0 and rremove == 0:\n                if is_valid(cur):\n                    ans.append(cur)\n                return\n\n            for i in range(start, len(cur)):\n                # 连续相同括号只试第一个，避免同一结果被重复收集\n                if i > start and cur[i] == cur[i - 1]:\n                    continue\n                # 剩余字符不足以删完所需数量，再往后更不够\n                if lremove + rremove > len(cur) - i:\n                    break\n                if lremove > 0 and cur[i] == '(':\n                    dfs(cur[:i] + cur[i + 1:], i, lremove - 1, rremove)\n                if rremove > 0 and cur[i] == ')':\n                    dfs(cur[:i] + cur[i + 1:], i, lremove, rremove - 1)\n\n        dfs(s, 0, lremove, rremove)\n        return ans","method":"removeInvalidParentheses","paramNames":["s"],"args":["\"(a)())()\""],"expected":"[\"(a())()\",\"(a)()()\"]","result":["(a())()","(a)()()"],"events":[{"line":7,"locals":{"s":"(a)())()"},"depth":1},{"line":8,"locals":{"s":"(a)())()","lremove":0,"rremove":0},"depth":1},{"line":9,"locals":{"s":"(a)())()","lrem