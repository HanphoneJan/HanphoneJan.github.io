{"docKey":"小美的密码","code":"import sys\nfrom collections import defaultdict\n\n\ndef solve() -> None:\n    \"\"\"按长度分组去重，统计比正确密码短的个数\"\"\"\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    s = data[1]\n    words = data[2:2 + n]\n\n    by_len = defaultdict(set)\n    for w in words:\n        by_len[len(w)].add(w)\n\n    step = 0\n    mn = mx = -1\n    for length in sorted(by_len):\n        group = by_len[length]\n        if s in group:\n            mn = step + 1\n            mx = step + len(group)\n            break\n        step += len(group)\n\n    sys.stdout.write(f\"{mn} {mx}\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"4\nab\nabc\nab\nac\nac","expected":"1 2","result":null,"events":[{"line":7,"locals":{},"depth":1},{"line":8,"locals":{"data":["4","ab","abc","ab","ac","ac"]},"depth":1},{"line":10,"locals":{"data":["4","ab","abc","ab","ac","ac"]},"depth":1},{"line":11,"locals":{"data":["4","ab","abc","ab","ac","ac"],"n":4},"depth":1},{"line":12,"locals":{"data":["4","ab","abc","ab","ac","ac"],"n":4,"s":"ab"},"depth":1},{"line":14,"locals":{"data":["4","ab","abc","ab","ac","ac"],"n":4,"s":"ab","words":["abc","ab","ac","ac"]},"depth":1},{"line":15,"locals":{"data":["4","ab","abc","ab","ac","ac"],"n":4,"s":"ab","words":["abc","ab","ac","ac"],"by_len":{}},"depth":1},{"line":16,"locals":{"data":["4","ab","abc","ab","ac","ac"],"n":4,"s":"ab","words":["abc","ab","ac","ac"],"by_len":{},"w":"abc"},"depth":1},{"line":15,"locals":{"data":["4","ab","abc","ab","ac","ac"],"n":4,"s":"ab","words":["abc","ab","ac","ac"],"by_len":{"3":["abc"]},"w":"abc"},"depth":1},{"line":16,"locals":{"data":["4","ab","abc","ab","ac","ac"],"n":4,"s":"ab","words":["abc","ab","ac","ac"],"by_len":{"3":["abc"]},"w":"ab"},"depth":1},{"line":15,"locals":{"data":["4","ab","abc","ab","ac","ac"],"n":4,"s":"ab","words":["abc","ab","ac","ac"],"by_len":{"2":["ab"],"3":["abc"]},"w":"ab"},"depth":1},{"line"