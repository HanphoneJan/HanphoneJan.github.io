{"docKey":"0033_search_in_rotated_sorted_array","code":"from typing import List\n\n\nclass Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        left, right = 0, len(nums) - 1\n        while left <= right:\n            mid = (left + right) // 2\n            if nums[mid] == target:\n                return mid\n            if nums[left] <= nums[mid]:\n                # 左半 [left, mid] 递增\n                if nums[left] <= target < nums[mid]:\n                    right = mid - 1\n                else:\n                    left = mid + 1\n            else:\n                # 右半 [mid, right] 递增\n                if nums[mid] < target <= nums[right]:\n                    left = mid + 1\n                else:\n                    right = mid - 1\n        return -1","method":"search","paramNames":["nums","target"],"args":["[4,5,6,7,0,1,2]","0"],"expected":"4","result":4,"events":[{"line":6,"locals":{"nums":[4,5,6,7,0,1,2],"target":0},"depth":1},{"line":7,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":0,"right":6},"depth":1},{"line":8,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":0,"right":6},"depth":1},{"line":9,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":0,"right":6,"mid":3},"depth":1},{"line":11,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":0,"right":6,"mid":3},"depth":1},{"line":13,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":0,"right":6,"mid":3},"depth":1},{"line":16,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":0,"right":6,"mid":3},"depth":1},{"line":7,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":4,"right":6,"mid":3},"depth":1},{"line":8,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":4,"right":6,"mid":3},"depth":1},{"line":9,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":4,"right":6,"mid":5},"depth":1},{"line":11,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":4,"right":6,"mid":5},"depth":1},{"line":13,"locals":{"nums":[4,5,6,7,0,1,2],"target":0,"left":4,"right":6,"mid":5},"depth":1},{"line":14,"loc