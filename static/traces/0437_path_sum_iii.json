{"docKey":"0437_path_sum_iii","code":"from typing import Optional\nfrom collections import defaultdict\n\nclass TreeNode:\n    def __init__(self, val=0, left=None, right=None):\n        self.val = val\n        self.left = left\n        self.right = right\n\nclass Solution:\n    \"\"\"\n    路径总和 III - 前缀和 + 哈希表\n\n    核心思路：\n    利用前缀和的思想。定义从根节点到当前节点的路径和为 curr_sum，\n    如果存在某个祖先节点的前缀和为 curr_sum - targetSum，\n    则从该祖先节点到当前节点的路径和为 targetSum。\n\n    时间复杂度: O(n)\n    空间复杂度: O(n)\n    \"\"\"\n    def pathSum(self, root: Optional[TreeNode], targetSum: int) -> int:\n        cnt = defaultdict(int)\n        cnt[0] = 1  # 前缀和为 0 的路径有 1 条（空路径）\n        ans = 0\n\n        def dfs(node: Optional[TreeNode], curr_sum: int) -> None:\n            nonlocal ans\n            if not node:\n                return\n\n            curr_sum += node.val\n            ans += cnt[curr_sum - targetSum]\n            cnt[curr_sum] += 1\n            dfs(node.left, curr_sum)\n            dfs(node.right, curr_sum)\n            cnt[curr_sum] -= 1  # 回溯\n\n        dfs(root, 0)\n        return ans","method":"pathSum","paramNames":["root","targetSum"],"argKinds":["tree","none"],"args":["[10,5,-3,3,2,None,11,3,-2,None,1]","8"],"expected":"3","result":3,"events":[{"line":23,"locals":{"root":{"$":"tree","v":[10,5,-3,3,2,11,3,-2,1,null,null,null,null,null,null]},"targetSum":8},"depth":1},{"line":24,"locals":{"root":{"$":"tree","v":[10,5,-3,3,2,11,3,-2,1,null,null,null,null,null,null]},"targetSum":8,"cnt":{}},"depth":1},{"line":25,"locals":{"root":{"$":"tree","v":[10,5,-3,3,2,11,3,-2,1,null,null,null,null,null,null]},"targetSum":8,"cnt":{"0":1}},"depth":1},{"line":27,"locals":{"root":{"$":"tree","v":[10,5,-3,3,2,11,3,-2,1,null,null,null,null,null,null]},"targetSum":8,"ans":0,"cnt":{"0":1}},"depth":1},{"line":39,"locals":{"root":{"$":"tree","v":[10,5,-3,3,2,11,3,-2,1,null,null,null,null,null,null]},"targetSum":8,"ans":0,"cnt":{"0":1},"dfs":"<function>"},"depth":1},{"line":29,"locals":{"node":{"$":"tree","v":[10,