{"docKey":"HJ1.字符串最后一个单词的长度","code":"import sys\n\n\ndef last_word(line: str) -> int:\n    \"\"\"计算字符串最后一个单词的长度（逆向遍历法，最优）\"\"\"\n    if not line:\n        return 0\n\n    line = line.strip()  # 去除首尾空格\n    count = 0\n\n    # 从后向前遍历，遇到第一个空格停止\n    for ch in reversed(line):\n        if ch == ' ':\n            break\n        count += 1\n\n    return count\n\n\ndef last_word_split(line: str) -> int:\n    \"\"\"使用 split 方法的解法（简洁但空间复杂度较高）\"\"\"\n    words = line.split()\n    return len(words[-1]) if words else 0\n\n\nif __name__ == \"__main__\":\n    for line in sys.stdin:\n        print(last_word(line))","method":"last_word","paramNames":["line"],"args":["\"HelloNowcoder\""],"expected":"13","result":13,"events":[{"line":6,"locals":{"line":"HelloNowcoder"},"depth":1},{"line":9,"locals":{"line":"HelloNowcoder"},"depth":1},{"line":10,"locals":{"line":"HelloNowcoder"},"depth":1},{"line":13,"locals":{"line":"HelloNowcoder","count":0},"depth":1},{"line":14,"locals":{"line":"HelloNowcoder","count":0,"ch":"r"},"depth":1},{"line":16,"locals":{"line":"HelloNowcoder","count":0,"ch":"r"},"depth":1},{"line":13,"locals":{"line":"HelloNowcoder","count":1,"ch":"r"},"depth":1},{"line":14,"locals":{"line":"HelloNowcoder","count":1,"ch":"e"},"depth":1},{"line":16,"locals":{"line":"HelloNowcoder","count":1,"ch":"e"},"depth":1},{"line":13,"locals":{"line":"HelloNowcoder","count":2,"ch":"e"},"depth":1},{"line":14,"locals":{"line":"HelloNowcoder","count":2,"ch":"d"},"depth":1},{"line":16,"locals":{"line":"HelloNowcoder","count":2,"ch":"d"},"depth":1},{"line":13,"locals":{"line":"HelloNowcoder","count":3,"ch":"d"},"depth":1},{"line":14,"locals":{"line":"HelloNowcoder","count":3,"ch":"o"},"depth":1},{"line":16,"locals":{"line":"HelloNowcoder","count":3,"ch":"o"},"depth":1},{"line":13,"locals":{"line":"HelloNowcoder","count":4,"ch":"o"},"depth":1},{"line":14,"locals":{"line":"HelloNowcoder","count":4,"ch":"c"},"depth":1},{"line":16,"locals":{"line":"HelloNowcoder","count":4,"ch":"c"},"depth":1},{