{"docKey":"PIO12.单组_二维字符数组","code":"import sys\n\n\ndef solve() -> None:\n    \"\"\"把二维字符数组旋转 180° 后输出\"\"\"\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])  # 列数：每行字符串长度天然是 m\n    rows = data[2:2 + n]\n    # 行倒置 + 每行倒置\n    out = [row[::-1] for row in reversed(rows)]\n    sys.stdout.write(\"\\n\".join(out) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"3 4\nabcd\nefgh\nijkl","expected":"lkji\nhgfe\ndcba","result":null,"events":[{"line":6,"locals":{},"depth":1},{"line":7,"locals":{"data":["3","4","abcd","efgh","ijkl"]},"depth":1},{"line":9,"locals":{"data":["3","4","abcd","efgh","ijkl"]},"depth":1},{"line":10,"locals":{"data":["3","4","abcd","efgh","ijkl"],"n":3},"depth":1},{"line":11,"locals":{"data":["3","4","abcd","efgh","ijkl"],"n":3,"m":4},"depth":1},{"line":13,"locals":{"data":["3","4","abcd","efgh","ijkl"],"n":3,"m":4,"rows":["abcd","efgh","ijkl"]},"depth":1},{"line":13,"locals":{"data":["3","4","abcd","efgh","ijkl"],"n":3,"m":4,"rows":["abcd","efgh","ijkl"],"row":"ijkl"},"depth":1},{"line":13,"locals":{"data":["3","4","abcd","efgh","ijkl"],"n":3,"m":4,"rows":["abcd","efgh","ijkl"],"row":"efgh"},"depth":1},{"line":13,"locals":{"data":["3","4","abcd","efgh","ijkl"],"n":3,"m":4,"rows":["abcd","efgh","ijkl"],"row":"abcd"},"depth":1},{"line":14,"locals":{"data":["3","4","abcd","efgh","ijkl"],"n":3,"m":4,"rows":["abcd","efgh","ijkl"],"out":["lkji","hgfe","dcba"]},"depth":1}]}