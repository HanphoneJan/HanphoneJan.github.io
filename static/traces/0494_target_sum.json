{"docKey":"0494_target_sum","code":"from typing import List\n\n\nclass Solution:\n    \"\"\"\n    目标和 - 0/1背包问题\n\n    正号部分和 P = (target + sum(nums)) / 2\n    问题转化为：从nums中选若干个数，使和为P的方案数\n\n    时间复杂度：O(n * m)\n    空间复杂度：O(m)\n    \"\"\"\n\n    def findTargetSumWays(self, nums: List[int], target: int) -> int:\n        s = sum(nums) - abs(target)\n        if s < 0 or s % 2:\n            return 0\n\n        m = s // 2  # 背包容量\n        f = [1] + [0] * m  # f[c]表示凑出和c的方案数\n\n        for x in nums:\n            # 倒序遍历，避免重复计算（0/1背包）\n            for c in range(m, x - 1, -1):\n                f[c] += f[c - x]\n\n        return f[m]","method":"findTargetSumWays","paramNames":["nums","target"],"args":["[1,1,1,1,1]","3"],"expected":"5","result":5,"events":[{"line":16,"locals":{"nums":[1,1,1,1,1],"target":3},"depth":1},{"line":17,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2},"depth":1},{"line":20,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2},"depth":1},{"line":21,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1},"depth":1},{"line":23,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,0]},"depth":1},{"line":25,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,0],"x":1},"depth":1},{"line":26,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,0],"x":1,"c":1},"depth":1},{"line":25,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,1],"x":1,"c":1},"depth":1},{"line":23,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,1],"x":1,"c":1},"depth":1},{"line":25,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,1],"x":1,"c":1},"depth":1},{"line":26,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,1],"x":1,"c":1},"depth":1},{"line":25,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,2],"x":1,"c":1},"depth":1},{"line":23,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,2],"x":1,"c":1},"depth":1},{"line":25,"locals":{"nums":[1,1,1,1,1],"target":3,"s":2,"m":1,"f":[1,2],"x":1,"c":1},"depth":1},{"line":26,"local