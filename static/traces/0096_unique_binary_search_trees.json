{"docKey":"0096_unique_binary_search_trees","code":"class Solution:\n    \"\"\"\n    不同的二叉搜索树 - 动态规划（卡特兰数）\n\n    G(n) = sum(G(i-1) * G(n-i)) for i in 1..n\n\n    时间复杂度：O(n²)\n    空间复杂度：O(n)\n    \"\"\"\n\n    def numTrees(self, n: int) -> int:\n        G = [0] * (n + 1)\n        G[0], G[1] = 1, 1\n\n        for i in range(2, n + 1):\n            for j in range(1, i + 1):\n                G[i] += G[j - 1] * G[i - j]\n\n        return G[n]","method":"numTrees","paramNames":["n"],"args":["3"],"expected":"5","result":5,"events":[{"line":12,"locals":{"n":3},"depth":1},{"line":13,"locals":{"n":3,"G":[0,0,0,0]},"depth":1},{"line":15,"locals":{"n":3,"G":[1,1,0,0]},"depth":1},{"line":16,"locals":{"n":3,"G":[1,1,0,0],"i":2},"depth":1},{"line":17,"locals":{"n":3,"G":[1,1,0,0],"i":2,"j":1},"depth":1},{"line":16,"locals":{"n":3,"G":[1,1,1,0],"i":2,"j":1},"depth":1},{"line":17,"locals":{"n":3,"G":[1,1,1,0],"i":2,"j":2},"depth":1},{"line":16,"locals":{"n":3,"G":[1,1,2,0],"i":2,"j":2},"depth":1},{"line":15,"locals":{"n":3,"G":[1,1,2,0],"i":2,"j":2},"depth":1},{"line":16,"locals":{"n":3,"G":[1,1,2,0],"i":3,"j":2},"depth":1},{"line":17,"locals":{"n":3,"G":[1,1,2,0],"i":3,"j":1},"depth":1},{"line":16,"locals":{"n":3,"G":[1,1,2,2],"i":3,"j":1},"depth":1},{"line":17,"locals":{"n":3,"G":[1,1,2,2],"i":3,"j":2},"depth":1},{"line":16,"locals":{"n":3,"G":[1,1,2,3],"i":3,"j":2},"depth":1},{"line":17,"locals":{"n":3,"G":[1,1,2,3],"i":3,"j":3},"depth":1},{"line":16,"locals":{"n":3,"G":[1,1,2,5],"i":3,"j":3},"depth":1},{"line":15,"locals":{"n":3,"G":[1,1,2,5],"i":3,"j":3},"depth":1},{"line":19,"locals":{"n":3,"G":[1,1,2,5],"i":3,"j":3},"depth":1}]}