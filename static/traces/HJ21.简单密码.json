{"docKey":"HJ21.简单密码","code":"import sys\n\n# 小写字母 -> 数字的映射表\nLOWER_TO_DIGIT = {\n    'a': '2', 'b': '2', 'c': '2',\n    'd': '3', 'e': '3', 'f': '3',\n    'g': '4', 'h': '4', 'i': '4',\n    'j': '5', 'k': '5', 'l': '5',\n    'm': '6', 'n': '6', 'o': '6',\n    'p': '7', 'q': '7', 'r': '7', 's': '7',\n    't': '8', 'u': '8', 'v': '8',\n    'w': '9', 'x': '9', 'y': '9', 'z': '9',\n}\n\n\ndef convert(pwd: str) -> str:\n    \"\"\"转换单个密码\"\"\"\n    res = []\n    for ch in pwd:\n        if ch.islower():\n            res.append(LOWER_TO_DIGIT[ch])   # 小写 -> 数字\n        elif ch.isupper():\n            # 大写 -> 转小写后，ASCII 后移一位（z 后移回到 a）\n            res.append(chr((ord(ch.lower()) - ord('a') + 1) % 26 + ord('a')))\n        else:\n            res.append(ch)                   # 数字/其他保持不变\n    return ''.join(res)\n\n\ndef solve() -> None:\n    \"\"\"主求解函数\"\"\"\n    pwd = sys.stdin.readline().strip()\n    print(convert(pwd))\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"YUANzhi1987","expected":"zvbo9441987","result":null,"events":[{"line":32,"locals":{},"depth":1},{"line":33,"locals":{"pwd":"YUANzhi1987"},"depth":1},{"line":18,"locals":{"pwd":"YUANzhi1987"},"depth":2},{"line":19,"locals":{"pwd":"YUANzhi1987","res":[]},"depth":2},{"line":20,"locals":{"pwd":"YUANzhi1987","res":[],"ch":"Y"},"depth":2},{"line":22,"locals":{"pwd":"YUANzhi1987","res":[],"ch":"Y"},"depth":2},{"line":24,"locals":{"pwd":"YUANzhi1987","res":[],"ch":"Y"},"depth":2},{"line":19,"locals":{"pwd":"YUANzhi1987","res":["z"],"ch":"Y"},"depth":2},{"line":20,"locals":{"pwd":"YUANzhi1987","res":["z"],"ch":"U"},"depth":2},{"line":22,"locals":{"pwd":"YUANzhi1987","res":["z"],"ch":"U"},"depth":2},{"line":24,"locals":{"pwd":"YUANzhi1987","res":["z"],"ch":"U"},"depth":2},{"line":19,"locals":{"pwd":"YUANzhi1987","res":["z","v"],"ch":"U"},"depth":2},{"line":20,"locals":{"pwd":"YUANzhi1987","res":["z","v"],"ch":"A"},"depth":2},{"line":22,"locals":{"pwd":"YUANzhi1987","res