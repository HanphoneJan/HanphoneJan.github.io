{"docKey":"HJ17.坐标移动","code":"import sys\nimport re\n\n\ndef solve():\n    line = sys.stdin.readline().strip()\n\n    # 方向映射：A=左(x-), D=右(x+), W=上(y+), S=下(y-)\n    delta = {\n        'A': (-1, 0),\n        'D': (1, 0),\n        'W': (0, 1),\n        'S': (0, -1),\n    }\n\n    x, y = 0, 0\n    commands = line.split(';')\n\n    for cmd in commands:\n        if not cmd:\n            continue\n\n        match = re.fullmatch(r'([ASDW])(\\d{1,2})', cmd)\n        if not match:\n            continue\n\n        direction = match.group(1)\n        distance = int(match.group(2))\n\n        if distance < 1 or distance > 99:\n            continue\n\n        dx, dy = delta[direction]\n        x += dx * distance\n        y += dy * distance\n\n    print(f\"{x},{y}\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"A10;S20;W10;D30;X;A1A;B10A11;;A10;","expected":"10,-10","result":null,"events":[{"line":6,"locals":{},"depth":1},{"line":10,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":11,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":12,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":13,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":9,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":16,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;","delta":{"A":[-1,0],"D":[1,0],"W":[0,1],"S":[0,-1]}},"depth":1},{"line":17,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;","delta":{"A":[-1,0],"D":[1,0],"W":[0,1],"S":[0,-1]},"x":0,"y":0},"depth":1},{"line":19,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;","delta":{"A":[-1,0],"D":[1,0],"W":[0,1],"S":[0,-1]},"x":0,"y":0,"commands":["A10","S20","W10","D30","X","A1A","B10A11","","A10",""]},"depth":1},{"line":20,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;","delta":{"A":[-1,0],"D":[1,0],"W":[0,1],"S":[0,-1]},"x":0,"y":0,"commands":["A10","S20","W10","