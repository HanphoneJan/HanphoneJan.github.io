{"docKey":"HJ17.坐标移动","code":"import sys\nimport re\n\n\ndef solve():\n    # 读入整行并去掉换行符，末尾的分号留给 split 处理\n    line = sys.stdin.readline().strip()\n\n    # 方向映射：A=左(x-), D=右(x+), W=上(y+), S=下(y-)\n    delta = {\n        'A': (-1, 0),\n        'D': (1, 0),\n        'W': (0, 1),\n        'S': (0, -1),\n    }\n\n    # 小人从原点 (0, 0) 出发\n    x, y = 0, 0\n    # 按分号切成一条条指令；末尾分号会切出一个空串，循环里统一跳过\n    commands = line.split(';')\n\n    for cmd in commands:\n        # 空指令（包括连续分号切出来的）不是合法指令\n        if not cmd:\n            continue\n\n        # 整串校验格式：方向字符 + 1~2 位数字，多一个字符都不行\n        match = re.fullmatch(r'([ASDW])(\\d{1,2})', cmd)\n        # 格式不对就整条丢弃，继续看下一条\n        if not match:\n            continue\n\n        # group(1) 是方向字符，group(2) 是数字部分\n        direction = match.group(1)\n        distance = int(match.group(2))\n\n        # 位数合法不等于数值合法：\"00\" 也能过正则，实际值是 0，要挡掉\n        if distance < 1 or distance > 99:\n            continue\n\n        # 取出该方向的单位位移，再乘以步数\n        dx, dy = delta[direction]\n        # A/S 的位移是负的，直接用乘加即可，不用写四个分支\n        x += dx * distance\n        y += dy * distance\n\n    # 按题目要求输出「x,y」，中间不带空格\n    print(f\"{x},{y}\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"A10;S20;W10;D30;X;A1A;B10A11;;A10;","expected":"10,-10","result":null,"events":[{"line":7,"locals":{},"depth":1},{"line":11,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":12,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":13,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":14,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":10,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;"},"depth":1},{"line":18,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;","delta":{"A":[-1,0],"D":[1,0],"W":[0,1],"S":[0,-1]}},"depth":1},{"line":20,"locals":{"line":"A10;S20;W10;D30;X;A1A;B10A11;;A10;","delta":{"A":[-1,0],"D":[1,0],"W":[0,1],"S":[0,-1]},"x":0,"y":0}