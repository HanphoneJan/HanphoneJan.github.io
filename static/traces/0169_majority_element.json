{"docKey":"0169_majority_element","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    169. 多数元素 - Boyer-Moore 投票算法\n\n    核心思想：\n    把不同的元素两两抵消，最后剩下的就是出现次数超过一半的多数元素。\n\n    时间复杂度：O(n)\n    空间复杂度：O(1)\n    \"\"\"\n\n    def majorityElement(self, nums: List[int]) -> int:\n        candidate = nums[0]\n        count = 0\n\n        for num in nums:\n            if count == 0:\n                candidate = num\n            if num == candidate:\n                count += 1\n            else:\n                count -= 1\n\n        return candidate","method":"majorityElement","paramNames":["nums"],"args":["[3,2,3]"],"expected":"3","result":3,"events":[{"line":15,"locals":{"nums":[3,2,3]}},{"line":16,"locals":{"nums":[3,2,3],"candidate":3}},{"line":18,"locals":{"nums":[3,2,3],"candidate":3,"count":0}},{"line":19,"locals":{"nums":[3,2,3],"candidate":3,"count":0,"num":3}},{"line":20,"locals":{"nums":[3,2,3],"candidate":3,"count":0,"num":3}},{"line":21,"locals":{"nums":[3,2,3],"candidate":3,"count":0,"num":3}},{"line":22,"locals":{"nums":[3,2,3],"candidate":3,"count":0,"num":3}},{"line":18,"locals":{"nums":[3,2,3],"candidate":3,"count":1,"num":3}},{"line":19,"locals":{"nums":[3,2,3],"candidate":3,"count":1,"num":2}},{"line":21,"locals":{"nums":[3,2,3],"candidate":3,"count":1,"num":2}},{"line":24,"locals":{"nums":[3,2,3],"candidate":3,"count":1,"num":2}},{"line":18,"locals":{"nums":[3,2,3],"candidate":3,"count":0,"num":2}},{"line":19,"locals":{"nums":[3,2,3],"candidate":3,"count":0,"num":3}},{"line":20,"locals":{"nums":[3,2,3],"candidate":3,"count":0,"num":3}},{"line":21,"locals":{"nums":[3,2,3],"candidate":3,"count":0,"num":3}},{"line":22,"locals":{"nums":[3,2,3],"candidate":3,"count":0,"num":3}},{"line":18,"locals":{"nums":[3,2,3],"candidate":3,"count":1,"num":3}},{"line":26,"locals":{"nums":[3,2,3],"candidate":3,"count":1,"num":3}}]}