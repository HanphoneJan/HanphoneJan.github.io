{"docKey":"P6084","code":"import sys\n\n\ndef solve():\n    data = sys.stdin.buffer.read().split()\n    if not data:\n        return\n    m, k, n = int(data[0]), int(data[1]), int(data[2])\n\n    # 每个请求占 ceil(len / k) 个 Block\n    need = sorted((int(x) + k - 1) // k for x in data[3:3 + n])\n\n    used = 0\n    cnt = 0\n    for c in need:\n        if used + c > m:        # 升序，后面的只会更贵，可以停\n            break\n        used += c\n        cnt += 1\n    print(cnt)\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"4 8 3\n20 6 11","expected":"2","result":null,"events":[{"line":5,"locals":{},"depth":1},{"line":6,"locals":{"data":["4","8","3","20","6","11"]},"depth":1},{"line":8,"locals":{"data":["4","8","3","20","6","11"]},"depth":1},{"line":11,"locals":{"data":["4","8","3","20","6","11"],"m":4,"n":3,"k":8},"depth":1},{"line":11,"locals":{".0":"<list_iterator>","k":8},"depth":2},{"line":11,"locals":{".0":"<list_iterator>","x":"20","k":8},"depth":2},{"line":11,"locals":{".0":"<list_iterator>","x":"6","k":8},"depth":2},{"line":11,"locals":{".0":"<list_iterator>","x":"11","k":8},"depth":2},{"line":13,"locals":{"data":["4","8","3","20","6","11"],"m":4,"n":3,"need":[1,2,3],"k":8},"depth":1},{"line":14,"locals":{"data":["4","8","3","20","6","11"],"m":4,"n":3,"need":[1,2,3],"used":0,"k":8},"depth":1},{"line":15,"locals":{"data":["4","8","3","20","6","11"],"m":4,"n":3,"need":[1,2,3],"used":0,"cnt":0,"k":8},"depth":1},{"line":16,"locals":{"data":["4","8","3","20","6","11"],"m":4,"n":3,"need":[1,2,3],"used":0,"cnt":0,"c":1,"k":8},"depth":1},{"line":18,"locals":{"data":["4","8","3","20","6","11"],"m":4,"n":3,"need":[1,2,3],"used":0,"cnt":0,"c":1,"k":8},"depth":1},{"line":19,"locals":{"data":["4","8","3","20","6","11"],"m":4,"n":3,"need":[1,2,3],"used":1,"cnt":0,"c":1,"k":8},"depth":1},{"line":15,"locals":{"data":["4","8","3","20","6","11"],"m":4,"n":3,"need":[1,2,3],"used":1,"cnt":1,"c":1,"k":8},"depth":1},{"line":16,"locals":{"data":["4