{"docKey":"0104_maximum_depth_of_binary_tree","code":"from typing import Optional\n\nclass TreeNode:\n    def __init__(self, val=0, left=None, right=None):\n        self.val = val\n        self.left = left\n        self.right = right\n\nclass Solution:\n    \"\"\"\n    二叉树的最大深度 - 递归/DFS\n\n    核心思想：\n    二叉树的最大深度 = max(左子树的最大深度, 右子树的最大深度) + 1\n\n    时间复杂度：O(n)\n    空间复杂度：O(h)\n    \"\"\"\n\n    def maxDepth(self, root: Optional[TreeNode]) -> int:\n        if not root:\n            return 0\n        return max(self.maxDepth(root.left), self.maxDepth(root.right)) + 1","method":"maxDepth","paramNames":["root"],"argKinds":["tree"],"args":["[3,9,20,None,None,15,7]"],"expected":"3","result":3,"events":[{"line":21,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]}},"depth":1},{"line":23,"locals":{"root":{"$":"tree","v":[3,9,20,15,7,null,null]}},"depth":1},{"line":21,"locals":{"root":{"$":"n","i":1,"v":9}},"depth":2},{"line":23,"locals":{"root":{"$":"n","i":1,"v":9}},"depth":2},{"line":21,"locals":{"root":null},"depth":3},{"line":22,"locals":{"root":null},"depth":3},{"line":21,"locals":{"root":null},"depth":3},{"line":22,"locals":{"root":null},"depth":3},{"line":21,"locals":{"root":{"$":"n","i":2,"v":20}},"depth":2},{"line":23,"locals":{"root":{"$":"n","i":2,"v":20}},"depth":2},{"line":21,"locals":{"root":{"$":"n","i":3,"v":15}},"depth":3},{"line":23,"locals":{"root":{"$":"n","i":3,"v":15}},"depth":3},{"line":21,"locals":{"root":null},"depth":4},{"line":22,"locals":{"root":null},"depth":4},{"line":21,"locals":{"root":null},"depth":4},{"line":22,"locals":{"root":null},"depth":4},{"line":21,"locals":{"root":{"$":"n","i":4,"v":7}},"depth":3},{"line":23,"locals":{"root":{"$":"n","i":4,"v":7}},"depth":3},{"line":21,"locals":{"root":null},"depth":4},{"line":22,"locals":{"root":null},"depth":4},{"line":21,"locals":{"root":null},"depth":4},{"line":22,"locals":{"root":null},"depth":4}]}