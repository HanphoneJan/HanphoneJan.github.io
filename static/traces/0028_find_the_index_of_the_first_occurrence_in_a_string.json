{"docKey":"0028_find_the_index_of_the_first_occurrence_in_a_string","code":"class Solution:\n    def strStr(self, haystack: str, needle: str) -> int:\n        length = len(haystack)\n        window = len(needle)\n        if window == 0:\n            return 0\n        if length < window:\n            return -1\n        for left in range(0, length - window + 1):\n            if needle == haystack[left:left + window]:\n                return left\n        return -1","method":"strStr","paramNames":["haystack","needle"],"args":["\"leetcode\"","\"leeto\""],"expected":"-1","result":-1,"events":[{"line":3,"locals":{"haystack":"leetcode","needle":"leeto"},"depth":1},{"line":4,"locals":{"haystack":"leetcode","needle":"leeto","length":8},"depth":1},{"line":5,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5},"depth":1},{"line":7,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5},"depth":1},{"line":9,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5},"depth":1},{"line":10,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":0},"depth":1},{"line":9,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":0},"depth":1},{"line":10,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":1},"depth":1},{"line":9,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":1},"depth":1},{"line":10,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":2},"depth":1},{"line":9,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":2},"depth":1},{"line":10,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":3},"depth":1},{"line":9,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":3},"depth":1},{"line":12,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":3},"depth":1}]}