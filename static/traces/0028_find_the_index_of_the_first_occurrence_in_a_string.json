{"docKey":"0028_find_the_index_of_the_first_occurrence_in_a_string","code":"class Solution:\n    def strStr(self, haystack: str, needle: str) -> int:\n        # 先取好两个长度，循环里反复用到\n        length = len(haystack)\n        window = len(needle)\n        # 空模式串在任意位置都算匹配，按题意返回 0\n        if window == 0:\n            return 0\n        # 长串比模式还短，任何窗口都装不下它\n        if length < window:\n            return -1\n        # left 是窗口起点；右端 left+window 最远取到 length，不能越界\n        for left in range(0, length - window + 1):\n            # 整窗比较交给切片，比较在 C 层完成，比手写逐字符快\n            if needle == haystack[left:left + window]:\n                return left\n        # 所有窗口都比过，说明 needle 不在 haystack 中\n        return -1","method":"strStr","paramNames":["haystack","needle"],"args":["\"leetcode\"","\"leeto\""],"expected":"-1","result":-1,"events":[{"line":4,"locals":{"haystack":"leetcode","needle":"leeto"},"depth":1},{"line":5,"locals":{"haystack":"leetcode","needle":"leeto","length":8},"depth":1},{"line":7,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5},"depth":1},{"line":10,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5},"depth":1},{"line":13,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5},"depth":1},{"line":15,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":0},"depth":1},{"line":13,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":0},"depth":1},{"line":15,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":1},"depth":1},{"line":13,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":1},"depth":1},{"line":15,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":2},"depth":1},{"line":13,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":2},"depth":1},{"line":15,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":3},"depth":1},{"line":13,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":3},"depth":1},{"line":18,"locals":{"haystack":"leetcode","needle":"leeto","length":8,"window":5,"left":3},"depth":1}]}