{"docKey":"HJ144.小红书推荐系统","code":"import sys\nfrom collections import Counter\n\n\ndef solve() -> None:\n    s = sys.stdin.readline().strip()\n    words = s.split()\n    cnt = Counter(words)\n\n    # 过滤出现 >= 3 次的单词\n    keywords = [(w, c) for w, c in cnt.items() if c >= 3]\n    # 频次降序，同频字典序升序\n    keywords.sort(key=lambda x: (-x[1], x[0]))\n\n    for w, _ in keywords:\n        print(w)\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"kou red game red ok who game red karaoke yukari kou red red nani kou can koukou ongakugame game","expected":"red\ngame\nkou","result":null,"events":[{"line":6,"locals":{},"depth":1},{"line":7,"locals":{"s":"kou red game red ok who game red karaoke yukari kou red red nani kou can koukou ongakugame game"},"depth":1},{"line":8,"locals":{"s":"kou red game red ok who game red karaoke yukari kou red red nani kou can koukou ongakugame game","words":["kou","red","game","red","ok","who","game","red","karaoke","yukari","kou","red","red","nani","kou","can","koukou","ongakugame","game"]},"depth":1},{"line":11,"locals":{"s":"kou red game red ok who game red karaoke yukari kou red red nani kou can koukou ongakugame game","words":["kou","red","game","red","ok","who","game","red","karaoke","yukari","kou","red","red","nani","kou","can","koukou","ongakugame","game"],"cnt":{"kou":3,"red":5,"game":3,"ok":1,"who":1,"karaoke":1,"yukari":1,"nani":1,"can":1,"koukou":1,"ongakugame":1}},"depth":1},{"line":11,"locals":{"s":"kou red game red ok who game red karaoke yukari kou red red nani kou can koukou ongakugame game","words":["kou","red","game","red","ok","who","game","red","karaoke","yukari","kou","red","red","nani","kou","can","koukou","ongakugame","game"],"cnt":{"kou":3,"red":5,"game":3,"ok":1,"who":1,"karaoke":1,"yukari":1,"nani":1,"can":1,"koukou":1,"ongakugame":1},"w":"kou","c":3},"depth":1},{"line":11,"locals":{"s":"kou red game red ok who game red karaoke yukari kou red red nani kou can koukou ongakugam