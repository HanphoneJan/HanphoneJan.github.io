{"docKey":"0136_single_number","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    136. 只出现一次的数字 - 位运算（异或）\n\n    核心思想：\n    利用异或运算的性质：a ^ a = 0，a ^ 0 = a。\n    所有出现两次的数字异或后抵消为 0，最后剩下的就是只出现一次的数字。\n\n    时间复杂度：O(n)\n    空间复杂度：O(1)\n    \"\"\"\n\n    def singleNumber(self, nums: List[int]) -> int:\n        x = 0\n        for num in nums:\n            x ^= num\n        return x","method":"singleNumber","paramNames":["nums"],"args":["[4,1,2,1,2]"],"expected":"4","result":4,"events":[{"line":16,"locals":{"nums":[4,1,2,1,2]},"depth":1},{"line":17,"locals":{"nums":[4,1,2,1,2],"x":0},"depth":1},{"line":18,"locals":{"nums":[4,1,2,1,2],"x":0,"num":4},"depth":1},{"line":17,"locals":{"nums":[4,1,2,1,2],"x":4,"num":4},"depth":1},{"line":18,"locals":{"nums":[4,1,2,1,2],"x":4,"num":1},"depth":1},{"line":17,"locals":{"nums":[4,1,2,1,2],"x":5,"num":1},"depth":1},{"line":18,"locals":{"nums":[4,1,2,1,2],"x":5,"num":2},"depth":1},{"line":17,"locals":{"nums":[4,1,2,1,2],"x":7,"num":2},"depth":1},{"line":18,"locals":{"nums":[4,1,2,1,2],"x":7,"num":1},"depth":1},{"line":17,"locals":{"nums":[4,1,2,1,2],"x":6,"num":1},"depth":1},{"line":18,"locals":{"nums":[4,1,2,1,2],"x":6,"num":2},"depth":1},{"line":17,"locals":{"nums":[4,1,2,1,2],"x":4,"num":2},"depth":1},{"line":19,"locals":{"nums":[4,1,2,1,2],"x":4,"num":2},"depth":1}]}