{"docKey":"0019_remove_nth_node_from_end_of_list","code":"from typing import Optional\n\n\nclass ListNode:\n    def __init__(self, val=0, next=None):\n        self.val = val\n        self.next = next\n\n\nclass Solution:\n    def removeNthFromEnd(self, head: Optional[ListNode], n: int) -> Optional[ListNode]:\n        dummy = ListNode(0, head)      # 哑结点：让头节点也有前驱\n        fast = slow = dummy\n        for _ in range(n):             # 两指针拉开 n 步\n            fast = fast.next\n        while fast.next:               # 一起走，直到 fast 到链尾\n            fast = fast.next\n            slow = slow.next\n        slow.next = slow.next.next     # slow 停在待删节点的前驱\n        return dummy.next","method":"removeNthFromEnd","paramNames":["head","n"],"argKinds":["list","none"],"args":["[1,2,3,4,5]","2"],"expected":"[1,2,3,5]","result":[1,2,3,5],"events":[{"line":12,"locals":{"head":{"$":"list","v":[1,2,3,4,5]},"n":2},"depth":1},{"line":6,"locals":{"val":0,"next":{"$":"list","v":[1,2,3,4,5]}},"depth":2},{"line":7,"locals":{"val":0,"next":{"$":"list","v":[1,2,3,4,5]}},"depth":2},{"line":13,"locals":{"head":{"$":"list","v":[1,2,3,4,5]},"n":2,"dummy":{"$":"n","i":5,"v":0}},"depth":1},{"line":14,"locals":{"head":{"$":"list","v":[1,2,3,4,5]},"n":2,"dummy":{"$":"n","i":5,"v":0},"fast":{"$":"n","i":5,"v":0},"slow":{"$":"n","i":5,"v":0}},"depth":1},{"line":15,"locals":{"head":{"$":"list","v":[1,2,3,4,5]},"n":2,"dummy":{"$":"n","i":5,"v":0},"fast":{"$":"n","i":5,"v":0},"slow":{"$":"n","i":5,"v":0},"_":0},"depth":1},{"line":14,"locals":{"head":{"$":"list","v":[1,2,3,4,5]},"n":2,"dummy":{"$":"n","i":5,"v":0},"fast":{"$":"list","v":[1,2,3,4,5]},"slow":{"$":"n","i":5,"v":0},"_":0},"depth":1},{"line":15,"locals":{"head":{"$":"list","v":[1,2,3,4,5]},"n":2,"dummy":{"$":"n","i":5,"v":0},"fast":{"$":"list","v":[1,2,3,4,5]},"slow":{"$":"n","i":5,"v":0},"_":1},"depth":1},{"line":14,"locals":{"head":{"$":"list","v":[1,2,3,4,5]},"n":2,"dummy":{"$":"n","i":5,"v":0},"fast":{"$":"n","i":1,"v":2},"slow":{"$":"n","i":5,"