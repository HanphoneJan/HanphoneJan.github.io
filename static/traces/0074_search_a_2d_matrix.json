{"docKey":"0074_search_a_2d_matrix","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    搜索二维矩阵 - 二分查找\n\n    核心思想：\n    矩阵每行从左到右递增，每行第一个数大于上一行最后一个数。\n    可以将二维矩阵视为一个有序的一维数组进行二分查找。\n\n    虚拟索引转换：\n    对于虚拟索引 idx，对应的矩阵位置为：\n    - 行号：idx // n\n    - 列号：idx % n\n\n    时间复杂度：O(log(m*n)) = O(log m + log n)\n    空间复杂度：O(1)\n    \"\"\"\n\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\n        m, n = len(matrix), len(matrix[0])\n        left, right = 0, m * n  # 将二维矩阵视为一维有序数组，左闭右开区间\n\n        while left < right:  # 不使用 <=：左闭右开写法更统一\n            mid = (left + right) // 2\n            x = matrix[mid // n][mid % n]\n            if x == target:\n                return True\n            elif x < target:\n                left = mid + 1\n            else:\n                right = mid  # 收缩右边界到 mid\n        return False","method":"searchMatrix","paramNames":["matrix","target"],"args":["[[1,3,5,7],[10,11,16,20],[23,30,34,60]]","3"],"expected":"true","result":true,"events":[{"line":21,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3},"depth":1},{"line":22,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4},"depth":1},{"line":24,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":12},"depth":1},{"line":25,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":12},"depth":1},{"line":26,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":12,"mid":6},"depth":1},{"line":27,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":12,"mid":6,"x":16},"depth":1},{"line":29,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":12,"mid":6,"x":16},"depth":1},{"line":32,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":12,"mid":6,"x":16},"depth":1},{"line":24,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":6,"mid":6,"x":16},"depth":1},{"line":25,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":6,"mid":6,"x":16},"depth":1},{"line":26,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":6,"mid":3,"x":16},"depth":1},{"line":27,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":6,"mid":3,"x":7},"depth":1},{"line":29,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":6,"mid":3,"x":7},"depth":1},{"line":32,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":6,"mid":3,"x":7},"depth":1},{"line":24,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":3,"mid":3,"x":7},"depth":1},{"line":25,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":3,"mid":3,"x":7},"depth":1},{"line":26,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":3,"mid":1,"x":7},"depth":1},{"line":27,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":3,"mid":1,"x":3},"depth":1},{"line":28,"locals":{"matrix":[[1,3,5,7],[10,11,16,20],[23,30,34,60]],"target":3,"m":3,"n":4,"left":0,"right":3,"mid":1,"x":3},"depth":1}]}