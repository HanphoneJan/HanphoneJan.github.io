{"docKey":"HJ92.在字符串中找出连续最长的数字串","code":"import sys\nimport re\n\n\ndef solve():\n    s = sys.stdin.readline().strip()\n    nums = re.findall(r'\\d+', s)\n    # 没有任何数字段时直接结束，否则下一步 max() 会对空序列报错\n    if not nums:\n        return\n    maxlen = max(len(x) for x in nums)\n    # 最长段可能有多段，全部按出现顺序拼接\n    res = ''.join(x for x in nums if len(x) == maxlen)\n    print(f\"{res},{maxlen}\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"abcd12345ed125ss123456789","expected":"123456789,9","result":null,"events":[{"line":6,"locals":{},"depth":1},{"line":7,"locals":{"s":"abcd12345ed125ss123456789"},"depth":1},{"line":9,"locals":{"s":"abcd12345ed125ss123456789","nums":["12345","125","123456789"]},"depth":1},{"line":11,"locals":{"s":"abcd12345ed125ss123456789","nums":["12345","125","123456789"]},"depth":1},{"line":11,"locals":{".0":"<list_iterator>"},"depth":2},{"line":11,"locals":{".0":"<list_iterator>","x":"12345"},"depth":2},{"line":11,"locals":{".0":"<list_iterator>","x":"125"},"depth":2},{"line":11,"locals":{".0":"<list_iterator>","x":"123456789"},"depth":2},{"line":13,"locals":{"s":"abcd12345ed125ss123456789","nums":["12345","125","123456789"],"maxlen":9},"depth":1},{"line":13,"locals":{".0":"<list_iterator>","maxlen":9},"depth":2},{"line":13,"locals":{".0":"<list_iterator>","x":"12345","maxlen":9},"depth":2},{"line":13,"locals":{".0":"<list_iterator>","x":"125","maxlen":9},"depth":2},{"line":13,"locals":{".0":"<list_iterator>","x":"123456789","maxlen":9},"depth":2},{"line":14,"locals":{"s":"abcd12345ed125ss123456789","nums":["12345","125","123456789"],"res":"123456789","maxlen":9},"depth":1}]}