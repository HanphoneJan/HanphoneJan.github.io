{"docKey":"0005_longest_palindromic_substring","code":"class Solution:\n    def longestPalindrome(self, s: str) -> str:\n        if not s:\n            return \"\"\n\n        def expandAroundCenter(left: int, right: int) -> tuple[int, int]:\n            # 向两侧扩展，直到越界或字符不匹配\n            while left >= 0 and right < len(s) and s[left] == s[right]:\n                left -= 1\n                right += 1\n            # 循环结束时 left 和 right 各越出一位，回退一位得到实际范围\n            return left + 1, right - 1\n\n        start, end = 0, 0\n\n        for i in range(len(s)):\n            l1, r1 = expandAroundCenter(i, i)      # 奇数长度：以 s[i] 为中心\n            l2, r2 = expandAroundCenter(i, i + 1)  # 偶数长度：以 s[i] 和 s[i+1] 之间为中心\n\n            if r1 - l1 > end - start:\n                start, end = l1, r1\n            if r2 - l2 > end - start:\n                start, end = l2, r2\n\n        return s[start:end + 1]","method":"longestPalindrome","paramNames":["s"],"args":["\"cbbd\""],"expected":"\"bb\"","result":"bb","events":[{"line":3,"locals":{"s":"cbbd"},"depth":1},{"line":6,"locals":{"s":"cbbd"},"depth":1},{"line":14,"locals":{"s":"cbbd","expandAroundCenter":"<function>"},"depth":1},{"line":16,"locals":{"s":"cbbd","expandAroundCenter":"<function>","start":0,"end":0},"depth":1},{"line":17,"locals":{"s":"cbbd","expandAroundCenter":"<function>","start":0,"end":0,"i":0},"depth":1},{"line":8,"locals":{"left":0,"right":0,"s":"cbbd"},"depth":2},{"line":9,"locals":{"left":0,"right":0,"s":"cbbd"},"depth":2},{"line":10,"locals":{"left":-1,"right":0,"s":"cbbd"},"depth":2},{"line":8,"locals":{"left":-1,"right":1,"s":"cbbd"},"depth":2},{"line":12,"locals":{"left":-1,"right":1,"s":"cbbd"},"depth":2},{"line":18,"locals":{"s":"cbbd","expandAroundCenter":"<function>","start":0,"end":0,"i":0,"l1":0,"r1":0},"depth":1},{"line":8,"locals":{"left":0,"right":1,"s":"cbbd"},"depth":2},{"line":12,"locals":{"left":0,"right":1,"s":"cbbd"},"depth":2},{"line":20,"locals":{"s":"cbbd","expandAroundCenter":"<function>","start"