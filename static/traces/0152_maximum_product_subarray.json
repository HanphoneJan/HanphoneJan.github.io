{"docKey":"0152_maximum_product_subarray","code":"from typing import List\nfrom math import inf\n\nclass Solution:\n    \"\"\"\n    152. 乘积最大子数组 - 动态规划\n\n    核心思想：\n    由于负数的存在，最小值可能转瞬变成最大值。\n    所以需要同时维护以当前位置结尾的最大乘积和最小乘积。\n\n    时间复杂度：O(n)\n    空间复杂度：O(1)\n    \"\"\"\n\n    def maxProduct(self, nums: List[int]) -> int:\n        ans = -inf\n        f_max = 1\n        f_min = 1\n\n        for x in nums:\n            # 同时更新最大和最小乘积\n            f_max, f_min = max(f_max * x, f_min * x, x), \\\n                           min(f_max * x, f_min * x, x)\n            ans = max(ans, f_max)\n\n        return int(ans)","method":"maxProduct","paramNames":["nums"],"args":["[2,3,-2,4]"],"expected":"6","result":6,"events":[{"line":17,"locals":{"nums":[2,3,-2,4]},"depth":1},{"line":18,"locals":{"nums":[2,3,-2,4],"ans":null},"depth":1},{"line":19,"locals":{"nums":[2,3,-2,4],"ans":null,"f_max":1},"depth":1},{"line":21,"locals":{"nums":[2,3,-2,4],"ans":null,"f_max":1,"f_min":1},"depth":1},{"line":23,"locals":{"nums":[2,3,-2,4],"ans":null,"f_max":1,"f_min":1,"x":2},"depth":1},{"line":24,"locals":{"nums":[2,3,-2,4],"ans":null,"f_max":1,"f_min":1,"x":2},"depth":1},{"line":23,"locals":{"nums":[2,3,-2,4],"ans":null,"f_max":1,"f_min":1,"x":2},"depth":1},{"line":25,"locals":{"nums":[2,3,-2,4],"ans":null,"f_max":2,"f_min":2,"x":2},"depth":1},{"line":21,"locals":{"nums":[2,3,-2,4],"ans":2,"f_max":2,"f_min":2,"x":2},"depth":1},{"line":23,"locals":{"nums":[2,3,-2,4],"ans":2,"f_max":2,"f_min":2,"x":3},"depth":1},{"line":24,"locals":{"nums":[2,3,-2,4],"ans":2,"f_max":2,"f_min":2,"x":3},"depth":1},{"line":23,"locals":{"nums":[2,3,-2,4],"ans":2,"f_max":2,"f_min":2,"x":3},"depth":1},{"line":25,"locals":{"nums":[2,3,-2,4],"ans":2,"f_max":6,"f_min":3,"x":3},"depth":1},{"line":21,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":6,"f_min":3,"x":3},"depth":1},{"line":23,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":6,"f_min":3,"x":-2},"depth":1},{"line":24,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":6,"f_min":3,"x":-2},"depth":1},{"line":23,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":6,"f_min":3,"x":-2},"depth":1},{"line":25,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":-2,"f_min":-12,"x":-2},"depth":1},{"line":21,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":-2,"f_min":-12,"x":-2},"depth":1},{"line":23,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":-2,"f_min":-12,"x":4},"depth":1},{"line":24,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":-2,"f_min":-12,"x":4},"depth":1},{"line":23,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":-2,"f_min":-12,"x":4},"depth":1},{"line":25,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":4,"f_min":-48,"x":4},"depth":1},{"line":21,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":4,"f_min":-48,"x":4},"depth":1},{"line":27,"locals":{"nums":[2,3,-2,4],"ans":6,"f_max":4,"f_min":-48,"x":4},"depth":1}]}