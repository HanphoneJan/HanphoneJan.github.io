{"docKey":"HJ48.从单向链表中删除指定值的节点","code":"import sys\n\n\ndef solve():\n    data = list(map(int, sys.stdin.readline().split()))\n    n = data[0]               # 节点总数\n    head = data[1]            # 头节点值\n    target = data[-1]         # 要删除的节点值\n\n    # 初始只有头节点，之后按输入顺序一组组插进来\n    lst = [head]\n\n    # 从索引 2 开始，每两个数一组；共 n-1 组，所以上界是 2*n\n    for i in range(2, 2 * n, 2):\n        a = data[i]           # 待插入节点的值\n        b = data[i + 1]       # 目标节点的值\n        index_b = lst.index(b)\n        # +1 表示插在 b 的后面；用 index_b 会把 b 自己挤到后面去\n        lst.insert(index_b + 1, a)\n\n    lst.remove(target)\n\n    # 题目要求每个值后面都跟一个空格，包括最后一个值\n    for val in lst:\n        print(val, end=' ')\n    print()\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"5 2 3 2 4 3 5 2 1 4 3","expected":"2 5 4 1","result":null,"events":[{"line":5,"locals":{},"depth":1},{"line":6,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3]},"depth":1},{"line":7,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5},"depth":1},{"line":8,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5,"head":2},"depth":1},{"line":11,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5,"head":2,"target":3},"depth":1},{"line":14,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5,"head":2,"target":3,"lst":[2]},"depth":1},{"line":15,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5,"head":2,"target":3,"lst":[2],"i":2},"depth":1},{"line":16,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5,"head":2,"target":3,"lst":[2],"i":2,"a":3},"depth":1},{"line":17,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5,"head":2,"target":3,"lst":[2],"i":2,"a":3,"b":2},"depth":1},{"line":19,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5,"head":2,"target":3,"lst":[2],"i":2,"a":3,"b":2,"index_b":0},"depth":1},{"line":14,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5,"head":2,"target":3,"lst":[2,3],"i":2,"a":3,"b":2,"index_b":0},"depth":1},{"line":15,"locals":{"data":[5,2,3,2,4,3,5,2,1,4,3],"n":5,"head":2,"target":3,"lst":[2,3],"i":4,"a":3,"b":2,"inde