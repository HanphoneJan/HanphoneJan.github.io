{"docKey":"BM82.买卖股票的最好时机(三)","code":"from typing import List\n\nNEG = float('-inf')\n\n\nclass Solution:\n    def maxProfit(self, prices: List[int]) -> int:\n        \"\"\"最多两笔交易：四状态滚动 DP\"\"\"\n        buy1 = sell1 = buy2 = sell2 = NEG\n        for p in prices:\n            buy1 = max(buy1, -p)             # 第一次买入：账面 -p\n            sell1 = max(sell1, buy1 + p)     # 第一次卖出\n            buy2 = max(buy2, sell1 - p)      # 第二次买入\n            sell2 = max(sell2, buy2 + p)     # 第二次卖出\n        return max(sell2, 0)","method":"maxProfit","paramNames":["prices"],"args":["[8,9,3,5,1,3]"],"expected":"4","result":4,"events":[{"line":9,"locals":{"prices":[8,9,3,5,1,3]},"depth":1},{"line":10,"locals":{"prices":[8,9,3,5,1,3],"buy1":null,"sell1":null,"buy2":null,"sell2":null},"depth":1},{"line":11,"locals":{"prices":[8,9,3,5,1,3],"buy1":null,"sell1":null,"buy2":null,"sell2":null,"p":8},"depth":1},{"line":12,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":null,"buy2":null,"sell2":null,"p":8},"depth":1},{"line":13,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":0,"buy2":null,"sell2":null,"p":8},"depth":1},{"line":14,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":0,"buy2":-8,"sell2":null,"p":8},"depth":1},{"line":10,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":0,"buy2":-8,"sell2":0,"p":8},"depth":1},{"line":11,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":0,"buy2":-8,"sell2":0,"p":9},"depth":1},{"line":12,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":0,"buy2":-8,"sell2":0,"p":9},"depth":1},{"line":13,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":1,"buy2":-8,"sell2":0,"p":9},"depth":1},{"line":14,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":1,"buy2":-8,"sell2":0,"p":9},"depth":1},{"line":10,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":1,"buy2":-8,"sell2":1,"p":9},"depth":1},{"line":11,"locals":{"prices":[8,9,3,5,1,3],"buy1":-8,"sell1":1,"buy2":-8,"sell2":1,"p":3},"depth":1},{"line":12,"locals":{"prices":[8,9,3,5,1,3],"buy1":-3,"sell1":1,"buy