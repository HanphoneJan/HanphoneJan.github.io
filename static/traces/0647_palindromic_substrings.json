{"docKey":"0647_palindromic_substrings","code":"class Solution:\n    def countSubstrings(self, s: str) -> int:\n        # 改造串：^ 与 $ 是哨兵，# 把字符中心与缝隙中心都变成奇回文中心\n        t = \"#\".join(\"^\" + s + \"$\")\n        n = len(t)\n\n        half = [0] * (n - 2)      # 只存真正中心（去掉两个哨兵）\n        half[1] = 1\n        ans = 0\n        box_m = box_r = 0         # 当前最右回文盒的中心与右边界（开区间）\n\n        for i in range(2, len(half)):\n            hl = 1\n            if i < box_r:\n                # 盒内：镜像半径与「到盒右边界」取较小者作为起步\n                hl = min(half[box_m * 2 - i], box_r - i)\n\n            # 只有超出盒子的部分需要真正比较\n            while t[i - hl] == t[i + hl]:\n                hl += 1\n                box_m, box_r = i, i + hl\n\n            half[i] = hl\n            ans += hl // 2        # 半径每多 1，原串多一层回文\n\n        return ans","method":"countSubstrings","paramNames":["s"],"args":["\"abc\""],"expected":"3","result":3,"events":[{"line":4,"locals":{"s":"abc"},"depth":1},{"line":5,"locals":{"s":"abc","t":"^#a#b#c#$"},"depth":1},{"line":7,"locals":{"s":"abc","t":"^#a#b#c#$","n":9},"depth":1},{"line":8,"locals":{"s":"abc","t":"^#a#b#c#$","n":9,"half":[0,0,0,0,0,0,0]},"depth":1},{"line":9,"locals":{"s":"abc","t":"^#a#b#c#$","n":9,"half":[0,1,0,0,0,0,0]},"depth":1},{"line":10,"locals":{"s":"abc","t":"^#a#b#c#$","n":9,"half":[0,1,0,0,0,0,0],"ans":0},"depth":1},{"line":12,"locals":{"s":"abc","t":"^#a#b#c#$","n":9,"half":[0,1,0,0,0,0,0],"ans":0,"box_m":0,"box_r":0},"depth":1},{"line":13,"locals":{"s":"abc","t":"^#a#b#c#$","n":9,"half":[0,1,0,0,0,0,0],"ans":0,"box_m":0,"box_r":0,"i":2},"depth":1},{"line":14,"locals":{"s":"abc","t":"^#a#b#c#$","n":9,"half":[0,1,0,0,0,0,0],"ans":0,"box_m":0,"box_r":0,"i":2,"hl":1},"depth":1},{"line":19,"locals":{"s":"abc","t":"^#a#b#c#$","n":9,"half":[0,1,0,0,0,0,0],"ans":0,"box_m":0,"box_r":0,"i":2,"hl":1},"depth":1},{"line":20,"locals":{"s":"abc","t":"^#a#b#c#$","n":9,"half":[0,1,0,0,0,0,0],"ans":0,"box_m":0,"box_r":0,"i":2,"hl":1},"depth":1},{"line":21,"locals":{"s":"abc","t":"