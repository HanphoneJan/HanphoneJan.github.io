{"docKey":"0073_set_matrix_zeroes","code":"from typing import List\n\nclass Solution:\n    def setZeroes(self, matrix: List[List[int]]) -> None:\n        m, n = len(matrix), len(matrix[0])\n\n        # 第一步：第一行 / 第一列本身有没有 0\n        first_row_has_zero = any(matrix[0][j] == 0 for j in range(n))\n        first_col_has_zero = any(matrix[i][0] == 0 for i in range(m))\n\n        # 第二步：全矩阵打标记\n        for i in range(m):\n            for j in range(n):\n                if matrix[i][j] == 0:\n                    matrix[i][0] = 0\n                    matrix[0][j] = 0\n\n        # 第三步：按标记置零，第一行 / 第一列留到最后\n        for i in range(1, m):\n            for j in range(1, n):\n                if matrix[i][0] == 0 or matrix[0][j] == 0:\n                    matrix[i][j] = 0\n\n        # 第四步：用布尔值处理第一行 / 第一列\n        if first_row_has_zero:\n            for j in range(n):\n                matrix[0][j] = 0\n        if first_col_has_zero:\n            for i in range(m):\n                matrix[i][0] = 0","method":"setZeroes","paramNames":["matrix"],"args":["[[1,1,1],[1,0,1],[1,1,1]]"],"expected":"[[1,0,1],[0,0,0],[1,0,1]]","result":null,"events":[{"line":5,"locals":{"matrix":[[1,1,1],[1,0,1],[1,1,1]]},"depth":1},{"line":8,"locals":{"matrix":[[1,1,1],[1,0,1],[1,1,1]],"m":3,"n":3},"depth":1},{"line":8,"locals":{".0":"<range_iterator>","matrix":[[1,1,1],[1,0,1],[1,1,1]]},"depth":2},{"line":8,"locals":{"matrix":[[1,1,1],[1,0,1],[1,1,1]],"m":3,"n":3},"depth":1},{"line":8,"locals":{".0":"<range_iterator>","j":0,"matrix":[[1,1,1],[1,0,1],[1,1,1]]},"depth":2},{"line":8,"locals":{"matrix":[[1,1,1],[1,0,1],[1,1,1]],"m":3,"n":3},"depth":1},{"line":8,"locals":{".0":"<range_iterator>","j":1,"matrix":[[1,1,1],[1,0,1],[1,1,1]]},"depth":2},{"line":8,"locals":{"matrix":[[1,1,1],[1,0,1],[1,1,1]],"m":3,"n":3},"depth":1},{"line":8,"locals":{".0":"<range_iterator>","j":2,"matrix":[[1,1,1],[1,0,1],[1,1,1]]},"depth":2},{"line":9,"locals":{"matrix":[[1,1,1],[1,0,1],[1,1,1]],"m":3,"n":3,"first_row_has_zero":false},