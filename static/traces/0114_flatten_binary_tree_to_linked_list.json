{"docKey":"0114_flatten_binary_tree_to_linked_list","code":"class TreeNode:\n    def __init__(self, val=0, left=None, right=None):\n        self.val = val\n        self.left = left\n        self.right = right\n\nclass Solution:\n    \"\"\"\n    二叉树展开为链表 - O(1)空间复杂度\n\n    核心思想：\n    使用 Morris 遍历的变种，将二叉树原地展开为链表。\n\n    算法步骤：\n    1. 对于当前节点curr，如果它有左子树：\n       a. 找到左子树的最右节点（前驱节点）\n       b. 将curr的右子树接到前驱节点的右边\n       c. 将curr的左子树变为右子树，左子树置空\n    2. curr移动到右子节点\n\n    时间复杂度：O(n)\n    空间复杂度：O(1)\n    \"\"\"\n\n    def flatten(self, root: TreeNode) -> None:\n        curr = root\n        while curr:\n            if curr.left:\n                # 找到左子树的最右节点\n                predecessor = curr.left\n                while predecessor.right:\n                    predecessor = predecessor.right\n\n                # 将右子树接到前驱节点右边\n                predecessor.right = curr.right\n\n                # 左子树移到右边\n                curr.right = curr.left\n                curr.left = None\n\n            curr = curr.right","method":"flatten","paramNames":["root"],"argKinds":["tree"],"args":["[1,2,5,3,4,None,6]"],"expected":"[1,null,2,null,3,null,4,null,5,null,6]","result":null,"events":[{"line":26,"locals":{"root":{"$":"tree","v":[1,2,5,3,4,6,null]}},"depth":1},{"line":27,"locals":{"root":{"$":"tree","v":[1,2,5,3,4,6,null]},"curr":{"$":"tree","v":[1,2,5,3,4,6,null]}},"depth":1},{"line":28,"locals":{"root":{"$":"tree","v":[1,2,5,3,4,6,null]},"curr":{"$":"tree","v":[1,2,5,3,4,6,null]}},"depth":1},{"line":30,"locals":{"root":{"$":"tree","v":[1,2,5,3,4,6,null]},"curr":{"$":"tree","v":[1,2,5,3,4,6,null]}},"depth":1},{"line":31,"locals":{"root":{"$":"tree","v":[1,2,5,3,4,6,null]},"curr":{"$":"tree","v":[1,2,5,3,4,6,null]},"predecessor":{"$":"n","i":1,"v":2}},"depth":1},{"line":32,"locals":{"root":{"$":"tree","v":[1,2,5,3,4,6,null]},"curr":{"$":"tree","v":[1,2,5,3,4,6,null]},"predecessor":{"$":"n","i":1,"v":2}},"depth":1},{"line":31,"locals":{"root":{"$":"tree","v":[1,2,5,3,4,6,null]},"curr":{"$":