{"docKey":"min_token_allocation","code":"\"\"\"\n最小 Token 分配 - 贪心双遍历\n\n输入格式：\n- 一行：逗号分隔的整数 priorities\n\n输出格式：\n- 一个整数，表示最小 token 总数\n\"\"\"\n\nimport sys\n\ndef min_total_tokens(priorities):\n    \"\"\"计算满足条件的最小 token 总数\"\"\"\n    n = len(priorities)\n    tokens = [0] * n\n\n    i = 0\n    while i < n:\n        # 跳过非正数任务\n        if priorities[i] <= 0:\n            i += 1\n            continue\n\n        # 找到一个连续的正数段\n        start = i\n        while i < n and priorities[i] > 0:\n            i += 1\n        end = i\n\n        # 处理这一段 [start, end)\n        seg_len = end - start\n        seg_tokens = [1] * seg_len\n\n        # 从左到右：右侧优先级更高时递增\n        for j in range(start + 1, end):\n            if priorities[j] > priorities[j - 1]:\n                seg_tokens[j - start] = seg_tokens[j - start - 1] + 1\n\n        # 从右到左：左侧优先级更高时取最大值\n        for j in range(end - 2, start - 1, -1):\n            if priorities[j] > priorities[j + 1]:\n                seg_tokens[j - start] = max(\n                    seg_tokens[j - start],\n                    seg_tokens[j - start + 1] + 1\n                )\n\n        # 赋值回原数组\n        for j in range(start, end):\n            tokens[j] = seg_tokens[j - start]\n\n    return sum(tokens)\n\ndef main():\n    line = sys.stdin.readline().strip()\n    if not line:\n        print(0)\n        return\n    priorities = list(map(int, line.split(',')))\n    result = min_total_tokens(priorities)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()","method":"main","paramNames":[],"args":[],"stdin":"1,2,2","expected":"4","result":null,"events":[{"line":55,"locals":{},"depth":1},{"line":56,"locals":{"line":"1,2,2"},"depth":1},{"line":59,"locals":{"line":"1,2,2"},"depth":1},{"line":60,"locals":{"line":"1,2,2","priorities":[1,2,2]},"depth":1},{"line":15,"locals":{"priorities":[1,2,2]},"depth":2},{"line":16,"locals":{"priorities":[1,2,2],"n":3},"depth":2},{"line":18,"locals":{"priorities":[1,2,2],"n":3,"tokens":[0,0,0]},"depth":2},{"line":19,"