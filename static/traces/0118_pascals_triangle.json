{"docKey":"0118_pascals_triangle","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    118. 杨辉三角 - 动态规划\n\n    核心思想：\n    杨辉三角的每个数字都等于它上方两数之和。\n    1. 每行的第一个和最后一个元素为 1\n    2. 其他元素 = 上一行的前一列 + 上一行的当前列\n\n    时间复杂度：O(numRows²)\n    空间复杂度：O(numRows²)，存储结果\n    \"\"\"\n\n    def generate(self, numRows: int) -> List[List[int]]:\n        if numRows <= 0:\n            return []\n\n        triangle = []\n\n        for i in range(numRows):\n            # 创建当前行，初始化为1（首尾元素保持为1）\n            row = [1] * (i + 1)\n\n            # 计算中间元素\n            for j in range(1, i):\n                row[j] = triangle[i - 1][j - 1] + triangle[i - 1][j]\n\n            triangle.append(row)\n\n        return triangle","method":"generate","paramNames":["numRows"],"args":["5"],"expected":"[[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1]]","result":[[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1]],"events":[{"line":17,"locals":{"numRows":5},"depth":1},{"line":20,"locals":{"numRows":5},"depth":1},{"line":22,"locals":{"numRows":5,"triangle":[]},"depth":1},{"line":24,"locals":{"numRows":5,"triangle":[],"i":0},"depth":1},{"line":27,"locals":{"numRows":5,"triangle":[],"i":0,"row":[1]},"depth":1},{"line":30,"locals":{"numRows":5,"triangle":[],"i":0,"row":[1]},"depth":1},{"line":22,"locals":{"numRows":5,"triangle":[[1]],"i":0,"row":[1]},"depth":1},{"line":24,"locals":{"numRows":5,"triangle":[[1]],"i":1,"row":[1]},"depth":1},{"line":27,"locals":{"numRows":5,"triangle":[[1]],"i":1,"row":[1,1]},"depth":1},{"line":30,"locals":{"numRows":5,"triangle":[[1]],"i":1,"row":[1,1]},"depth":1},{"line":22,"locals":{"numRows":5,"triangle":[[1],[1,1]],"i":1,"row":[1,1]},"depth":1},{"line":24,"locals":{"numRows":5,"triangle":[[1],[1,1]],"i":2,"row":[1,1]},"depth":1},{"line":27,"locals":{"numRows":5,"triangle":[[1],[1,1]],"i":2,"row":[1,1,1]},"depth":1},{"line":28,"locals":{"numRows":5,"triangle":[[1],[1,1]],"i":2,"row":[1,1,1],"j":1},"depth":1},{"line":27,"locals":{"numRows":5,"triangle":[[1],[1,1]],"i":2,"row":[1,2,1],"j