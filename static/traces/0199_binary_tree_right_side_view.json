{"docKey":"0199_binary_tree_right_side_view","code":"from typing import List, Optional\n\n\nclass TreeNode:\n    def __init__(self, val=0, left=None, right=None):\n        self.val = val\n        self.left = left\n        self.right = right\n\n\nclass Solution:\n    def rightSideView(self, root: Optional[TreeNode]) -> List[int]:\n        ans = []\n\n        def dfs(node: Optional[TreeNode], depth: int) -> None:\n            if not node:\n                return\n            # 这个深度第一次到达：当前节点就是这一层最右\n            if depth == len(ans):\n                ans.append(node.val)\n            dfs(node.right, depth + 1)   # 先右，保证首次到达的是最右\n            dfs(node.left, depth + 1)\n\n        dfs(root, 0)\n        return ans","method":"rightSideView","paramNames":["root"],"argKinds":["tree"],"args":["[1,2,3,None,5,None,4]"],"expected":"[1,3,4]","result":[1,3,4],"events":[{"line":13,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":15,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"ans":[]},"depth":1},{"line":24,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"ans":[],"dfs":"<function>"},"depth":1},{"line":16,"locals":{"node":{"$":"tree","v":[1,2,3,5,4,null,null]},"depth":0,"ans":[],"dfs":"<function>"},"depth":2},{"line":19,"locals":{"node":{"$":"tree","v":[1,2,3,5,4,null,null]},"depth":0,"ans":[],"dfs":"<function>"},"depth":2},{"line":20,"locals":{"node":{"$":"tree","v":[1,2,3,5,4,null,null]},"depth":0,"ans":[],"dfs":"<function>"},"depth":2},{"line":21,"locals":{"node":{"$":"tree","v":[1,2,3,5,4,null,null]},"depth":0,"ans":[1],"dfs":"<function>"},"depth":2},{"line":16,"locals":{"node":{"$":"n","i":2,"v":3},"depth":1,"ans":[1],"dfs":"<function>"},"depth":3},{"line":19,"locals":{"node":{"$":"n","i":2,"v":3},"depth":1,"ans":[1],"dfs":"<function>"},"depth":3},{"line":20,"locals":{"node":{"$":"n","i":2,"v":3},"depth":1,"ans":[1],"dfs":"<function>"},"depth":3},{"line":21,"locals":{"node":{"$":"n","i":2,"v":3},"depth":1,"ans":[1,3],"dfs":"<function>