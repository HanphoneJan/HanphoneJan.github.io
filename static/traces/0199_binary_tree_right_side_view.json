{"docKey":"0199_binary_tree_right_side_view","code":"from typing import List, Optional\nfrom collections import deque\n\nclass Solution:\n    \"\"\"\n    二叉树的右视图 - BFS层序遍历\n\n    核心思路：\n    本质上是返回每一层最右侧的节点。\n    使用 BFS 层序遍历，对于每一层，最后一个出队的节点就是该层最右侧的节点。\n\n    时间复杂度：O(n)\n    空间复杂度：O(w) - w 为树的最大宽度\n    \"\"\"\n\n    def rightSideView(self, root: Optional[TreeNode]) -> List[int]:\n        if not root:\n            return []\n\n        result = []\n        queue = deque([root])\n\n        while queue:\n            current_level_size = len(queue)\n\n            for i in range(current_level_size):\n                node = queue.popleft()\n\n                # 当前层的最后一个节点，加入结果\n                if i == current_level_size - 1:\n                    result.append(node.val)\n\n                if node.left:\n                    queue.append(node.left)\n                if node.right:\n                    queue.append(node.right)\n\n        return result","method":"rightSideView","paramNames":["root"],"argKinds":["tree"],"args":["[1,2,3,None,5,None,4]"],"expected":"[1,3,4]","result":[1,3,4],"events":[{"line":17,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":20,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":21,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[]},"depth":1},{"line":23,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[],"queue":"<deque>"},"depth":1},{"line":24,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[],"queue":"<deque>"},"depth":1},{"line":26,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[],"queue":"<deque>","current_level_size":1},"depth":1},{"line":27,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[],"queue":"<deque>","current_level_size":1,"i":0},"depth":1},{"line":30,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[],"queue":"<deque>","current_level_size":1,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":31,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[],"queue":"<deque>","current_level_size":1,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":33,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":1,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":34,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":1,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":35,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":1,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":36,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":1,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":26,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":1,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":23,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":1,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":24,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":1,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":26,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":2,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":27,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":2,"i":0,"node":{"$":"tree","v":[1,2,3,5,4,null,null]}},"depth":1},{"line":30,"locals":{"root":{"$":"tree","v":[1,2,3,5,4,null,null]},"result":[1],"queue":"<deque>","current_level_size":2,"i":0,"no