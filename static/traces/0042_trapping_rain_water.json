{"docKey":"0042_trapping_rain_water","code":"from typing import List\n\n\nclass Solution:\n    def trap(self, height: List[int]) -> int:\n        left, right = 0, len(height) - 1\n        left_max = right_max = 0     # 两侧已经见过的最高柱子\n        ans = 0\n\n        while left < right:\n            if height[left] < height[right]:\n                # 右边一定有不低于 height[right] 的柱子，左侧瓶颈就是 left_max\n                left_max = max(left_max, height[left])\n                ans += left_max - height[left]\n                left += 1\n            else:\n                right_max = max(right_max, height[right])\n                ans += right_max - height[right]\n                right -= 1\n\n        return ans","method":"trap","paramNames":["height"],"args":["[4,2,0,3,2,5]"],"expected":"9","result":9,"events":[{"line":6,"locals":{"height":[4,2,0,3,2,5]},"depth":1},{"line":7,"locals":{"height":[4,2,0,3,2,5],"left":0,"right":5},"depth":1},{"line":8,"locals":{"height":[4,2,0,3,2,5],"left":0,"right":5,"left_max":0,"right_max":0},"depth":1},{"line":10,"locals":{"height":[4,2,0,3,2,5],"left":0,"right":5,"left_max":0,"right_max":0,"ans":0},"depth":1},{"line":11,"locals":{"height":[4,2,0,3,2,5],"left":0,"right":5,"left_max":0,"right_max":0,"ans":0},"depth":1},{"line":13,"locals":{"height":[4,2,0,3,2,5],"left":0,"right":5,"left_max":0,"right_max":0,"ans":0},"depth":1},{"line":14,"locals":{"height":[4,2,0,3,2,5],"left":0,"right":5,"left_max":4,"right_max":0,"ans":0},"depth":1},{"line":15,"locals":{"height":[4,2,0,3,2,5],"left":0,"right":5,"left_max":4,"right_max":0,"ans":0},"depth":1},{"line":10,"locals":{"height":[4,2,0,3,2,5],"left":1,"right":5,"left_max":4,"right_max":0,"ans":0},"depth":1},{"line":11,"locals":{"height":[4,2,0,3,2,5],"left":1,"right":5,"left_max":4,"right_max":0,"ans":0},"depth":1},{"line":13,"locals":{"height":[4,2,0,3,2,5],"left":1,"right":5,"left_max":4,"right_max":0,"ans":0},"depth":1},{"line":14,"locals":{"height":[4,2,0,3,2,5],"left":1,"right":5,"left_max":4,"right_max":0,"a