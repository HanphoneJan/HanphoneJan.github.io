{"docKey":"0042_trapping_rain_water","code":"from typing import List\n\nclass Solution:\n    def trap(self, height: List[int]) -> int:\n        ans = pre_max = suf_max = 0\n        left, right = 0, len(height) - 1\n\n        while left < right:\n            # 更新左侧已走过范围的最大高度\n            pre_max = max(pre_max, height[left])\n            # 更新右侧已走过范围的最大高度\n            suf_max = max(suf_max, height[right])\n\n            if pre_max < suf_max:\n                # 左侧是瓶颈，left 处的积水量由 pre_max 决定\n                ans += pre_max - height[left]\n                left += 1\n            else:\n                # 右侧是瓶颈，right 处的积水量由 suf_max 决定\n                ans += suf_max - height[right]\n                right -= 1\n\n        return ans","method":"trap","paramNames":["height"],"args":["[4,2,0,3,2,5]"],"expected":"9","result":9,"events":[{"line":5,"locals":{"height":[4,2,0,3,2,5]},"depth":1},{"line":6,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":0,"suf_max":0},"depth":1},{"line":8,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":0,"suf_max":0,"left":0,"right":5},"depth":1},{"line":10,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":0,"suf_max":0,"left":0,"right":5},"depth":1},{"line":12,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":4,"suf_max":0,"left":0,"right":5},"depth":1},{"line":14,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":4,"suf_max":5,"left":0,"right":5},"depth":1},{"line":16,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":4,"suf_max":5,"left":0,"right":5},"depth":1},{"line":17,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":4,"suf_max":5,"left":0,"right":5},"depth":1},{"line":8,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":4,"suf_max":5,"left":1,"right":5},"depth":1},{"line":10,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":4,"suf_max":5,"left":1,"right":5},"depth":1},{"line":12,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":4,"suf_max":5,"left":1,"right":5},"depth":1},{"line":14,"locals":{"height":[4,2,0,3,2,5],"ans":0,"pre_max":4,