{"docKey":"0011_container_with_most_water","code":"from typing import List\n\nclass Solution:\n    def maxArea(self, height: List[int]) -> int:\n        left = 0\n        right = len(height) - 1\n        max_area = 0\n        while left < right:\n            width = right - left\n            current_height = min(height[left], height[right])\n            max_area = max(max_area, width * current_height)\n            if height[left] < height[right]:\n                left += 1   # 左边更短，移动左指针寻找更高的左边界\n            else:\n                right -= 1  # 右边更短或相等，移动右指针\n        return max_area","method":"maxArea","paramNames":["height"],"args":["[1, 8, 6, 2, 5, 4, 8, 3, 7]"],"expected":"49","result":49,"events":[{"line":5,"locals":{"height":[1,8,6,2,5,4,8,3,7]},"depth":1},{"line":6,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0},"depth":1},{"line":7,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8},"depth":1},{"line":8,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"max_area":0},"depth":1},{"line":9,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"max_area":0},"depth":1},{"line":10,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"max_area":0,"width":8},"depth":1},{"line":11,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"max_area":0,"width":8,"current_height":1},"depth":1},{"line":12,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"max_area":8,"width":8,"current_height":1},"depth":1},{"line":13,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"max_area":8,"width":8,"current_height":1},"depth":1},{"line":8,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":8,"max_area":8,"width":8,"current_height":1},"depth":1},{"line":9,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":8,"max_area":8,"width":8,"current_height":1},"depth":1},{"line":10,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":8,"max_area":8,"width":7,"current_height":1},"depth":1},{"line":11,"locals":{"height":[1,8,6,2,5,4,8,3,7],"l