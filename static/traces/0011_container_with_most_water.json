{"docKey":"0011_container_with_most_water","code":"from typing import List\n\n\nclass Solution:\n    def maxArea(self, height: List[int]) -> int:\n        left, right = 0, len(height) - 1\n        ans = 0\n        while left < right:\n            # 面积取较矮的那根：水会从矮的一侧溢出\n            ans = max(ans, (right - left) * min(height[left], height[right]))\n            # 丢掉较矮的一根，它已经不可能再贡献更大的面积\n            if height[left] < height[right]:\n                left += 1\n            else:\n                right -= 1\n        return ans","method":"maxArea","paramNames":["height"],"args":["[1,8,6,2,5,4,8,3,7]"],"expected":"49","result":49,"events":[{"line":6,"locals":{"height":[1,8,6,2,5,4,8,3,7]},"depth":1},{"line":7,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8},"depth":1},{"line":8,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"ans":0},"depth":1},{"line":10,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"ans":0},"depth":1},{"line":12,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"ans":8},"depth":1},{"line":13,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":0,"right":8,"ans":8},"depth":1},{"line":8,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":8,"ans":8},"depth":1},{"line":10,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":8,"ans":8},"depth":1},{"line":12,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":8,"ans":49},"depth":1},{"line":15,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":8,"ans":49},"depth":1},{"line":8,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":7,"ans":49},"depth":1},{"line":10,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":7,"ans":49},"depth":1},{"line":12,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":7,"ans":49},"depth":1},{"line":15,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":7,"ans":49},"depth":1},{"line":8,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"right":6,"ans":49},"depth":1},{"line":10,"locals":{"height":[1,8,6,2,5,4,8,3,7],"left":1,"r