{"docKey":"小美的修路","code":"import sys\n\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n\n    plans = []\n    for idx in range(1, m + 1):\n        u = int(next(it))\n        v = int(next(it))\n        w = int(next(it))\n        required = int(next(it))\n        plans.append((w, required, u, v, idx))\n\n    parent = list(range(n + 1))\n\n    def find(x: int) -> int:\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]   # 路径压缩\n            x = parent[x]\n        return x\n\n    def union(a: int, b: int) -> bool:\n        ra, rb = find(a), find(b)\n        if ra == rb:\n            return False\n        parent[ra] = rb\n        return True\n\n    chosen = []\n\n    # 必选计划：无条件收下，成环也要收\n    for w, required, u, v, idx in plans:\n        if required == 1:\n            union(u, v)\n            chosen.append(idx)\n\n    # 可选计划：按花费升序做 Kruskal\n    for w, required, u, v, idx in sorted(plans):\n        if required == 0 and union(u, v):\n            chosen.append(idx)\n\n    # 所有城市必须连通\n    root = find(1)\n    if any(find(city) != root for city in range(2, n + 1)):\n        sys.stdout.write(\"-1\\n\")\n        return\n\n    chosen.sort()\n    sys.stdout.write(str(len(chosen)) + \"\\n\")\n    sys.stdout.write(\" \".join(map(str, chosen)) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"3 4\n1 2 3 1\n1 2 2 0\n1 3 1 0\n2 3 3 0","expected":"2\n1 3","result":null,"events":[{"line":5,"locals":{},"depth":1},{"line":6,"locals":{"data":["3","4","1","2","3","1","1","2","2","0","1","3","1","0","2","3","3","0"]},"depth":1},{"line":8,"locals":{"data":["3","4","1","2","3","1","1","2","2","0","1","3","1","0","2","3","3","0"]},"depth":1},{"line":9,"locals":{"data":["3","4","1","2","3","1","1","2","2","0","1","3","1","0","2","3","3","0"],"it":"<list_iterator>"},"depth":1},{"line":10,"locals":{"