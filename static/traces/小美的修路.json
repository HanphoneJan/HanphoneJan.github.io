{"docKey":"小美的修路","code":"import sys\n\n\ndef solve() -> None:\n    \"\"\"并查集：必选边无条件加入，可选边按花费贪心\"\"\"\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    idx = 0\n    n = int(data[idx]); m = int(data[idx + 1]); idx += 2\n\n    edges = []\n    for i in range(1, m + 1):\n        u = int(data[idx]); v = int(data[idx + 1])\n        w = int(data[idx + 2]); req = int(data[idx + 3])\n        idx += 4\n        edges.append((u, v, w, req, i))\n\n    parent = list(range(n + 1))\n\n    def find(x: int) -> int:\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]   # 路径压缩\n            x = parent[x]\n        return x\n\n    def union(x: int, y: int) -> bool:\n        rx, ry = find(x), find(y)\n        if rx == ry:\n            return False\n        parent[rx] = ry\n        return True\n\n    chosen = []\n    # 1. 必选边全部加入\n    for u, v, w, req, i in edges:\n        if req == 1:\n            union(u, v)\n            chosen.append(i)\n\n    # 2. 可选边按花费升序，Kruskal\n    for u, v, w, req, i in sorted(edges, key=lambda e: e[2]):\n        if req == 0 and union(u, v):\n            chosen.append(i)\n\n    # 3. 判断是否连通\n    root = find(1)\n    for city in range(2, n + 1):\n        if find(city) != root:\n            sys.stdout.write(\"-1\\n\")\n            return\n\n    chosen.sort()\n    sys.stdout.write(str(len(chosen)) + \"\\n\" + \" \".join(map(str, chosen)) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"3 4\n1 2 3 1\n1 2 2 0\n1 3 1 0\n2 3 3 0","expected":"2\n1 3","result":null,"events":[{"line":6,"locals":{},"depth":1},{"line":7,"locals":{"data":["3","4","1","2","3","1","1","2","2","0","1","3","1","0","2","3","3","0"]},"depth":1},{"line":9,"locals":{"data":["3","4","1","2","3","1","1","2","2","0","1","3","1","0","2","3","3","0"]},"depth":1},{"line":10,"locals":{"data":["3","4","1","2","3","1","1","2","2","0","1","3","1","0","2","3","3","0"],"idx":0},"depth":1},{"line":12,"locals"