{"docKey":"0139_word_break","code":"from typing import List\nfrom functools import lru_cache\n\nclass Solution:\n    \"\"\"\n    139. 单词拆分 - 记忆化搜索\n\n    核心思想：\n    从位置 k 开始枚举所有结束位置，如果子串在字典中，递归检查剩余部分。\n    使用 lru_cache 避免重复计算同一位置的结果。\n\n    时间复杂度：O(m²)\n    空间复杂度：O(m)\n    \"\"\"\n\n    def wordBreak(self, s: str, wordDict: List[str]) -> bool:\n        # 字符剪枝：s 里出现过的字符，字典里至少得有一个单词含它。\n        #\n        # 只能比**集合**，不能比次数 —— 单词可以重复使用，\n        # \"applepenapple\" 用 apple + pen + apple 拆得开，\n        # 而 apple + pen 里只有 1 个 a，比次数会把它误判成无解。\n        dict_chars = set()\n        for word in wordDict:\n            dict_chars.update(word)\n        if set(s) - dict_chars:\n            return False\n\n        m = len(s)\n        word_set = set(wordDict)\n        ans = False\n\n        @lru_cache(maxsize=None)\n        def dfs(k: int):\n            nonlocal ans\n            if k == m:\n                ans = True\n                return\n            if ans:\n                return\n            path = \"\"\n            for i in range(k, m):\n                path += s[i]\n                if path in word_set:\n                    dfs(i + 1)\n                    if ans:\n                        return\n\n        dfs(0)\n        return ans","method":"wordBreak","paramNames":["s","wordDict"],"args":["\"catsandog\"","[\"cats\", \"dog\", \"sand\", \"and\", \"cat\"]"],"expected":"false","result":false,"events":[{"line":22,"locals":{"s":"catsandog","wordDict":["cats","dog","sand","and","cat"]},"depth":1},{"line":23,"locals":{"s":"catsandog","wordDict":["cats","dog","sand","and","cat"],"dict_chars":[]},"depth":1},{"line":24,"locals":{"s":"catsandog","wordDict":["cats","dog","sand","and","cat"],"dict_chars":[],"word":"cats"},"depth":1},{"line":23,"locals":{"s":"catsandog","wordDict":["cats","dog","sand","and","cat"],"dict_chars":["a","s","c","t"],"word":"cats"},"depth":1},{"line":24,"locals":{"s":"catsandog","wordDict":["cats","dog","sand","and","cat"],"dict_chars":["a","s","c","t"],"word":