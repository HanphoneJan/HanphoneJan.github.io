{"docKey":"HJ178.模板双指针","code":"import sys\n\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    n = int(data[0])\n    arr = list(map(int, data[1:1 + n]))\n\n    last_pos = {}       # 元素 -> 最近一次出现的位置\n    left = 0            # 窗口左端点\n    best = 0\n    intervals = []\n\n    for right in range(n):\n        v = arr[right]\n        # 若 v 在窗口内已出现，则左指针移到其上一次出现位置的下一个\n        if v in last_pos and last_pos[v] >= left:\n            left = last_pos[v] + 1\n        last_pos[v] = right\n\n        cur_len = right - left + 1\n        if cur_len > best:\n            best = cur_len\n            intervals = [(left + 1, right + 1)]   # 转 1 基\n        elif cur_len == best:\n            intervals.append((left + 1, right + 1))\n\n    print(len(intervals))\n    for l, r in intervals:\n        print(l, r)\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"6\n1 1 4 5 1 4","expected":"3\n2 4\n3 5\n4 6","result":null,"events":[{"line":5,"locals":{},"depth":1},{"line":6,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"]},"depth":1},{"line":7,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"n":6},"depth":1},{"line":9,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"n":6,"arr":[1,1,4,5,1,4]},"depth":1},{"line":10,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"n":6,"arr":[1,1,4,5,1,4],"last_pos":{}},"depth":1},{"line":11,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"n":6,"arr":[1,1,4,5,1,4],"last_pos":{},"left":0},"depth":1},{"line":12,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"n":6,"arr":[1,1,4,5,1,4],"last_pos":{},"left":0,"best":0},"depth":1},{"line":14,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"n":6,"arr":[1,1,4,5,1,4],"last_po