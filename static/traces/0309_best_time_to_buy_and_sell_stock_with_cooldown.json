{"docKey":"0309_best_time_to_buy_and_sell_stock_with_cooldown","code":"from math import inf\nfrom typing import List\n\n\nclass Solution:\n    def maxProfit(self, prices: List[int]) -> int:\n        # pre0: 前天收盘不持股的利润；f0: 今天收盘不持股；f1: 今天收盘持股\n        pre0, f0, f1 = 0, 0, -inf\n        for p in prices:\n            # 买入只能从「前天不持股」来，这一项就是冷冻期\n            pre0, f0, f1 = f0, max(f0, f1 + p), max(f1, pre0 - p)\n        return f0","method":"maxProfit","paramNames":["prices"],"args":["[1,2,3,0,2]"],"expected":"3","result":3,"events":[{"line":8,"locals":{"prices":[1,2,3,0,2]},"depth":1},{"line":9,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":null},"depth":1},{"line":11,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":null,"p":1},"depth":1},{"line":9,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":-1,"p":1},"depth":1},{"line":11,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":-1,"p":2},"depth":1},{"line":9,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":1,"f1":-1,"p":2},"depth":1},{"line":11,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":1,"f1":-1,"p":3},"depth":1},{"line":9,"locals":{"prices":[1,2,3,0,2],"pre0":1,"f0":2,"f1":-1,"p":3},"depth":1},{"line":11,"locals":{"prices":[1,2,3,0,2],"pre0":1,"f0":2,"f1":-1,"p":0},"depth":1},{"line":9,"locals":{"prices":[1,2,3,0,2],"pre0":2,"f0":2,"f1":1,"p":0},"depth":1},{"line":11,"locals":{"prices":[1,2,3,0,2],"pre0":2,"f0":2,"f1":1,"p":2},"depth":1},{"line":9,"locals":{"prices":[1,2,3,0,2],"pre0":2,"f0":3,"f1":1,"p":2},"depth":1},{"line":12,"locals":{"prices":[1,2,3,0,2],"pre0":2,"f0":3,"f1":1,"p":2},"depth":1}]}