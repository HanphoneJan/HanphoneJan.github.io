{"docKey":"0309_best_time_to_buy_and_sell_stock_with_cooldown","code":"from typing import List\nfrom math import inf\n\nclass Solution:\n    def maxProfit(self, prices: List[int]) -> int:\n        # f0: 当前不持有股票的最大利润\n        # f1: 当前持有股票的最大利润\n        # pre0: 前一天不持有股票的最大利润（用于判断冷冻期）\n        pre0, f0, f1 = 0, 0, -inf\n        \n        for p in prices:\n            # 记录当前 f0，它将成为下一轮循环的 pre0\n            new_f0 = max(f0, f1 + p)\n            new_f1 = max(f1, pre0 - p)\n            \n            # 更新状态\n            pre0 = f0\n            f0 = new_f0\n            f1 = new_f1\n            \n        return f0","method":"maxProfit","paramNames":["prices"],"args":["[1,2,3,0,2]"],"expected":"3","result":3,"events":[{"line":9,"locals":{"prices":[1,2,3,0,2]},"depth":1},{"line":11,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":null},"depth":1},{"line":13,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":null,"p":1},"depth":1},{"line":14,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":null,"p":1,"new_f0":0},"depth":1},{"line":17,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":null,"p":1,"new_f0":0,"new_f1":-1},"depth":1},{"line":18,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":null,"p":1,"new_f0":0,"new_f1":-1},"depth":1},{"line":19,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":null,"p":1,"new_f0":0,"new_f1":-1},"depth":1},{"line":11,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":-1,"p":1,"new_f0":0,"new_f1":-1},"depth":1},{"line":13,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":-1,"p":2,"new_f0":0,"new_f1":-1},"depth":1},{"line":14,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":-1,"p":2,"new_f0":1,"new_f1":-1},"depth":1},{"line":17,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":-1,"p":2,"new_f0":1,"new_f1":-1},"depth":1},{"line":18,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":0,"f1":-1,"p":2,"new_f0":1,"new_f1":-1},"depth":1},{"line":19,"locals":{"prices":[1,2,3,0,2],"pre0":0,"f0":1,"f1":-1,"p":2,"new_f0":1,"new_f1":-1},"depth":1}