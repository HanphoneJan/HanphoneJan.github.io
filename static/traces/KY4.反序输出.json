{"docKey":"KY4.反序输出","code":"import sys\n\n\ndef solve():\n    # 用例组数未知，一行一组，一直读到文件结束\n    for line in sys.stdin:\n        # 先去掉 Unix 的换行 '\\n'，再去掉 Windows 的回车 '\\r'\n        s = line.rstrip('\\n').rstrip('\\r')\n        # 步长 -1 从末尾往前走，逐字符取出即得反序字符串\n        print(s[::-1])\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"Upin\ncvYj\nWJpw\ncXOA","expected":"nipU\njYvc\nwpJW\nAOXc","result":null,"events":[{"line":6,"locals":{},"depth":1},{"line":8,"locals":{"line":"Upin\n"},"depth":1},{"line":10,"locals":{"line":"Upin\n","s":"Upin"},"depth":1},{"line":6,"locals":{"line":"Upin\n","s":"Upin"},"depth":1},{"line":8,"locals":{"line":"cvYj\n","s":"Upin"},"depth":1},{"line":10,"locals":{"line":"cvYj\n","s":"cvYj"},"depth":1},{"line":6,"locals":{"line":"cvYj\n","s":"cvYj"},"depth":1},{"line":8,"locals":{"line":"WJpw\n","s":"cvYj"},"depth":1},{"line":10,"locals":{"line":"WJpw\n","s":"WJpw"},"depth":1},{"line":6,"locals":{"line":"WJpw\n","s":"WJpw"},"depth":1},{"line":8,"locals":{"line":"cXOA","s":"WJpw"},"depth":1},{"line":10,"locals":{"line":"cXOA","s":"cXOA"},"depth":1},{"line":6,"locals":{"line":"cXOA","s":"cXOA"},"depth":1}]}