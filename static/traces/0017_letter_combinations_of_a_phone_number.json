{"docKey":"0017_letter_combinations_of_a_phone_number","code":"from typing import List\n\nMAPPING = [\"\", \"\", \"abc\", \"def\", \"ghi\", \"jkl\", \"mno\", \"pqrs\", \"tuv\", \"wxyz\"]\n\n\nclass Solution:\n    def letterCombinations(self, digits: str) -> List[str]:\n        n = len(digits)\n        if n == 0:\n            return []\n\n        ans = []\n        path = [''] * n                  # 固定 n 个槽位，逐位覆盖\n\n        def dfs(i: int) -> None:\n            if i == n:\n                ans.append(''.join(path))\n                return\n            for c in MAPPING[int(digits[i])]:\n                path[i] = c              # ① 落章\n                dfs(i + 1)               # ② 交给下一位\n\n        dfs(0)\n        return ans","method":"letterCombinations","paramNames":["digits"],"args":["\"23\""],"expected":"[\"ad\",\"ae\",\"af\",\"bd\",\"be\",\"bf\",\"cd\",\"ce\",\"cf\"]","result":["ad","ae","af","bd","be","bf","cd","ce","cf"],"events":[{"line":8,"locals":{"digits":"23"},"depth":1},{"line":9,"locals":{"digits":"23","n":2},"depth":1},{"line":12,"locals":{"digits":"23","n":2},"depth":1},{"line":13,"locals":{"digits":"23","ans":[],"n":2},"depth":1},{"line":15,"locals":{"digits":"23","ans":[],"n":2,"path":["",""]},"depth":1},{"line":23,"locals":{"digits":"23","ans":[],"dfs":"<function>","n":2,"path":["",""]},"depth":1},{"line":16,"locals":{"i":0,"ans":[],"dfs":"<function>","digits":"23","n":2,"path":["",""]},"depth":2},{"line":19,"locals":{"i":0,"ans":[],"dfs":"<function>","digits":"23","n":2,"path":["",""]},"depth":2},{"line":20,"locals":{"i":0,"c":"a","ans":[],"dfs":"<function>","digits":"23","n":2,"path":["",""]},"depth":2},{"line":21,"locals":{"i":0,"c":"a","ans":[],"dfs":"<function>","digits":"23","n":2,"path":["a",""]},"depth":2},{"line":16,"locals":{"i":1,"ans":[],"dfs":"<function>","digits":"23","n":2,"path":["a",""]},"depth":3},{"line":19,"locals":{"i":1,"ans":[],"dfs":"<function>","digits":"23","n":2,"path":["a",""]},"depth":3},{"line":20,"locals":{"i":1,"c":"d","an