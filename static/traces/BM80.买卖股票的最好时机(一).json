{"docKey":"BM80.买卖股票的最好时机(一)","code":"from typing import List\n\n\nclass Solution:\n    def maxProfit(self, prices: List[int]) -> int:\n        \"\"\"一次交易：维护历史最低价，更新最大利润\"\"\"\n        min_price = float('inf')\n        best = 0\n        for p in prices:\n            min_price = min(min_price, p)      # 到当天为止的最低价\n            best = max(best, p - min_price)    # 今天卖出的最大收益\n        return best","method":"maxProfit","paramNames":["prices"],"args":["[8,9,2,5,4,7,1]"],"expected":"5","result":5,"events":[{"line":7,"locals":{"prices":[8,9,2,5,4,7,1]},"depth":1},{"line":8,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":null},"depth":1},{"line":9,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":null,"best":0},"depth":1},{"line":10,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":null,"best":0,"p":8},"depth":1},{"line":11,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":8,"best":0,"p":8},"depth":1},{"line":9,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":8,"best":0,"p":8},"depth":1},{"line":10,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":8,"best":0,"p":9},"depth":1},{"line":11,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":8,"best":0,"p":9},"depth":1},{"line":9,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":8,"best":1,"p":9},"depth":1},{"line":10,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":8,"best":1,"p":2},"depth":1},{"line":11,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":2,"best":1,"p":2},"depth":1},{"line":9,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":2,"best":1,"p":2},"depth":1},{"line":10,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":2,"best":1,"p":5},"depth":1},{"line":11,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":2,"best":1,"p":5},"depth":1},{"line":9,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":2,"best":3,"p":5},"depth":1},{"line":10,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":2,"best":3,"p":4},"depth":1},{"line":11,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":2,"best":3,"p":4},"depth":1},{"line":9,"locals":{"prices":[8,9,2,5,4,7,1],"min_price":2,"best"