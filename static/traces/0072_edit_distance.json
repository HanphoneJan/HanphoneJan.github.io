{"docKey":"0072_edit_distance","code":"class Solution:\n    def minDistance(self, word1: str, word2: str) -> int:\n        \"\"\"二维 DP：最直观的版本，建议作为默认写法。\"\"\"\n        n, m = len(word1), len(word2)\n        dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n        for i in range(1, n + 1):\n            dp[i][0] = i\n        for j in range(1, m + 1):\n            dp[0][j] = j\n\n        for i in range(1, n + 1):\n            for j in range(1, m + 1):\n                if word1[i - 1] == word2[j - 1]:\n                    dp[i][j] = dp[i - 1][j - 1]\n                else:\n                    dp[i][j] = 1 + min(\n                        dp[i - 1][j],\n                        dp[i][j - 1],\n                        dp[i - 1][j - 1],\n                    )\n\n        return dp[n][m]\n\n    def minDistanceOneArray(self, word1: str, word2: str) -> int:\n        \"\"\"滚动数组：空间 O(m)。\"\"\"\n        m = len(word2)\n        f = list(range(m + 1))\n\n        for i, x in enumerate(word1, 1):\n            diag = f[0]\n            f[0] = i\n            for j, y in enumerate(word2, 1):\n                above = f[j]\n                f[j] = diag if x == y else 1 + min(above, f[j - 1], diag)\n                diag = above\n\n        return f[m]\n\n    def minDistanceMemo(self, word1: str, word2: str) -> int:\n        \"\"\"记忆化搜索：保留递归结构，只算真正用到的状态。\"\"\"\n        from functools import cache\n\n        @cache\n        def dfs(i: int, j: int) -> int:\n            if i == 0:\n                return j\n            if j == 0:\n                return i\n            if word1[i - 1] == word2[j - 1]:\n                return dfs(i - 1, j - 1)\n            return 1 + min(dfs(i - 1, j), dfs(i, j - 1), dfs(i - 1, j - 1))\n\n        return dfs(len(word1), len(word2))","method":"minDistance","paramNames":["word1","word2"],"args":["\"horse\"","\"ros\""],"expected":"3","result":3,"events":[{"line":4,"locals":{"word1":"horse","word2":"ros"},"depth":1},{"line":5,"locals":{"word1":"horse","word2":"ros","n":5,"m":3