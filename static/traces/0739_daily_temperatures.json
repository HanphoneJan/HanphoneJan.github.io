{"docKey":"0739_daily_temperatures","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    每日温度 - 单调栈\n\n    核心思路：\n    使用单调递减栈来维护还没有找到下一个更高温度的天数。\n    栈中存储的是天数的下标，对应的温度单调递减。\n\n    时间复杂度: O(n)\n    空间复杂度: O(n)\n    \"\"\"\n    def dailyTemperatures(self, temperatures: List[int]) -> List[int]:\n        n = len(temperatures)\n        ans = [0] * n\n        st = []\n\n        for i in range(n - 1, -1, -1):\n            t = temperatures[i]\n            while st and t >= temperatures[st[-1]]:\n                st.pop()\n\n            if st:\n                ans[i] = st[-1] - i\n\n            st.append(i)\n\n        return ans","method":"dailyTemperatures","paramNames":["temperatures"],"args":["[73,74,75,71,69,72,76,73]"],"expected":"[1,1,4,2,1,1,0,0]","result":[1,1,4,2,1,1,0,0],"events":[{"line":15,"locals":{"temperatures":[73,74,75,71,69,72,76,73]},"depth":1},{"line":16,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8},"depth":1},{"line":17,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8,"ans":[0,0,0,0,0,0,0,0]},"depth":1},{"line":19,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8,"ans":[0,0,0,0,0,0,0,0],"st":[]},"depth":1},{"line":20,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8,"ans":[0,0,0,0,0,0,0,0],"st":[],"i":7},"depth":1},{"line":21,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8,"ans":[0,0,0,0,0,0,0,0],"st":[],"i":7,"t":73},"depth":1},{"line":24,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8,"ans":[0,0,0,0,0,0,0,0],"st":[],"i":7,"t":73},"depth":1},{"line":27,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8,"ans":[0,0,0,0,0,0,0,0],"st":[],"i":7,"t":73},"depth":1},{"line":19,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8,"ans":[0,0,0,0,0,0,0,0],"st":[7],"i":7,"t":73},"depth":1},{"line":20,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8,"ans":[0,0,0,0,0,0,0,0],"st":[7],"i":6,"t":73},"depth":1},{"line":21,"locals":{"temperatures":[73,74,75,71,69,72,76,73],"n":8,"ans":[0,0