{"docKey":"HJ69.矩阵乘法","code":"import sys\n\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    m, s, n = int(next(it)), int(next(it)), int(next(it))\n\n    A = [[int(next(it)) for _ in range(s)] for _ in range(m)]\n    B = [[int(next(it)) for _ in range(n)] for _ in range(s)]\n\n    C = [[0] * n for _ in range(m)]\n    for i in range(m):\n        for j in range(n):\n            total = 0\n            for k in range(s):\n                total += A[i][k] * B[k][j]\n            C[i][j] = total\n\n    for row in C:\n        print(' '.join(map(str, row)))\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"2 3 2\n1 2 3\n3 2 1\n1 2\n2 1\n3 3","expected":"14 13\n10 11","result":null,"events":[{"line":5,"locals":{},"depth":1},{"line":6,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"]},"depth":1},{"line":7,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"it":"<list_iterator>"},"depth":1},{"line":9,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"it":"<list_iterator>","m":2,"s":3,"n":2},"depth":1},{"line":9,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"it":"<list_iterator>","m":2,"s":3,"n":2,"_":0},"depth":1},{"line":9,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>","<bytes>"],"it":"<list_iterator>","m":2,"s":3,"n":2,"_":1},"depth":1},{"line":9,"locals":{"data":["<bytes>","<bytes>","<bytes>","<bytes>","