{"docKey":"0226_invert_binary_tree","code":"from typing import Optional\n\nclass Solution:\n    \"\"\"\n    翻转二叉树 - 递归法\n\n    核心思路：\n    递归地翻转左右子树，然后交换它们。\n\n    时间复杂度：O(n)\n    空间复杂度：O(h) - h 为树高度\n    \"\"\"\n\n    def invertTree(self, root: Optional[TreeNode]) -> Optional[TreeNode]:\n        if not root:\n            return None\n\n        # 递归翻转左右子树\n        left = self.invertTree(root.left)\n        right = self.invertTree(root.right)\n\n        # 交换左右子树\n        root.left = right\n        root.right = left\n\n        return root","method":"invertTree","paramNames":["root"],"argKinds":["tree"],"args":["[4,2,7,1,3,6,9]"],"expected":"[4,7,2,9,6,3,1]","result":[4,7,2,9,6,3,1],"events":[{"line":15,"locals":{"root":{"$":"tree","v":[4,2,7,1,3,6,9]}},"depth":1},{"line":19,"locals":{"root":{"$":"tree","v":[4,2,7,1,3,6,9]}},"depth":1},{"line":15,"locals":{"root":{"$":"n","i":1,"v":2}},"depth":2},{"line":19,"locals":{"root":{"$":"n","i":1,"v":2}},"depth":2},{"line":15,"locals":{"root":{"$":"n","i":3,"v":1}},"depth":3},{"line":19,"locals":{"root":{"$":"n","i":3,"v":1}},"depth":3},{"line":15,"locals":{"root":null},"depth":4},{"line":16,"locals":{"root":null},"depth":4},{"line":20,"locals":{"root":{"$":"n","i":3,"v":1},"left":null},"depth":3},{"line":15,"locals":{"root":null},"depth":4},{"line":16,"locals":{"root":null},"depth":4},{"line":23,"locals":{"root":{"$":"n","i":3,"v":1},"left":null,"right":null},"depth":3},{"line":24,"locals":{"root":{"$":"n","i":3,"v":1},"left":null,"right":null},"depth":3},{"line":26,"locals":{"root":{"$":"n","i":3,"v":1},"left":null,"right":null},"depth":3},{"line":20,"locals":{"root":{"$":"n","i":1,"v":2},"left":{"$":"n","i":3,"v":1}},"depth":2},{"line":15,"locals":{"root":{"$":"n","i":4,"v":3}},"depth":3},{"line":19,"locals":{"root":{"$":"n","i":4,"v":3}},"depth":3},{"line":15,"locals":{"root":null},"depth":4},{"line":16,"locals":{"root":null},"depth":4},{"line":20,"locals":{"root":{"$":"n","i":4,"v":3},"left":null},"depth":3},{"line":15,"lo