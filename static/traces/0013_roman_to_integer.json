{"docKey":"0013_roman_to_integer","code":"class Solution:\n    def romanToInt(self, s: str) -> int:\n        roman_map = {\"M\": 1000, \"D\": 500, \"C\": 100, \"L\": 50, \"X\": 10, \"V\": 5, \"I\": 1}\n        ans = 0\n        n = len(s)\n        for i in range(n):\n            if i + 1 < n and roman_map[s[i]] < roman_map[s[i + 1]]:\n                ans -= roman_map[s[i]]\n            else:\n                ans += roman_map[s[i]]\n        return ans","method":"romanToInt","paramNames":["s"],"args":["\"MCMXCIV\""],"expected":"1994","result":1994,"events":[{"line":3,"locals":{"s":"MCMXCIV"},"depth":1},{"line":4,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1}},"depth":1},{"line":5,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":0},"depth":1},{"line":6,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":0,"n":7},"depth":1},{"line":7,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":0,"n":7,"i":0},"depth":1},{"line":10,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":0,"n":7,"i":0},"depth":1},{"line":6,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":1000,"n":7,"i":0},"depth":1},{"line":7,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":1000,"n":7,"i":1},"depth":1},{"line":8,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":1000,"n":7,"i":1},"depth":1},{"line":6,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":900,"n":7,"i":1},"depth":1},{"line":7,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":900,"n":7,"i":2},"depth":1},{"line":10,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":9