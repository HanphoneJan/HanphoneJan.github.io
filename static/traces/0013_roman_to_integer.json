{"docKey":"0013_roman_to_integer","code":"class Solution:\n    def romanToInt(self, s: str) -> int:\n        # 七个基本符号对应的数值，用字典把「字符 → 数值」固定下来\n        roman_map = {\"M\": 1000, \"D\": 500, \"C\": 100, \"L\": 50, \"X\": 10, \"V\": 5, \"I\": 1}\n        ans = 0\n        n = len(s)\n        # 从左到右扫一遍，每个字符只看它和右边邻居的大小关系\n        for i in range(n):\n            # 比右侧小说明构成减法组合（如 IV、CM），当前值要先减去，右侧的大值稍后自然加上\n            # i + 1 < n 是为最后一个字符兜底：它没有右侧，必然走加法分支\n            if i + 1 < n and roman_map[s[i]] < roman_map[s[i + 1]]:\n                ans -= roman_map[s[i]]\n            else:\n                ans += roman_map[s[i]]\n        return ans","method":"romanToInt","paramNames":["s"],"args":["\"MCMXCIV\""],"expected":"1994","result":1994,"events":[{"line":4,"locals":{"s":"MCMXCIV"},"depth":1},{"line":5,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1}},"depth":1},{"line":6,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":0},"depth":1},{"line":8,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":0,"n":7},"depth":1},{"line":11,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":0,"n":7,"i":0},"depth":1},{"line":14,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":0,"n":7,"i":0},"depth":1},{"line":8,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":1000,"n":7,"i":0},"depth":1},{"line":11,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":1000,"n":7,"i":1},"depth":1},{"line":12,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":1000,"n":7,"i":1},"depth":1},{"line":8,"locals":{"s":"MCMXCIV","roman_map":{"M":1000,"D":500,"C":100,"L":50,"X":10,"V":5,"I":1},"ans":900,"n":7,"i":1},"depth":1},{"line":11,"locals":{"s":"MCMXCIV","roman_map":{"M":