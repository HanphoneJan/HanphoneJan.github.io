{"docKey":"0448_find_all_numbers_disappeared_in_an_array","code":"from typing import List\n\n\nclass Solution:\n    \"\"\"\n    找到所有数组中消失的数字 - 原地哈希\n\n    将出现过的数字对应位置的值增加 n\n    值仍 <= n 的位置就是没出现过的数字\n\n    时间复杂度：O(n)\n    空间复杂度：O(1)（不计输出空间）\n    \"\"\"\n\n    def findDisappearedNumbers(self, nums: List[int]) -> List[int]:\n        n = len(nums)\n        for num in nums:\n            x = (num - 1) % n  # 计算该数字对应的索引\n            nums[x] += n         # 标记该数字出现过\n\n        # 值仍 <= n 的位置，说明对应的数字(i+1)没有出现过\n        return [i + 1 for i, num in enumerate(nums) if num <= n]","method":"findDisappearedNumbers","paramNames":["nums"],"args":["[4,3,2,7,8,2,3,1]"],"expected":"[5,6]","result":[5,6],"events":[{"line":16,"locals":{"nums":[4,3,2,7,8,2,3,1]},"depth":1},{"line":17,"locals":{"nums":[4,3,2,7,8,2,3,1],"n":8},"depth":1},{"line":18,"locals":{"nums":[4,3,2,7,8,2,3,1],"n":8,"num":4},"depth":1},{"line":19,"locals":{"nums":[4,3,2,7,8,2,3,1],"n":8,"num":4,"x":3},"depth":1},{"line":17,"locals":{"nums":[4,3,2,15,8,2,3,1],"n":8,"num":4,"x":3},"depth":1},{"line":18,"locals":{"nums":[4,3,2,15,8,2,3,1],"n":8,"num":3,"x":3},"depth":1},{"line":19,"locals":{"nums":[4,3,2,15,8,2,3,1],"n":8,"num":3,"x":2},"depth":1},{"line":17,"locals":{"nums":[4,3,10,15,8,2,3,1],"n":8,"num":3,"x":2},"depth":1},{"line":18,"locals":{"nums":[4,3,10,15,8,2,3,1],"n":8,"num":10,"x":2},"depth":1},{"line":19,"locals":{"nums":[4,3,10,15,8,2,3,1],"n":8,"num":10,"x":1},"depth":1},{"line":17,"locals":{"nums":[4,11,10,15,8,2,3,1],"n":8,"num":10,"x":1},"depth":1},{"line":18,"locals":{"nums":[4,11,10,15,8,2,3,1],"n":8,"num":15,"x":1},"depth":1},{"line":19,"locals":{"nums":[4,11,10,15,8,2,3,1],"n":8,"num":15,"x":6},"depth":1},{"line":17,"locals":{"nums":[4,11,10,15,8,2,11,1],"n":8,"num":15,"x":6},"depth":1},{"line":18,"locals":{"nums":[4,11,10,15,8,2,11,1],"n":8,"num":8,"x":6},"depth":1},{"line":19,"locals":{"nums":[4,11,10,15,8,2,11,1],"n":8,"num":8,"x":7},"depth":1},{"line":17,"locals":{"nums":[4,11,10,15,8,2,11,9],"n":