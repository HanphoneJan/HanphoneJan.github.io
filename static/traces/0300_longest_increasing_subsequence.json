{"docKey":"0300_longest_increasing_subsequence","code":"from bisect import bisect_left\nfrom typing import List\n\n\nclass Solution:\n    def lengthOfLIS(self, nums: List[int]) -> int:\n        g = []                      # g[k] = 长度 k+1 的递增子序列的最小结尾\n        for x in nums:\n            j = bisect_left(g, x)   # 第一个 >= x 的位置\n            if j == len(g):\n                g.append(x)         # 比所有结尾都大：最长长度 +1\n            else:\n                g[j] = x            # 换一个更小的结尾\n        return len(g)","method":"lengthOfLIS","paramNames":["nums"],"args":["[10,9,2,5,3,7,101,18]"],"expected":"4","result":4,"events":[{"line":7,"locals":{"nums":[10,9,2,5,3,7,101,18]},"depth":1},{"line":8,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[]},"depth":1},{"line":9,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[],"x":10},"depth":1},{"line":10,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[],"x":10,"j":0},"depth":1},{"line":11,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[],"x":10,"j":0},"depth":1},{"line":8,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[10],"x":10,"j":0},"depth":1},{"line":9,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[10],"x":9,"j":0},"depth":1},{"line":10,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[10],"x":9,"j":0},"depth":1},{"line":13,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[10],"x":9,"j":0},"depth":1},{"line":8,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[9],"x":9,"j":0},"depth":1},{"line":9,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[9],"x":2,"j":0},"depth":1},{"line":10,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[9],"x":2,"j":0},"depth":1},{"line":13,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[9],"x":2,"j":0},"depth":1},{"line":8,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[2],"x":2,"j":0},"depth":1},{"line":9,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[2],"x":5,"j":0},"depth":1},{"line":10,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[2],"x":5,"j":1},"depth":1},{"line":11,"locals":{"nums":[10,9,2,5,3,7,101,18],"g":[2],"x":5,"j":1},"depth":1},{"line":8,"locals":{"nums":[10,9,2