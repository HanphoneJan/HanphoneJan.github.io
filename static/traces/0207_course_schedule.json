{"docKey":"0207_course_schedule","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    课程表 - 拓扑排序（DFS判环）\n\n    核心思路：\n    本题本质上是判断有向图中是否存在环。\n    使用三色标记法进行 DFS：\n    - 0（白色）：未访问\n    - 1（灰色）：正在访问中\n    - 2（黑色）：已访问完毕\n\n    时间复杂度：O(V + E)\n    空间复杂度：O(V + E)\n    \"\"\"\n\n    def canFinish(self, numCourses: int, prerequisites: List[List[int]]) -> bool:\n        # 构建邻接表\n        g = [[] for _ in range(numCourses)]\n        for a, b in prerequisites:\n            g[b].append(a)  # b -> a 的边\n\n        colors = [0] * numCourses  # 0: 未访问, 1: 访问中, 2: 已访问\n\n        def dfs(x: int) -> bool:\n            \"\"\"返回 True 表示找到了环\"\"\"\n            colors[x] = 1  # 标记为访问中\n\n            for y in g[x]:\n                if colors[y] == 1:  # 发现指向访问中节点的边，有环\n                    return True\n                if colors[y] == 0 and dfs(y):  # 未访问，递归检查\n                    return True\n\n            colors[x] = 2  # 标记为已访问完毕\n            return False\n\n        for i in range(numCourses):\n            if colors[i] == 0 and dfs(i):\n                return False  # 有环\n\n        return True  # 无环","method":"canFinish","paramNames":["numCourses","prerequisites"],"args":["2","[[1,0]]"],"expected":"true","result":true,"events":[{"line":20,"locals":{"numCourses":2,"prerequisites":[[1,0]]},"depth":1},{"line":20,"locals":{"numCourses":2,"prerequisites":[[1,0]],"_":0},"depth":1},{"line":20,"locals":{"numCourses":2,"prerequisites":[[1,0]],"_":1},"depth":1},{"line":21,"locals":{"numCourses":2,"prerequisites":[[1,0]],"g":[[],[]]},"depth":1},{"line":22,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"g":[[],[]]},"depth":1},{"line":21,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"g":[[1],[]]},"depth":1},{"line":24,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"g":[[1],[]]},"depth":1},{"line":26,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"colors":[0,0],"g":[[1],[]]},"depth":1},{"line":39,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"colors":[0,0],"dfs":"<function>","g":[[1],[]]},"depth":1},{"line":40,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"i":0,"colors":[0,0],"dfs":"<function>","g":[[1],[]]},"depth":1},{"line":28,"locals":{"x":0,"colors":[0,0],"dfs":"<function>","g":[[1],[]]},"depth":2},{"line":30,"locals":{"x":0,"colors":[1,0],"dfs":"<function>","g":[[1],[]]},"depth":2},{"line":31,"locals":{"x":0,"y":1,"colors":[1,0],"dfs":"<function>","g":[[1],[]]},"depth":2},{"line":33,"locals":{"x":0,"y":1,"colors":[1,0],"dfs":"<function>","g":[[1],[]]},"depth":2},{"line":28,"locals":{"x":1,"colors":[1,0],"dfs":"<function>","g":[[1],[]]},"depth":3},{"line":30,"locals":{"x":1,"colors":[1,1],"dfs":"<function>","g":[[1],[]]},"depth":3},{"line":36,"locals":{"x":1,"colors":[1,1],"dfs":"<function>","g":[[1],[]]},"depth":3},{"line":37,"locals":{"x":1,"colors":[1,2],"dfs":"<function>","g":[[1],[]]},"depth":3},{"line":30,"locals":{"x":0,"y":1,"colors":[1,2],"dfs":"<function>","g":[[1],[]]},"depth":2},{"line":36,"locals":{"x":0,"y":1,"colors":[1,2],"dfs":"<function>","g":[[1],[]]},"depth":2},{"line":37,"locals":{"x":0,"y":1,"colors":[2,2],"dfs":"<function>","g":[[1],[]]},"depth":2},{"line":39,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"i":0,"colors":[2,2],"dfs":"<function>","g":[[1],[]]},"depth":1},{"line":40,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"i":1,"colors":[2,2],"dfs":"<function>","g":[[1],[]]},"depth":1},{"line":39,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"i":1,"colors":[2,2],"dfs":"<function>","g":[[1],[]]},"depth":1},{"line":43,"locals":{"numCourses":2,"prerequisites":[[1,0]],"a":1,"b":0,"i":1,"colors":[2,2],"dfs":"<function>","g":[[1],[]]},"depth":1}]}