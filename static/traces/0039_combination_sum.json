{"docKey":"0039_combination_sum","code":"from typing import List\n\n\nclass Solution:\n    def combinationSum(self, candidates: List[int], target: int) -> List[List[int]]:\n        candidates.sort()               # 剪枝依赖有序\n        n = len(candidates)\n        ans = []\n        path = []\n\n        def dfs(start: int, remain: int) -> None:\n            if remain == 0:\n                ans.append(path[:])     # 复制，否则后续 pop 会清空\n                return\n            for i in range(start, n):\n                if candidates[i] > remain:\n                    break               # 升序：后面的只会更大\n                path.append(candidates[i])\n                dfs(i, remain - candidates[i])   # 传 i 表示可以重复选\n                path.pop()\n\n        dfs(0, target)\n        return ans","method":"combinationSum","paramNames":["candidates","target"],"args":["[2,3,6,7]","7"],"expected":"[[2,2,3],[7]]","result":[[2,2,3],[7]],"events":[{"line":6,"locals":{"candidates":[2,3,6,7],"target":7},"depth":1},{"line":7,"locals":{"candidates":[2,3,6,7],"target":7},"depth":1},{"line":8,"locals":{"candidates":[2,3,6,7],"target":7,"n":4},"depth":1},{"line":9,"locals":{"candidates":[2,3,6,7],"target":7,"ans":[],"n":4},"depth":1},{"line":11,"locals":{"candidates":[2,3,6,7],"target":7,"ans":[],"n":4,"path":[]},"depth":1},{"line":22,"locals":{"candidates":[2,3,6,7],"target":7,"ans":[],"dfs":"<function>","n":4,"path":[]},"depth":1},{"line":12,"locals":{"start":0,"remain":7,"ans":[],"candidates":[2,3,6,7],"dfs":"<function>","n":4,"path":[]},"depth":2},{"line":15,"locals":{"start":0,"remain":7,"ans":[],"candidates":[2,3,6,7],"dfs":"<function>","n":4,"path":[]},"depth":2},{"line":16,"locals":{"start":0,"remain":7,"i":0,"ans":[],"candidates":[2,3,6,7],"dfs":"<function>","n":4,"path":[]},"depth":2},{"line":18,"locals":{"start":0,"remain":7,"i":0,"ans":[],"candidates":[2,3,6,7],"dfs":"<function>","n":4,"path":[]},"depth":2},{"line":19,"locals":{"start":0,"remain":7,"i":0,"ans":[],"candidates":[2,3,6,7],"dfs":"<functio