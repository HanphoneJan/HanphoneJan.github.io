{"docKey":"0121_best_time_to_buy_and_sell_stock","code":"from typing import List\n\n\nclass Solution:\n    def maxProfit(self, prices: List[int]) -> int:\n        min_price = prices[0]      # 到目前为止的最低买入价\n        best = 0                   # 不交易，利润为 0\n        for p in prices[1:]:\n            best = max(best, p - min_price)   # 今天卖出能赚多少\n            min_price = min(min_price, p)     # 今天也可以成为以后的买入日\n        return best","method":"maxProfit","paramNames":["prices"],"args":["[7,1,5,3,6,4]"],"expected":"5","result":5,"events":[{"line":6,"locals":{"prices":[7,1,5,3,6,4]},"depth":1},{"line":7,"locals":{"prices":[7,1,5,3,6,4],"min_price":7},"depth":1},{"line":8,"locals":{"prices":[7,1,5,3,6,4],"min_price":7,"best":0},"depth":1},{"line":9,"locals":{"prices":[7,1,5,3,6,4],"min_price":7,"best":0,"p":1},"depth":1},{"line":10,"locals":{"prices":[7,1,5,3,6,4],"min_price":7,"best":0,"p":1},"depth":1},{"line":8,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":0,"p":1},"depth":1},{"line":9,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":0,"p":5},"depth":1},{"line":10,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":4,"p":5},"depth":1},{"line":8,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":4,"p":5},"depth":1},{"line":9,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":4,"p":3},"depth":1},{"line":10,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":4,"p":3},"depth":1},{"line":8,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":4,"p":3},"depth":1},{"line":9,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":4,"p":6},"depth":1},{"line":10,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":5,"p":6},"depth":1},{"line":8,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":5,"p":6},"depth":1},{"line":9,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":5,"p":4},"depth":1},{"line":10,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":5,"p":4},"depth":1},{"line":8,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":5,"p":4},"depth":1},{"line":11,"locals":{"prices":[7,1,5,3,6,4],"min_price":1,"best":5,"p":4},"depth":1}]}