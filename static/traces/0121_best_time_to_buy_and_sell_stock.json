{"docKey":"0121_best_time_to_buy_and_sell_stock","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    121. 买卖股票的最佳时机 - 贪心/动态规划\n\n    核心思想：\n    遍历数组时，维护一个 \"历史最低价格\"，并计算 \"今天卖出\" 能获利的最大值。\n\n    时间复杂度：O(n)\n    空间复杂度：O(1)\n    \"\"\"\n\n    def maxProfit(self, prices: List[int]) -> int:\n        n = len(prices)\n        if n <= 1:\n            return 0\n\n        ans = 0\n        pre_min = prices[0]\n\n        for i in range(n):\n            if prices[i] > pre_min:\n                ans = max(ans, prices[i] - pre_min)\n            else:\n                pre_min = min(pre_min, prices[i])\n\n        return ans","method":"maxProfit","paramNames":["prices"],"args":["[7,1,5,3,6,4]"],"expected":"5","result":5,"events":[{"line":15,"locals":{"prices":[7,1,5,3,6,4]},"depth":1},{"line":16,"locals":{"prices":[7,1,5,3,6,4],"n":6},"depth":1},{"line":19,"locals":{"prices":[7,1,5,3,6,4],"n":6},"depth":1},{"line":20,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0},"depth":1},{"line":22,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0,"pre_min":7},"depth":1},{"line":23,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0,"pre_min":7,"i":0},"depth":1},{"line":26,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0,"pre_min":7,"i":0},"depth":1},{"line":22,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0,"pre_min":7,"i":0},"depth":1},{"line":23,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0,"pre_min":7,"i":1},"depth":1},{"line":26,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0,"pre_min":7,"i":1},"depth":1},{"line":22,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0,"pre_min":1,"i":1},"depth":1},{"line":23,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0,"pre_min":1,"i":2},"depth":1},{"line":24,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":0,"pre_min":1,"i":2},"depth":1},{"line":22,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":4,"pre_min":1,"i":2},"depth":1},{"line":23,"locals":{"prices":[7,1,5,3,6,4],"n":6,"ans":4,"pre_min":1,"i":3},"depth":1},{"line":24,"locals":{"prices":[7,1,5,3,6,4],"n":6,