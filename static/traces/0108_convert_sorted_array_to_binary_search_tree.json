{"docKey":"0108_convert_sorted_array_to_binary_search_tree","code":"from typing import List, Optional\n\nclass TreeNode:\n    def __init__(self, val=0, left=None, right=None):\n        self.val = val\n        self.left = left\n        self.right = right\n\nclass Solution:\n    \"\"\"\n    将有序数组转换为二叉搜索树 - 递归\n\n    核心思想：\n    选择数组中间元素作为根节点，可以保证树的高度平衡。\n    然后递归构建左右子树。\n\n    时间复杂度：O(n)\n    空间复杂度：O(log n)\n    \"\"\"\n\n    def sortedArrayToBST(self, nums: List[int]) -> Optional[TreeNode]:\n        def dfs(left: int, right: int) -> Optional[TreeNode]:\n            if left > right:\n                return None\n\n            mid = left + (right - left) // 2\n            root = TreeNode(nums[mid])\n            root.left = dfs(left, mid - 1)\n            root.right = dfs(mid + 1, right)\n\n            return root\n\n        return dfs(0, len(nums) - 1)","method":"sortedArrayToBST","paramNames":["nums"],"argKinds":["none"],"args":["[-10,-3,0,5,9]"],"expected":"[0,-3,9,-10,null,5]","result":[0,-10,5,null,-3,null,9],"events":[{"line":22,"locals":{"nums":[-10,-3,0,5,9]},"depth":1},{"line":33,"locals":{"nums":[-10,-3,0,5,9],"dfs":"<function>"},"depth":1},{"line":23,"locals":{"left":0,"right":4,"dfs":"<function>","nums":[-10,-3,0,5,9]},"depth":2},{"line":26,"locals":{"left":0,"right":4,"dfs":"<function>","nums":[-10,-3,0,5,9]},"depth":2},{"line":27,"locals":{"left":0,"right":4,"mid":2,"dfs":"<function>","nums":[-10,-3,0,5,9]},"depth":2},{"line":5,"locals":{"val":0,"left":null,"right":null},"depth":3},{"line":6,"locals":{"val":0,"left":null,"right":null},"depth":3},{"line":7,"locals":{"val":0,"left":null,"right":null},"depth":3},{"line":28,"locals":{"left":0,"right":4,"mid":2,"root":{"$":"tree","v":[0]},"dfs":"<function>","nums":[-10,-3,0,5,9]},"depth":2},{"line":23,"locals":{"left":0,"right":1,"dfs":"<function>","nums":[-10,-3,0,5,9]},"depth":3},{"line":26,"locals":{"left":0,"right":1,"dfs":"<function>","nums":[-10,-3,0,5,9]},"depth":3},{"line":27,"locals":{"left":0,"right":1