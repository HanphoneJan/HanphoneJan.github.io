{"docKey":"BISHI133.最长不下降子序列","code":"import sys\nfrom bisect import bisect_right\n\n\ndef solve() -> None:\n    \"\"\"O(n log n) 求最长不下降子序列长度\"\"\"\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    arr = list(map(int, data[1:1 + n]))\n\n    tails = []  # tails[k] = 长度 k+1 的不下降子序列的最小结尾\n    for x in arr:\n        # 不下降：找第一个「大于 x」的位置替换（相等可以接在后面）\n        pos = bisect_right(tails, x)\n        if pos == len(tails):\n            tails.append(x)\n        else:\n            tails[pos] = x\n    sys.stdout.write(str(len(tails)) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"6\n1 2 4 2 3 4","expected":"5","result":null,"events":[{"line":7,"locals":{},"depth":1},{"line":8,"locals":{"data":["6","1","2","4","2","3","4"]},"depth":1},{"line":10,"locals":{"data":["6","1","2","4","2","3","4"]},"depth":1},{"line":11,"locals":{"data":["6","1","2","4","2","3","4"],"n":6},"depth":1},{"line":13,"locals":{"data":["6","1","2","4","2","3","4"],"n":6,"arr":[1,2,4,2,3,4]},"depth":1},{"line":14,"locals":{"data":["6","1","2","4","2","3","4"],"n":6,"arr":[1,2,4,2,3,4],"tails":[]},"depth":1},{"line":16,"locals":{"data":["6","1","2","4","2","3","4"],"n":6,"arr":[1,2,4,2,3,4],"tails":[],"x":1},"depth":1},{"line":17,"locals":{"data":["6","1","2","4","2","3","4"],"n":6,"arr":[1,2,4,2,3,4],"tails":[],"x":1,"pos":0},"depth":1},{"line":18,"locals":{"data":["6","1","2","4","2","3","4"],"n":6,"arr":[1,2,4,2,3,4],"tails":[],"x":1,"pos":0},"depth":1},{"line":14,"locals":{"data":["6","1","2","4","2","3","4"],"n":6,"arr":[1,2,4,2,3,4],"tails":[1],"x":1,"pos":0},"depth":1},{"line":16,"locals":{"data":["6","1","2","4","2","3","4"],"n":6,"arr":[1,2,4,2,3,4],"tails":[1],"x":2,"pos":0},"depth":1},{"line":17,"locals":{"data":["6","1","2","4","2","3","4"],"n":6,"arr":[1,2,4,2,3,4],"tails":[1],"x":2,"pos":1},"depth":1},{"line":18,"locals":{"data":["6","1","2","4","2","3","4"],"n":6,"arr":[1,2,4,2,3,4],"tail