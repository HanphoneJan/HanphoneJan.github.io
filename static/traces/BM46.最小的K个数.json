{"docKey":"BM46.最小的K个数","code":"from typing import List\nimport heapq\n\n\nclass Solution:\n    def GetLeastNumbers_Solution(self, input: List[int], k: int) -> List[int]:\n        \"\"\"用大顶堆维护最小的 k 个数（堆内用负数模拟大顶堆）\"\"\"\n        if k <= 0:\n            return []\n        if k >= len(input):\n            return list(input)\n\n        # 取前 k 个建大顶堆（存负值，堆顶是绝对值最大的 = 这 k 个里最大的）\n        heap = [-x for x in input[:k]]\n        heapq.heapify(heap)\n        for x in input[k:]:\n            if x < -heap[0]:          # 比当前堆顶（k 个里最大的）还小 → 换掉它\n                heapq.heapreplace(heap, -x)\n        return [-x for x in heap]","method":"GetLeastNumbers_Solution","paramNames":["input","k"],"args":["[4,5,1,6,2,7,3,8]","4"],"expected":"[1,2,3,4]","result":[4,3,1,2],"events":[{"line":8,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4},"depth":1},{"line":10,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4},"depth":1},{"line":14,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4},"depth":1},{"line":14,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":4},"depth":1},{"line":14,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":5},"depth":1},{"line":14,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":1},"depth":1},{"line":14,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":6},"depth":1},{"line":15,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"heap":[-4,-5,-1,-6]},"depth":1},{"line":16,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"heap":[-6,-5,-1,-4]},"depth":1},{"line":17,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":2,"heap":[-6,-5,-1,-4]},"depth":1},{"line":18,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":2,"heap":[-6,-5,-1,-4]},"depth":1},{"line":16,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":2,"heap":[-5,-4,-1,-2]},"depth":1},{"line":17,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":7,"heap":[-5,-4,-1,-2]},"depth":1},{"line":16,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":7,"heap":[-5,-4,-1,-2]},"depth":1},{"line":17,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":3,"heap":[-5,-4,-1,-2]},"depth":1},{"line":18,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":3,"heap":[-5,-4,-1,-2]},"depth":1},{"line":16,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":3,"heap":[-4,-3,-1,-2]},"depth":1},{"line":17,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":8,"heap":[-4,-3,-1,-2]},"depth":1},{"line":16,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":8,"heap":[-4,-3,-1,-2]},"depth":1},{"line":19,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":8,"heap":[-4,-3,-1,-2]},"depth":1},{"line":19,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":-4,"heap":[-4,-3,-1,-2]},"depth":1},{"line":19,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":-3,"heap":[-4,-3,-1,-2]},"depth":1},{"line":19,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":-1,"heap":[-4,-3,-1,-2]},"depth":1},{"line":19,"locals":{"input":[4,5,1,6,2,7,3,8],"k":4,"x":-2,"heap":[-4,-3,-1,-2]},"depth":1}]}