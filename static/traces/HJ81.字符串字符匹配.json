{"docKey":"HJ81.字符串字符匹配","code":"import sys\n\n\ndef solve():\n    data = sys.stdin.buffer.read().split()\n    short_s = data[0].decode()\n    long_s = data[1].decode()\n\n    # 只关心\"有没有出现\"，长串转成集合后每个字符查一次就够\n    long_set = set(long_s)\n    # all 一旦遇到不在集合里的字符就短路返回 False\n    result = all(ch in long_set for ch in short_s)\n    print(\"true\" if result else \"false\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"bc\nabc","expected":"true","result":null,"events":[{"line":5,"locals":{},"depth":1},{"line":6,"locals":{"data":["bc","abc"]},"depth":1},{"line":7,"locals":{"data":["bc","abc"],"short_s":"bc"},"depth":1},{"line":10,"locals":{"data":["bc","abc"],"short_s":"bc","long_s":"abc"},"depth":1},{"line":12,"locals":{"data":["bc","abc"],"short_s":"bc","long_s":"abc","long_set":["c","b","a"]},"depth":1},{"line":12,"locals":{".0":"<str_ascii_iterator>","long_set":["c","b","a"]},"depth":2},{"line":12,"locals":{"data":["bc","abc"],"short_s":"bc","long_s":"abc","long_set":["c","b","a"]},"depth":1},{"line":12,"locals":{".0":"<str_ascii_iterator>","ch":"b","long_set":["c","b","a"]},"depth":2},{"line":12,"locals":{"data":["bc","abc"],"short_s":"bc","long_s":"abc","long_set":["c","b","a"]},"depth":1},{"line":12,"locals":{".0":"<str_ascii_iterator>","ch":"c","long_set":["c","b","a"]},"depth":2},{"line":13,"locals":{"data":["bc","abc"],"short_s":"bc","long_s":"abc","result":true,"long_set":["c","b","a"]},"depth":1}]}