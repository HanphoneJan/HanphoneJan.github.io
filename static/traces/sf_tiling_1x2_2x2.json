{"docKey":"sf_tiling_1x2_2x2","code":"import sys\n\ndef min_blocks(r, c):\n    \"\"\"返回 (是否可填满, 最少方块数)；不可填满时返回 (False, -1)\"\"\"\n    if (r * c) % 2 == 1:\n        return False, -1\n\n    if r % 2 == 0:\n        # 以 r 为偶数维，按 2 行一组铺 2×2，剩余一列用竖放 1×2 补齐\n        return True, (r // 2) * ((c + 1) // 2)\n    else:\n        # r 为奇数则 c 必为偶数，以 c 为偶数维\n        return True, (c // 2) * ((r + 1) // 2)\n\ndef solve():\n    input = sys.stdin.readline     # 必须写在 solve() 内部，便于测试时替换 sys.stdin\n\n    first = input()\n    if not first:                  # 空输入直接结束\n        return\n    t = int(first)\n\n    out = []\n    for _ in range(t):\n        r, c = map(int, input().split())\n        ok, blocks = min_blocks(r, c)\n        out.append(\"Y\" if ok else \"N\")\n        out.append(str(blocks))\n\n    sys.stdout.write(\"\\n\".join(out) + \"\\n\")\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"3\n2 3\n1 3\n2 2","expected":"Y\n2\nN\n-1\nY\n1","result":null,"events":[{"line":16,"locals":{},"depth":1},{"line":18,"locals":{"input":"<method>"},"depth":1},{"line":19,"locals":{"input":"<method>","first":"3\n"},"depth":1},{"line":21,"locals":{"input":"<method>","first":"3\n"},"depth":1},{"line":23,"locals":{"input":"<method>","first":"3\n","t":3},"depth":1},{"line":24,"locals":{"input":"<method>","first":"3\n","t":3,"out":[]},"depth":1},{"line":25,"locals":{"input":"<method>","first":"3\n","t":3,"out":[],"_":0},"depth":1},{"line":26,"locals":{"input":"<method>","first":"3\n","t":3,"out":[],"_":0,"r":2,"c":3},"depth":1},{"line":5,"locals":{"r":2,"c":3},"depth":2},{"line":8,"locals":{"r":2,"c":3},"depth":2},{"line":10,"locals":{"r":2,"c":3},"depth":2},{"line":27,"locals":{"input":"<method>","first":"3\n","t":3,"out":[],"_":0,"r":2,"c":3,"ok":true,"blocks":2},"depth":1},{"line":28,"locals":{"input":"<method>","first":"3\n","t":3,"out":["Y"],"_":0,"r":2,"c":3,"ok":true,"blocks":2},"depth":1},{"line":24,"locals":{"input":"<method>","first":"3\n","t":3,