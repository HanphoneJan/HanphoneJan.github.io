{"docKey":"0048_rotate_image","code":"from typing import List\n\nclass Solution:\n    \"\"\"\n    旋转图像 - 转置 + 行翻转\n\n    核心思想：\n    顺时针旋转 90 度 = 转置 + 行翻转\n\n    坐标变换：\n    (i, j) → (j, i) 【转置】→ (j, n-1-i) 【行翻转】\n\n    算法步骤：\n    1. 转置矩阵：遍历对角线上方元素，与对称位置交换\n    2. 行翻转：反转每一行\n\n    时间复杂度：O(n²)，需要访问每个元素两次\n    空间复杂度：O(1)，原地修改\n    \"\"\"\n\n    def rotate(self, matrix: List[List[int]]) -> None:\n        n = len(matrix)\n\n        # 第一步：转置矩阵\n        for i in range(n):\n            for j in range(i + 1, n):\n                matrix[i][j], matrix[j][i] = matrix[j][i], matrix[i][j]\n\n        # 第二步：每行翻转\n        for i in range(n):\n            matrix[i].reverse()","method":"rotate","paramNames":["matrix"],"args":["[[1,2,3],[4,5,6],[7,8,9]]"],"expected":"[[7,4,1],[8,5,2],[9,6,3]]","result":null,"events":[{"line":22,"locals":{"matrix":[[1,2,3],[4,5,6],[7,8,9]]},"depth":1},{"line":25,"locals":{"matrix":[[1,2,3],[4,5,6],[7,8,9]],"n":3},"depth":1},{"line":26,"locals":{"matrix":[[1,2,3],[4,5,6],[7,8,9]],"n":3,"i":0},"depth":1},{"line":27,"locals":{"matrix":[[1,2,3],[4,5,6],[7,8,9]],"n":3,"i":0,"j":1},"depth":1},{"line":26,"locals":{"matrix":[[1,4,3],[2,5,6],[7,8,9]],"n":3,"i":0,"j":1},"depth":1},{"line":27,"locals":{"matrix":[[1,4,3],[2,5,6],[7,8,9]],"n":3,"i":0,"j":2},"depth":1},{"line":26,"locals":{"matrix":[[1,4,7],[2,5,6],[3,8,9]],"n":3,"i":0,"j":2},"depth":1},{"line":25,"locals":{"matrix":[[1,4,7],[2,5,6],[3,8,9]],"n":3,"i":0,"j":2},"depth":1},{"line":26,"locals":{"matrix":[[1,4,7],[2,5,6],[3,8,9]],"n":3,"i":1,"j":2},"depth":1},{"line":27,"locals":{"matrix":[[1,4,7],[2,5,6],[3,8,9]],"n":3,"i":1,"j":2},"depth":1},{"line":26,"locals":{"matrix":[[1,4,7],[2,5,8],[3,6,9]],"n":3,"i":1,"j":2},"depth":1},{"line":25,"locals":{"matrix":[[1,4,7],[2,5,8],[3,6,9]],"n":3,"i":1,"j":2},"depth":1},{"line":26,"locals":{"matrix":[[1,4,7],[2,5,8],[3,6,9]],"n":3,"i":2,"j":2},"depth":1},{"line":25,"locals":{"matrix":[[1,4,7],[2,5,8],[3,6,9]],"n":3,"i":2,"j":2},"depth":1},{"line":30,"locals":{"matrix":[[1,4,7],[2,5,8],[3,6,9]],"n":3,"i":2,"j":2},"depth":1},{"line":31,"locals":{"matrix":[[1,4,7],[2,5,8],[3,6,9]],"n":3,"i":0,"j":2},"depth":1},{"line":30,"locals":{"matrix":[[7,4,1],[2,5,8],[3,6,9]],"n":3,"i":0,"j":2},"depth":1},{"line":31,"locals":{"matrix":[[7,4,1],[2,5,8],[3,6,9]],"n":3,"i":1,"j":2},"depth":1},{"line":30,"locals":{"matrix":[[7,4,1],[8,5,2],[3,6,9]],"n":3,"i":1,"j":2},"depth":1},{"line":31,"locals":{"matrix":[[7,4,1],[8,5,2],[3,6,9]],"n":3,"i":2,"j":2},"depth":1},{"line":30,"locals":{"matrix":[[7,4,1],[8,5,2],[9,6,3]],"n":3,"i":2,"j":2},"depth":1}]}