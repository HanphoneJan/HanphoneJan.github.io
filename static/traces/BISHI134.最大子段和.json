{"docKey":"BISHI134.最大子段和","code":"import sys\n\n\ndef solve() -> None:\n    \"\"\"Kadane 算法求最大子段和（非空）\"\"\"\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    arr = list(map(int, data[1:1 + n]))\n\n    best = cur = arr[0]  # 非空：用首元素初始化\n    for x in arr[1:]:\n        cur = max(x, cur + x)\n        best = max(best, cur)\n    sys.stdout.write(str(best) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"4\n2 2 -3 2","expected":"4","result":null,"events":[{"line":6,"locals":{},"depth":1},{"line":7,"locals":{"data":["4","2","2","-3","2"]},"depth":1},{"line":9,"locals":{"data":["4","2","2","-3","2"]},"depth":1},{"line":10,"locals":{"data":["4","2","2","-3","2"],"n":4},"depth":1},{"line":12,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2]},"depth":1},{"line":13,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":2,"cur":2},"depth":1},{"line":14,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":2,"cur":2,"x":2},"depth":1},{"line":15,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":2,"cur":4,"x":2},"depth":1},{"line":13,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":4,"cur":4,"x":2},"depth":1},{"line":14,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":4,"cur":4,"x":-3},"depth":1},{"line":15,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":4,"cur":1,"x":-3},"depth":1},{"line":13,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":4,"cur":1,"x":-3},"depth":1},{"line":14,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":4,"cur":1,"x":2},"depth":1},{"line":15,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":4,"cur":3,"x":2},"depth":1},{"line":13,"locals":{"data":["4","2","2","-3","2"],"n":4,"arr":[2,2,-3,2],"best":4,"cur":3,"x":2},"depth":1},{"line":16,"locals":{"data":["4","2",