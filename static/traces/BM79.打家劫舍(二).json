{"docKey":"BM79.打家劫舍(二)","code":"from typing import List\n\n\nclass Solution:\n    def rob(self, nums: List[int]) -> int:\n        \"\"\"环形打家劫舍：拆成两个线性子问题取最大值\"\"\"\n        n = len(nums)\n        if n == 0:\n            return 0\n        if n == 1:\n            return nums[0]\n        # 方案一：不考虑最后一个房间；方案二：不考虑第一个房间\n        return max(self._rob_line(nums[:-1]), self._rob_line(nums[1:]))\n\n    def _rob_line(self, arr: List[int]) -> int:\n        \"\"\"线性打家劫舍（辅助方法，下划线开头）\"\"\"\n        prev, cur = 0, 0\n        for x in arr:\n            prev, cur = cur, max(cur, prev + x)\n        return cur","method":"rob","paramNames":["nums"],"args":["[1,2,3,4]"],"expected":"6","result":6,"events":[{"line":7,"locals":{"nums":[1,2,3,4]},"depth":1},{"line":8,"locals":{"nums":[1,2,3,4],"n":4},"depth":1},{"line":10,"locals":{"nums":[1,2,3,4],"n":4},"depth":1},{"line":13,"locals":{"nums":[1,2,3,4],"n":4},"depth":1},{"line":17,"locals":{"arr":[1,2,3]},"depth":2},{"line":18,"locals":{"arr":[1,2,3],"prev":0,"cur":0},"depth":2},{"line":19,"locals":{"arr":[1,2,3],"prev":0,"cur":0,"x":1},"depth":2},{"line":18,"locals":{"arr":[1,2,3],"prev":0,"cur":1,"x":1},"depth":2},{"line":19,"locals":{"arr":[1,2,3],"prev":0,"cur":1,"x":2},"depth":2},{"line":18,"locals":{"arr":[1,2,3],"prev":1,"cur":2,"x":2},"depth":2},{"line":19,"locals":{"arr":[1,2,3],"prev":1,"cur":2,"x":3},"depth":2},{"line":18,"locals":{"arr":[1,2,3],"prev":2,"cur":4,"x":3},"depth":2},{"line":20,"locals":{"arr":[1,2,3],"prev":2,"cur":4,"x":3},"depth":2},{"line":17,"locals":{"arr":[2,3,4]},"depth":2},{"line":18,"locals":{"arr":[2,3,4],"prev":0,"cur":0},"depth":2},{"line":19,"locals":{"arr":[2,3,4],"prev":0,"cur":0,"x":2},"depth":2},{"line":18,"locals":{"arr":[2,3,4],"prev":0,"cur":2,"x":2},"depth":2},{"line":19,"locals":{"arr":[2,3,4],"prev":0,"cur":2,"x":3},"depth":2},{"line":18,"locals":{"arr":[2,3,4],"prev":2,"cur":3,"x":3},"depth":2},{"line":19,"locals":{"arr":[2,3,4],"prev":2,"cur":3,"x":4},"depth":2},{"line":18,"locals":{"arr":[2,3,4],"prev":3,"cur":6,"x":4},"depth":2},{"line":20,"locals":{"arr":[2,3,4],"prev":3,"cur":6,"x":4},"depth":2}]}