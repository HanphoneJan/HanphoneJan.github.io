{"docKey":"BISHI136.模板01背包","code":"import sys\n\nNEG = float('-inf')\n\n\ndef solve() -> None:\n    \"\"\"01 背包：分别求「不必装满」与「恰好装满」的最大价值\"\"\"\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    idx = 0\n    n = int(data[idx]); V = int(data[idx + 1]); idx += 2\n    items = []\n    for _ in range(n):\n        w = int(data[idx]); v = int(data[idx + 1]); idx += 2\n        items.append((w, v))\n\n    # 方案一：不要求装满\n    dp1 = [0] * (V + 1)\n    # 方案二：恰好装满（-inf 表示该容量尚不可达）\n    dp2 = [NEG] * (V + 1)\n    dp2[0] = 0\n\n    for w, v in items:\n        for j in range(V, w - 1, -1):        # 倒序：保证每件物品只用一次\n            dp1[j] = max(dp1[j], dp1[j - w] + v)\n            if dp2[j - w] != NEG:\n                dp2[j] = max(dp2[j], dp2[j - w] + v)\n\n    ans1 = dp1[V]\n    ans2 = dp2[V] if dp2[V] != NEG else 0\n    sys.stdout.write(f\"{ans1}\\n{ans2}\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()","method":"solve","paramNames":[],"args":[],"stdin":"3 5\n2 10\n4 5\n1 4","expected":"14\n9","result":null,"events":[{"line":8,"locals":{},"depth":1},{"line":9,"locals":{"data":["3","5","2","10","4","5","1","4"]},"depth":1},{"line":11,"locals":{"data":["3","5","2","10","4","5","1","4"]},"depth":1},{"line":12,"locals":{"data":["3","5","2","10","4","5","1","4"],"idx":0},"depth":1},{"line":13,"locals":{"data":["3","5","2","10","4","5","1","4"],"idx":2,"n":3,"V":5},"depth":1},{"line":14,"locals":{"data":["3","5","2","10","4","5","1","4"],"idx":2,"n":3,"V":5,"items":[]},"depth":1},{"line":15,"locals":{"data":["3","5","2","10","4","5","1","4"],"idx":2,"n":3,"V":5,"items":[],"_":0},"depth":1},{"line":16,"locals":{"data":["3","5","2","10","4","5","1","4"],"idx":4,"n":3,"V":5,"items":[],"_":0,"w":2,"v":10},"depth":1},{"line":14,"locals":{"data":["3","5","2","10","4","5","1","4"],"idx":4,"n":3,"V":5,"items":[[2,10]],"_":0,"w":2,"v":10},"depth":1},{"line":15,"locals":{"data":["3","5","2","10","4","5","1","4"],"idx":4,"n":3,"V":5,"items":[[2,10]],"_":1,"w":2,"v":10},"depth":1}