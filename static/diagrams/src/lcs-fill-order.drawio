id="zmm" value="左上&lt;br&gt;dp[i-1][j-1]" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="90" width="100" height="42" as="geometry"/></mxCell><mxCell id="zup" value="上&lt;br&gt;dp[i-1][j]" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="505" y="90" width="100" height="42" as="geometry"/></mxCell><mxCell id="zleft" value="左&lt;br&gt;dp[i][j-1]" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="148" width="100" height="42" as="geometry"/></mxCell><mxCell id="zcur" value="当前&lt;br&gt;dp[i][j]" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505" y="148" width="100" height="42" as="geometry"/></mxCell><mxCell id="e_up" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="zup" target="zcur" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_left" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="zleft" target="zcur" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_diag" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;exitX=1;exitY=1;entryX=0;entryY=0;" edge="1" source="zmm" target="zcur" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="zcap" value="&lt;b&gt;行优先&lt;/b&gt;（从上到下、每行从左到右）一定算得出来：上面那一行和左边那一格都已经填好。&lt;br&gt;&lt;br&gt;压成一维时，&lt;b&gt;左上角&lt;/b&gt;那一格在写当前行时会被覆盖，所以要用一个 &lt;b&gt;prev&lt;/b&gt; 单独存住。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#666666;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="372" y="204" width="312" height="112" as="geometry"/></mxCell><mxCell id="note" value="顺序不是规定，是依赖方向推出来的：先问「这个格子要用谁」，再决定按什么方向遍历。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="16" y="440" width="668" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>