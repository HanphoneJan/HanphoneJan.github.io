1;" vertex="1" parent="1"><mxGeometry x="400" y="250" width="280" height="24" as="geometry"/></mxCell><mxCell id="q2a" value="③" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="282" width="40" height="24" as="geometry"/></mxCell><mxCell id="q2b" value="B" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="66" y="282" width="60" height="24" as="geometry"/></mxCell><mxCell id="q2c" value="X 已访问，跳过" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="282" width="240" height="24" as="geometry"/></mxCell><mxCell id="q2d" value="[X]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="282" width="280" height="24" as="geometry"/></mxCell><mxCell id="q3a" value="④" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="314" width="40" height="24" as="geometry"/></mxCell><mxCell id="q3b" value="X" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="66" y="314" width="60" height="24" as="geometry"/></mxCell><mxCell id="q3c" value="入 T" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="314" width="240" height="24" as="geometry"/></mxCell><mxCell id="q3d" value="[T]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="314" width="280" height="24" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;入队时就标记&lt;/b&gt;：X 只会进队一次。若等出队才标记，第 ③ 步的 B 会把 X 再塞一次，队列从 O(V) 膨胀到 O(E) 级别 —— 答案仍然对，只是慢到超时。&lt;br&gt;队列里同一时刻的点距离最多相差 1，所以第一次出队就是最短距离。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="16" y="366" width="668" height="54" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>