<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="bfs-queue-marking" name="bfs-queue-marking"><mxGraphModel dx="700" dy="440" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="BFS：队列按层推进，X 在入队时就被标记，只进队一次" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="8" width="668" height="24" as="geometry"/></mxCell><mxCell id="nS" value="S" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=15;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="90" width="56" height="32" as="geometry"/></mxCell><mxCell id="nSs" value="①" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="74" width="56" height="15" as="geometry"/></mxCell><mxCell id="nA" value="A" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=15;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="56" height="32" as="geometry"/></mxCell><mxCell id="nAs" value="②" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="34" width="56" height="15" as="geometry"/></mxCell><mxCell id="nB" value="B" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=15;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeomet