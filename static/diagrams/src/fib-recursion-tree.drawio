<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="fib-recursion-tree" name="fib-recursion-tree"><mxGraphModel dx="700" dy="356" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="356" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="fib(4) 的递归树：同一个子问题被算了很多次" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="8" width="668" height="24" as="geometry"/></mxCell><mxCell id="legend" value="橙 = 重复子问题（记忆化后直接取缓存）· 绿 = 第一次计算" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="16" y="34" width="668" height="20" as="geometry"/></mxCell><mxCell id="rf4" value="fib(4)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="316" y="60" width="68" height="26" as="geometry"/></mxCell><mxCell id="rf3" value="fib(3)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="196" y="122" width="68" height="26" as="geometry"/></mxCell><mxCell id="rf2b" value="② fib(2)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="436" y="122" width="68" height="26" as="geometry"/></mxCell><mxCell id="rf2a" value="① fib(2)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="116" y="184" width="68" height="26" as="geometry"/></mxCell><mxCell id="rf1a" value="fib(1)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="266" y="184" width="68" height="26" as="geometry"/></mxCell><mxCell id="rf1b" value="fib(1)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376" y="184" width="68" height="26" as="geometry"/></mxCell><mxCell id="rf0b" value="fib(0)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="496" y="184" width="68" height="26" as="geometry"/></mxCell><mxCell id="rf1c" value="fib(1)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="76" y="246" width="68" height="26" as="geometry"/></mxCell><mxCell id="rf0a" value="fib(0)" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11;rounded=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="156" y="246" width="68" height="26" as="geometry"/></mxCell><mxCell id="ref4f3" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" edge="1" source="rf4" target="rf3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref4f2b" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" edge="1" source="rf4" target="rf2b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref3f2a" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" edge="1" source="rf3" target="rf2a" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref3f1a" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" edge="1" source="rf3" target="rf1a" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref2af1c" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" edge="1" source="rf2a" target="rf1c" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref2af0a" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" edge="1" source="rf2a" target="rf0a" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref2bf1b" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" edge="1" source="rf2b" target="rf1b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref2bf0b" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" edge="1" source="rf2b" target="rf0b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="① 与 ② 是同一个 fib(2)。朴素递归会把 ② 整棵重新展开，fib(1) 也会算 3 次、fib(0) 算 2 次；&lt;br&gt;n 越大重复越多，复杂度是 O(2^n)。记忆化把每个 &lt;code&gt;fib(k)&lt;/code&gt; 的结果存下来，橙色节点变成一次取缓存，时间降到 O(n)。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="16" y="296" width="668" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>