<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="linked-list-cycle" name="linked-list-cycle"><mxGraphModel dx="700" dy="360" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="快慢指针：相遇点不是入口，但能推出入口" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="660" height="26" as="geometry"/></mxCell><mxCell id="na" value="3" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=14;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="70" height="44" as="geometry"/></mxCell><mxCell id="nb" value="2" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=14;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="90" width="70" height="44" as="geometry"/></mxCell><mxCell id="nc" value="0" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=14;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="70" height="44" as="geometry"/></mxCell><mxCell id="nd" value="-4" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=14;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="70" height="44" as="geometry"/></mxCell><mxCell id="e1" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=14;fontColor=#666666;" edge="1" source="na" target="nb" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=14;fontColor=#666666;" edge="1" source="nb" target="nc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=14;fontColor=#666666;" edge="1" source="nc" target="nd" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=14;" edge="1" source="nd" target="nb" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="170"/><mxPoint x="245" y="170"/></Array></mxGeometry></mxCell><mxCell id="ta" value="a" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="62" width="40" height="20" as="geometry"/></mxCell><mxCell id="tb" value="b" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="62" width="40" height="20" as="geometry"/></mxCell><mxCell id="tc" value="c" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="178" width="180" height="20" as="geometry"/></mxCell><mxCell id="th" value="head" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="92" y="140" width="50" height="20" as="geometry"/></mxCell><mxCell id="te" value="入口" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="206" y="140" width="60" height="20" as="geometry"/></mxCell><mxCell id="tm" value="slow 与 fast 在此相遇" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#b85450;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="200" height="20" as="geometry"/></mxCell><mxCell id="t2" value="设 a = 链头到入口、b = 入口到相遇点、c = 环周长。slow 走 a+b，fast 走 a+b+k·c，" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="660" height="20" as="geometry"/></mxCell><mxCell id="t3" value="由 2(a+b) = a+b+k·c 得 a = k·c − b：从链头走 a 步，与从相遇点走 c−b 步，会同时到达入口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="264" width="660" height="20" as="geometry"/></mxCell><mxCell id="t4" value="所以相遇后各放一根 ×1 指针（一个从链头、一个从相遇点），重合处就是入口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="288" width="660" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>