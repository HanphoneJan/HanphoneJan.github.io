<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="unionfind-weighted" name="unionfind-weighted"><mxGraphModel dx="700" dy="340" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="340" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="带权并查集：边上记比值，find 时沿路径累乘到根" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="660" height="26" as="geometry"/></mxCell><mxCell id="t2" value="合并前：a → b → c，weight[ a ] = 2、weight[ b ] = 3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="500" height="20" as="geometry"/></mxCell><mxCell id="a" value="a" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=14;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="90" width="60" height="40" as="geometry"/></mxCell><mxCell id="b" value="b" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=14;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="60" height="40" as="geometry"/></mxCell><mxCell id="c" value="c" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;fontFamily=Helvetica;fontSize=14;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="60" height="40" as="geometry"/></mxCell><mxCell id="e1" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=14;fontColor=#666666;" edge="1" source="a" target="b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=14;fontColor=#666666;" edge="1" source="b" target="c" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="w1" value="2" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="185" y="82" width="30" height="20" as="geometry"/></mxCell><mxCell id="w2" value="3" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="345" y="82" width="30" height="20" as="geometry"/></mxCell><mxCell id="rl" value="根" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="425" y="136" width="40" height="20" as="geometry"/></mxCell><mxCell id="t3" value="query(a, c)：find 回程把 a 直接挂到 c，weight[a] 累乘成 2 × 3 = 6" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="660" height="20" as="geometry"/></mxCell><mxCell id="a2" value="a" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=14;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="235" width="60" height="40" as="geometry"/></mxCell><mxCell id="c2" value="c" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;fontFamily=Helvetica;fontSize=14;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="235" width="60" height="40" as="geometry"/></mxCell><mxCell id="e3" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontFamily=Helvetica;fontSize=14;" edge="1" source="a2" target="c2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="255"/></Array></mxGeometry></mxCell><mxCell id="w3" value="6" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="230" width="30" height="20" as="geometry"/></mxCell><mxCell id="t4" value="于是 query(a, c) = weight[a] / weight[c] = 6 / 1 = 6；query(c, a) = 1/6。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="295" width="660" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>