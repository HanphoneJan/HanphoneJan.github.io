<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="tree-storage" name="tree-storage"><mxGraphModel dx="800" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="树：同一棵树，两种指针方向" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="760" height="26" as="geometry"/></mxCell><mxCell id="t2" value="孩子表示法往下走，父指针法往上走 —— 算法题多用前者，并查集是后者" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="760" height="20" as="geometry"/></mxCell><mxCell id="t3" value="孩子表示法：节点 + children 列表" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="400" height="18" as="geometry"/></mxCell><mxCell id="c4" value="A" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="48" height="40" as="geometry"/></mxCell><mxCell id="c5" value="B" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="176" width="48" height="40" as="geometry"/></mxCell><mxCell id="c6" value="C" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="176" width="48" height="40" as="geometry"/></mxCell><mxCell id="c7" value="D" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="48" height="40" as="geometry"/></mxCell><mxCell id="c8" value="E" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="252" width="48" height="40" as="geometry"/></mxCell><mxCell id="c9" value="F" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="252" width="48" height="40" as="geometry"/></mxCell><mxCell id="e10" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" source="c4" target="c5" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" source="c4" target="c6" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" source="c5" target="c7" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" source="c5" target="c8" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" source="c6" target="c9" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="每个节点是一个对象：&lt;br&gt;A = { val: &quot;A&quot;, children: [B, C] }&lt;br&gt;往下走看 children，往上走没路" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=10.5;rounded=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="340" height="80" as="geometry"/></mxCell><mxCell id="t16" value="父指针法：一个 fa 数组就是整片森林" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="72" width="360" height="18" as="geometry"/></mxCell><mxCell id="c17" value="-" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="60" height="44" as="geometry"/></mxCell><mxCell id="c18" value="A" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="60" height="44" as="geometry"/></mxCell><mxCell id="c19" value="A" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="60" height="44" as="geometry"/></mxCell><mxCell id="c20" value="B" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="60" height="44" as="geometry"/></mxCell><mxCell id="c21" value="B" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="120" width="60" height="44" as="geometry"/></mxCell><mxCell id="c22" value="C" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontFamily=Helvetica;fontSize=12;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="120" width="60" height="44" as="geometry"/></mxCell><mxCell id="t23" value="A" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="60" height="16" as="geometry"/></mxCell><mxCell id="t24" value="B" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="60" height="16" as="geometry"/></mxCell><mxCell id="t25" value="C" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="100" width="60" height="16" as="geometry"/></mxCell><mxCell id="t26" value="D" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="60" height="16" as="geometry"/></mxCell><mxCell id="t27" value="E" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="60" height="16" as="geometry"/></mxCell><mxCell id="t28" value="F" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="60" height="16" as="geometry"/></mxCell><mxCell id="t29" value="fa[x] = 父节点；fa[x] == x 就是根" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="168" width="360" height="16" as="geometry"/></mxCell><mxCell id="c30" value="往上一步 O(1)，所以「查根」很快；&lt;br&gt;往下找孩子要扫整个数组 —— 并查集只做前者" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=10.5;rounded=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="196" width="360" height="76" as="geometry"/></mxCell><mxCell id="c31" value="左孩子右兄弟：多叉树编码成二叉树，&lt;br&gt;用「孩子/兄弟」两根指针代替变长列表" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=10.5;rounded=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="292" width="360" height="76" as="geometry"/></mxCell><mxCell id="c32" value="两种方向都要求「每个节点至多一个父」，这就是「树无环」在实现层的含义" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=11.5;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="700" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>